function getCondensedLoreContent(fileKey, body){
  if(typeof body!=='string') return body;
  const mustCondense=loreCompressionKeys.has(fileKey) || body.length>1800;
  if(!mustCondense) return body;

  const usefulLines=body.split('\n').filter(line=>line.trim()!=='');
  const excerpt=usefulLines.slice(0, 8).join('\n');
  const trailer=`\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nALT MODE: LORE MINIMIZED\n- Open app: EcoPressure.exe\n- Open app: MiniGames.exe\n- Use terminal: eco talk\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━`;
  return `${excerpt}${trailer}`;
}

function updateEcoWidget(){
  const clamped=Math.max(0,Math.min(100,ecoPressureLevel));
  const fill=document.getElementById('ecoPressureFill');
  const label=document.getElementById('ecoPressureLabel');
  const pressureValue=document.getElementById('ecoPressureValue');
  const interactionValue=document.getElementById('ecoInteractionValue');
  const miniStats=document.getElementById('miniStatsValue');
  const completedCount=getCompletedMiniMissionCount();
  if(fill) fill.style.width=`${clamped}%`;
  if(label) label.textContent=`ECO PRESSURE ${Math.round(clamped)}%`;
  if(pressureValue) pressureValue.textContent=`${Math.round(clamped)}%`;
  if(interactionValue) interactionValue.textContent=`${ecoInteractionCount}`;
  if(miniStats) miniStats.textContent=`${miniGameStats.won}/${miniGameStats.played} | ${completedCount}/5`;
  updateMiniMissionProgress();
}

