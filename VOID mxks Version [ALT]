#contextMenu{position:absolute;background:var(--panel);border:1px solid var(--line);box-shadow:0 0 8px #000;display:none;min-width:170px;z-index:25;}
#contextMenu .item{padding:8px 12px;cursor:pointer;border-bottom:1px solid var(--line);}
#contextMenu .item:last-child{border-bottom:none;}
#contextMenu .item:hover{background:#222;}

#terminalWindow{min-height:250px;max-height:600px;}
#terminalWindow .content{background:#101010;color:var(--accent);font-family:monospace;height:auto;min-height:180px;flex:1;overflow-y:scroll;overflow-x:hidden;word-wrap:break-word;padding-right:8px;border-right:1px solid #333;scrollbar-width:thin;scrollbar-color:var(--accent) #000;}
#terminalWindow .content::-webkit-scrollbar{width:10px;}
#terminalWindow .content::-webkit-scrollbar-track{background:#000;border-left:1px solid #222;}
#terminalWindow .content::-webkit-scrollbar-thumb{background:var(--accent);border-radius:2px;}
#terminalWindow .content::-webkit-scrollbar-thumb:hover{background:#f2f2f2;box-shadow:0 0 10px rgba(255,255,255,0.25);}
#terminalInput{width:100%;background:#000;border:none;color:var(--accent);font-family:monospace;padding:8px;box-sizing:border-box;border-top:1px solid #222;min-height:32px;transition:background 0.2s;}
#terminalInput:focus{background:#0a0a0a;outline:none;box-shadow:inset 0 0 10px rgba(255,255,255,0.08);}
.redacted{background:#111;color:transparent;text-shadow:0 0 5px rgba(255,255,255,.6);}

.session-glitch{animation:glitchText .3s infinite;}
@keyframes glitchText{0%{text-shadow:1px 0 var(--accent);}25%{text-shadow:-1px 0 var(--alert);}50%{text-shadow:1px 1px var(--accent);}75%{text-shadow:-1px 1px var(--alert);}100%{text-shadow:1px 0 var(--accent);}}

.fear-light-flicker{animation:voidFearFlicker .14s steps(2,end) 8;filter:brightness(.68) contrast(1.2);}
