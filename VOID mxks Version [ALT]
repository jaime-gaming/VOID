function randomizeInitialIcons(){
  if(!desktop){console.error('Desktop not found!');return;}
  console.log('Creating icons for',files.length,'files');
  const visibleFiles=files.filter(f=>!f.container && !f.secretTerminalOnly && !f.hidden);
  console.log('Visible files:',visibleFiles.length);
  
  // Categorizar iconos
  const apps=visibleFiles.filter(f=>['camerasApp','callsApp','jobsApp','missionsApp','ecoTerminal','ecoPressureApp','miniGamesApp'].includes(f.key));
  const documents=visibleFiles.filter(f=>!['camerasApp','callsApp','jobsApp','missionsApp','ecoTerminal','ecoPressureApp','miniGamesApp'].includes(f.key));
  
  // Grid limpio y ordenado
  const padding = 20;
  const iconSize = 110;
  const gap = 20;
  
  // SECCIÓN 1: Aplicaciones (esquina superior izquierda) - 2x3 grid
  let appRow = 0, appCol = 0;
  apps.forEach((f, i) => {
    appCol = i % 2;
    appRow = Math.floor(i / 2);
    const x = padding + appCol * (iconSize + gap);
    const y = padding + appRow * (iconSize + gap);
    createIconAtPosition(f, x, y);
  });
  
  // SECCIÓN 2: Documentos (debajo de aplicaciones) - grid flexible
  const docStartY = padding + Math.ceil(apps.length / 2) * (iconSize + gap) + 40;
  const colsPerRow = 4;
  
  documents.forEach((f, i) => {
    const docCol = i % colsPerRow;
    const docRow = Math.floor(i / colsPerRow);
    const x = padding + docCol * (iconSize + gap);
    const y = docStartY + docRow * (iconSize + gap);
    
    // Verificar que no salga de pantalla
    if (y + iconSize < window.innerHeight - 50) {
      createIconAtPosition(f, x, y);
    }
  });
}

