function getInterferenceLevelRatio(){
  const level=Number.isFinite(ecoPressureLevel) ? ecoPressureLevel : 0;
  return Math.max(0,Math.min(1,level/100));
}

function getContestTensionMultiplier(){
  if(!CONTEST_BUILD_MODE) return 1;
  const t=Number.isFinite(voidTime?.totalSeconds) ? voidTime.totalSeconds : 0;
  if(t<120) return 0.5;
  if(t<300) return 0.82;
  if(t<540) return 1.05;
  return 1.22;
}

function getMemoryInterferenceCooldownMs(){
  const ratio=getInterferenceLevelRatio();
  const base=MEMORY_INTERFERENCE_COOLDOWN_MAX_MS - ((MEMORY_INTERFERENCE_COOLDOWN_MAX_MS - MEMORY_INTERFERENCE_COOLDOWN_MIN_MS) * ratio);
  const adjusted=base/Math.max(0.5,getContestTensionMultiplier());
  return Math.round(Math.max(MEMORY_INTERFERENCE_COOLDOWN_MIN_MS,Math.min(MEMORY_INTERFERENCE_COOLDOWN_MAX_MS,adjusted)));
}

function getAmbientInterferenceChance(){
  const ratio=getInterferenceLevelRatio();
  const chance=(0.055 + (ratio*0.2)) * getContestTensionMultiplier();
  return Math.max(0.03,Math.min(0.33,chance));
}

function getFearEventCooldownMs(){
  const ratio=getInterferenceLevelRatio();
  const base=FEAR_EVENT_COOLDOWN_MAX_MS - ((FEAR_EVENT_COOLDOWN_MAX_MS - FEAR_EVENT_COOLDOWN_MIN_MS) * ratio);
  const adjusted=base/Math.max(0.5,getContestTensionMultiplier());
  return Math.round(Math.max(FEAR_EVENT_COOLDOWN_MIN_MS,Math.min(FEAR_EVENT_COOLDOWN_MAX_MS,adjusted)));
}

function getFearEventChance(){
  const ratio=getInterferenceLevelRatio();
  const chance=(0.035 + (ratio*0.11)) * getContestTensionMultiplier();
  return Math.max(0.02,Math.min(0.22,chance));
}

// ========================================
// AUTO-TRANSLATION SCRIPT (EN VERSION)
// ========================================
// This script automatically translates Spanish content to English
// using Google Translate (primary) and fallback APIs.
// Translations are cached in localStorage to avoid re-translating.
// ========================================

const AutoTranslator = {
  cache: {},
  currentAPI: 0, // Index of current API being used
  runtimeTranslatePending: false,
  apis: [
    {
      name: 'GoogleTranslate',
      url: 'https://translate.googleapis.com/translate_a/single',
      maxChars: 5000,
      translate: async function(text) {
        try {
          // Use Google Translate's public API (client=gtx parameter allows anonymous access)
          const params = new URLSearchParams({
            client: 'gtx',
            sl: 'es',
            tl: 'en',
            dt: 't',
            q: text
          });
          
          const response = await fetch(`${this.url}?${params}`, {
            method: 'GET',
            headers: {
              'Accept': '*/*'
            }
          });
          
          if (!response.ok) {
            if (response.status === 429 || response.status === 403) {
              throw new Error('RATE_LIMIT');
            }
            throw new Error('API_ERROR');
          }
          
          const data = await response.json();
          
          // Google Translate returns array: [[[translated_text, original_text, null, null, score]]]
          if (data && data[0] && Array.isArray(data[0])) {
            const translations = data[0].map(item => item[0]).filter(Boolean);
            return translations.join('');
          }
          
          throw new Error('API_ERROR');
        } catch (e) {
          if (e.message === 'RATE_LIMIT') {
            throw e;
          }
          console.error('[GoogleTranslate] Error:', e);
          throw new Error('API_ERROR');
        }
      }
    },
    {
      name: 'MyMemory',
      url: 'https://api.mymemory.translated.net/get',
      maxChars: 500,
      translate: async function(text) {
        try {
          const params = new URLSearchParams({
            q: text,
            langpair: 'es|en'
          });
          
          const response = await fetch(`${this.url}?${params}`, {
            method: 'GET'
          });
          
          if (!response.ok) {
            if (response.status === 429 || response.status === 403) {
              throw new Error('RATE_LIMIT');
            }
            throw new Error('API_ERROR');
          }
          
          const data = await response.json();
          
          // Check for rate limit error
          if (data.responseData && data.responseData.translatedText) {
            const translated = data.responseData.translatedText.toUpperCase();
            if (translated.includes('MYMEMORY WARNING') || 
                translated.includes('USED ALL AVAILABLE') ||
                translated.includes('FREE TRANSLATIONS') ||
                translated.includes('QUOTA EXCEEDED')) {
              console.warn('[API] MyMemory rate limit detected');
              throw new Error('RATE_LIMIT');
            }
          }
          
          if (data.responseStatus === 403 || data.responseStatus === 429) {
            throw new Error('RATE_LIMIT');
          }
          
          if (data.responseStatus === 200 || data.responseData) {
            return data.responseData.translatedText;
          }
          throw new Error('API_ERROR');
        } catch (e) {
          if (e.message === 'RATE_LIMIT') {
            throw e;
          }
          throw new Error('API_ERROR');
        }
      }
    },
    {
      name: 'LibreTranslate',
      url: 'https://translate.argosopentech.com/translate',
      maxChars: 3000,
      translate: async function(text) {
        try {
          const response = await fetch(this.url, {
            method: 'POST',
            body: JSON.stringify({
              q: text,
              source: 'es',
              target: 'en',
              format: 'text'
            }),
            headers: { 'Content-Type': 'application/json' }
          });
          
          if (!response.ok) {
            if (response.status === 429 || response.status === 403) {
              throw new Error('RATE_LIMIT');
            }
            throw new Error('API_ERROR');
          }
          
          const data = await response.json();
          if (data.translatedText) {
            return data.translatedText;
          }
          throw new Error('API_ERROR');
        } catch (e) {
          if (e.message === 'RATE_LIMIT') {
            throw e;
          }
          throw new Error('API_ERROR');
        }
      }
    }
  ],
  maxChunkSize: 4500,
  delay: 200, // Delay between requests to avoid rate limits
  startTime: null,
  estimatedTime: null,
  failedAPIs: new Set(),
  cornerProgressEnabled: false,
  cornerProgressDismissTimer: null,
  lastStage: 'Initializing',
  lastCurrent: 0,
  lastTotal: 0,
  lastPercentage: 0,
  lastItem: '',
  
  // Initialize translation cache from localStorage
  init() {
    try {
      const cached = localStorage.getItem('voidTranslations');
      if (cached) {
        this.cache = JSON.parse(cached);
        console.log('[AutoTranslator] Loaded', Object.keys(this.cache).length, 'cached translations');
      }
    } catch (e) {
      console.warn('[AutoTranslator] Could not load cache:', e);
    }
  },
  
  // Save cache to localStorage
  saveCache() {
    try {
      localStorage.setItem('voidTranslations', JSON.stringify(this.cache));
    } catch (e) {
      console.warn('[AutoTranslator] Could not save cache:', e);
    }
  },
  
  // Generate cache key for a text
  getCacheKey(text) {
    return text.substring(0, 100); // Use first 100 chars as key
  },
  
  // Get next available API
  getNextAPI() {
    // Try each API until we find one that hasn't failed
    for (let i = 0; i < this.apis.length; i++) {
      const apiIndex = (this.currentAPI + i) % this.apis.length;
      if (!this.failedAPIs.has(apiIndex)) {
        this.currentAPI = apiIndex;
        return this.apis[apiIndex];
      }
    }
    // All APIs failed, reset and try again
    this.failedAPIs.clear();
    return this.apis[0];
  },
  
  // Timeout wrapper for API calls
  async withTimeout(promise, timeoutMs = 10000) {
    return Promise.race([
      promise,
      new Promise((_, reject) => 
        setTimeout(() => reject(new Error('TIMEOUT')), timeoutMs)
      )
    ]);
  },
  
  // Translate a single text chunk using available APIs
  async translateChunk(text) {
    const cacheKey = this.getCacheKey(text);
    
    // Return cached translation if available
    if (this.cache[cacheKey]) {
      console.log('[AutoTranslator] Using cached translation');
      return this.cache[cacheKey];
    }
    
    // Try translating with available APIs
    let lastError = null;
    const maxAttempts = this.apis.length * 2; // Try each API twice
    
    for (let attempt = 0; attempt < maxAttempts; attempt++) {
      const api = this.getNextAPI();
      
      try {
        console.log(`[AutoTranslator] Attempt ${attempt + 1}/${maxAttempts}: Using ${api.name} API (text length: ${text.length})`);
        
        // Use timeout wrapper to prevent hanging
        const translated = await this.withTimeout(
          api.translate(text),
          8000 // 8 second timeout per attempt
        );
        
        // Success! Cache and return
        this.cache[cacheKey] = translated;
        this.saveCache();
        console.log(`[AutoTranslator] ✓ ${api.name} succeeded`);
        return translated;
        
      } catch (e) {
        console.warn(`[AutoTranslator] ${api.name} failed:`, e.message);
        lastError = e;
        
        if (e.message === 'TIMEOUT') {
          console.warn(`[AutoTranslator] ${api.name} timed out, trying next API...`);
          this.currentAPI = (this.currentAPI + 1) % this.apis.length;
        } else if (e.message === 'RATE_LIMIT') {
          // Mark this API as failed and try next one
          this.failedAPIs.add(this.currentAPI);
          this.currentAPI = (this.currentAPI + 1) % this.apis.length;
        } else {
          // Other error, wait a bit and try next API
          await new Promise(resolve => setTimeout(resolve, 300));
          this.currentAPI = (this.currentAPI + 1) % this.apis.length;
        }
      }
    }
    
    // All APIs failed, return original text
    console.error('[AutoTranslator] ⚠ All translation attempts failed, returning original text');
    return text;
  },
  
  // Split long text into chunks and translate
  async translateLongText(text) {
    if (!text || text.length === 0) return text;
    
    console.log(`[AutoTranslator] translateLongText called (length: ${text.length})`);
    
    // If text is short enough, translate directly
    if (text.length <= this.maxChunkSize) {
      await new Promise(resolve => setTimeout(resolve, this.delay));
      return await this.translateChunk(text);
    }
    
    // Split by paragraphs/lines
    const parts = text.split(/\n+/);
    const translated = [];
    
    console.log(`[AutoTranslator] Text split into ${parts.length} parts`);
    
    let currentChunk = '';
    let chunkNum = 0;
    for (const part of parts) {
      if (currentChunk.length + part.length <= this.maxChunkSize) {
        currentChunk += (currentChunk ? '\n' : '') + part;
      } else {
        if (currentChunk) {
          chunkNum++;
          console.log(`[AutoTranslator] Translating chunk ${chunkNum} (${currentChunk.length} chars)`);
          await new Promise(resolve => setTimeout(resolve, this.delay));
          try {
            const result = await this.translateChunk(currentChunk);
            translated.push(result);
          } catch (e) {
            console.error(`[AutoTranslator] Error in chunk ${chunkNum}:`, e);
            translated.push(currentChunk); // Use original on error
          }
        }
        currentChunk = part;
      }
    }
    
    if (currentChunk) {
      chunkNum++;
      console.log(`[AutoTranslator] Translating final chunk ${chunkNum} (${currentChunk.length} chars)`);
      await new Promise(resolve => setTimeout(resolve, this.delay));
      try {
        const result = await this.translateChunk(currentChunk);
        translated.push(result);
      } catch (e) {
        console.error(`[AutoTranslator] Error in final chunk:`, e);
        translated.push(currentChunk); // Use original on error
      }
    }
    
    console.log(`[AutoTranslator] translateLongText completed (${chunkNum} chunks processed)`);
    return translated.join('\n');
  },
  
  // Update progress display with time estimation
  updateProgress(stage, current, total, percentage, currentItem = '') {
    this.lastStage = stage;
    this.lastCurrent = current;
    this.lastTotal = total;
    this.lastPercentage = percentage;
    this.lastItem = currentItem || '';

    const statusText = document.getElementById('translationStatus');
    const detailText = document.getElementById('translationDetail');
    const currentText = document.getElementById('translationCurrent');
    const progressBar = document.getElementById('translationProgress');
    const percentText = document.getElementById('translationPercent');
    const timeText = document.getElementById('translationTime');
    const apiText = document.getElementById('translationAPI');
    
    if (statusText) statusText.innerHTML = `<span style="color: #ff6666;">></span> ${stage.toUpperCase()}`;
    if (detailText) detailText.textContent = `[${current} / ${total}] ITEMS PROCESSED`;
    if (currentText) {
      if (currentItem) {
        currentText.textContent = `Current: ${currentItem}`;
      } else {
        currentText.textContent = 'Processing...';
      }
    }
    if (progressBar) progressBar.style.width = `${percentage}%`;
    if (percentText) percentText.textContent = `${Math.round(percentage)}%`;
    
    // Update current API
    if (apiText) {
      const currentAPI = this.apis[this.currentAPI];
      const failedCount = this.failedAPIs.size;
      if (failedCount > 0) {
        apiText.innerHTML = `${currentAPI.name.toUpperCase()} <span style="opacity: 0.6;">(${failedCount} failed)</span>`;
      } else {
        apiText.textContent = currentAPI.name.toUpperCase();
      }
    }
    
    // Calculate estimated time remaining
    if (timeText && percentage > 0) {
      const elapsed = (Date.now() - this.startTime) / 1000; // seconds
      const rate = percentage / elapsed;
      const remaining = (100 - percentage) / rate;
      
      if (remaining > 60) {
        const mins = Math.ceil(remaining / 60);
        timeText.textContent = `EST. ${mins} MIN REMAINING`;
      } else {
        timeText.textContent = `EST. ${Math.ceil(remaining)} SEC REMAINING`;
      }
    }

    this.updateCornerProgress(stage, current, total, percentage, currentItem);
  },

  ensureCornerProgressUI() {
    let box = document.getElementById('translationCornerProgress');
    if (box) return box;

    box = document.createElement('div');
    box.id = 'translationCornerProgress';
    box.style.cssText = `
      position: fixed;
      right: 14px;
      bottom: 14px;
      width: min(340px, 88vw);
      padding: 10px 12px;
      background: rgba(6, 10, 14, 0.92);
      border: 1px solid #2b3f50;
      color: #cfe2f1;
      z-index: 100001;
      font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      font-size: 11px;
      display: none;
      box-shadow: 0 0 16px rgba(0,0,0,0.5);
      pointer-events: none;
    `;
    box.innerHTML = `
      <div id="translationCornerTitle" style="font-weight:bold; letter-spacing:.7px; margin-bottom:6px; color:#9fd0ff;">TRANSLATION SYNC</div>
      <div id="translationCornerMeta" style="opacity:.85; margin-bottom:6px;">0% · [0/0]</div>
      <div style="height:4px; background:#102030; border:1px solid #1f3342; overflow:hidden; margin-bottom:6px;">
        <div id="translationCornerBar" style="height:100%; width:0%; background:linear-gradient(90deg,#64b4ff,#4a9adb);"></div>
      </div>
      <div id="translationCornerItem" style="opacity:.75; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">Waiting...</div>
    `;
    document.body.appendChild(box);
    return box;
  },

  enableCornerProgress() {
    if (window.forceLanguage !== 'en') return;
    this.cornerProgressEnabled = true;
    const box = this.ensureCornerProgressUI();
    box.style.display = 'block';
    this.updateCornerProgress(this.lastStage, this.lastCurrent, this.lastTotal, this.lastPercentage, this.lastItem);
  },

  disableCornerProgress(delayMs = 0) {
    const hide = () => {
      const box = document.getElementById('translationCornerProgress');
      if (box) box.style.display = 'none';
    };
    if (this.cornerProgressDismissTimer) {
      clearTimeout(this.cornerProgressDismissTimer);
      this.cornerProgressDismissTimer = null;
    }
    if (delayMs > 0) {
      this.cornerProgressDismissTimer = setTimeout(hide, delayMs);
      return;
    }
    hide();
  },

  updateCornerProgress(stage, current, total, percentage, currentItem = '') {
    if (!this.cornerProgressEnabled) return;
    const box = this.ensureCornerProgressUI();
    if (box.style.display === 'none') box.style.display = 'block';

    const title = document.getElementById('translationCornerTitle');
    const meta = document.getElementById('translationCornerMeta');
    const bar = document.getElementById('translationCornerBar');
    const item = document.getElementById('translationCornerItem');

    if (title) title.textContent = String(stage || 'TRANSLATION').toUpperCase();
    if (meta) meta.textContent = `${Math.round(percentage || 0)}% · [${current || 0}/${total || 0}]`;
    if (bar) bar.style.width = `${Math.max(0, Math.min(100, percentage || 0))}%`;
    if (item) item.textContent = currentItem ? `Current: ${currentItem}` : 'Processing...';
  },

  isTranslatableString(text) {
    return typeof text === 'string' && text.trim().length > 0;
  },

  async translateMailEntryInPlace(mail) {
    if (!mail || window.forceLanguage !== 'en' || mail.__translatedEn) return;
    try {
      if (this.isTranslatableString(mail.subject)) {
        mail.subject = await this.translateLongText(mail.subject);
      }
      if (this.isTranslatableString(mail.body)) {
        mail.body = await this.translateLongText(mail.body);
      }
      if (Array.isArray(mail.responses)) {
        for (const response of mail.responses) {
          if (this.isTranslatableString(response.label)) {
            response.label = await this.translateLongText(response.label);
          }
          if (this.isTranslatableString(response.text)) {
            response.text = await this.translateLongText(response.text);
          }
        }
      }
      mail.__translatedEn = true;
    } catch (error) {
      console.warn('[AutoTranslator] Runtime mail translation failed:', error);
    }
  },

  async translateRuntimeCollections() {
    if (window.forceLanguage !== 'en' || this.runtimeTranslatePending) return;
    this.runtimeTranslatePending = true;
    try {
      if (typeof floorNotes !== 'undefined' && floorNotes) {
        for (const key in floorNotes) {
          const note = floorNotes[key];
          if (!note) continue;
          if (this.isTranslatableString(note.name)) note.name = await this.translateLongText(note.name);
          if (this.isTranslatableString(note.hint)) note.hint = await this.translateLongText(note.hint);
          if (this.isTranslatableString(note.content)) note.content = await this.translateLongText(note.content);
        }
      }

      if (typeof missions !== 'undefined' && Array.isArray(missions)) {
        for (const mission of missions) {
          if (!mission) continue;
          if (this.isTranslatableString(mission.title)) mission.title = await this.translateLongText(mission.title);
          if (this.isTranslatableString(mission.description)) mission.description = await this.translateLongText(mission.description);
          if (this.isTranslatableString(mission.objective)) mission.objective = await this.translateLongText(mission.objective);
        }
      }

