function advanceVoidTime(){
  if(gameEnded) return;
  // Avanza entre 4 y 7 segundos (más lento)
  const advanceAmount=Math.floor(Math.random()*4)+4;
  voidTime.totalSeconds+=advanceAmount;
  
  voidTime.seconds=voidTime.totalSeconds%60;
  voidTime.minutes=Math.floor(voidTime.totalSeconds/60)%60;
  voidTime.hours=Math.floor(voidTime.totalSeconds/3600)%24;
  
  // Actualizar displays
  updateVoidTimeDisplay();

  // Corrupcion de open_server entre 7 y 9 minutos
  if(!openServerCorrupted && voidTime.totalSeconds>=openServerCorruptAt){
    triggerOpenServerCorruption();
  }
  
  // Procesar cola de correos progresivos
  if(emailsQueue.length>0){
    const dueEmails=emailsQueue.filter(e=>{
      const shouldSend=voidTime.totalSeconds>=e.time && !emailsSent.has(e.id);
      if(shouldSend){
        console.log(`[EMAIL] ${e.from}: ${e.subject} (tiempo: ${voidTime.totalSeconds}s)`);
      }
      return shouldSend;
    });
    dueEmails.forEach(e=>{
      receiveMail(e.from,e.subject,e.body,e.attachments||[]);
      emailsSent.add(e.id);
    });
  }

  processAltOrientationCues();

  // Verificar vencimiento de reportes Jobs (tiempo del juego)
  // Solo si hay timer activo y ha pasado el máximo tiempo desde último reporte
  if(jobsTimerActive && jobsLastReportTime!==null){
    const timeSinceLastReport=voidTime.totalSeconds-jobsLastReportTime;
    if(timeSinceLastReport>=JOBS_REPORT_MAX_DELAY && !gameEnded){
      triggerFiredEnding();
      return;
    }
  }
  
  // Checar si llegó a 06:00:00 (21600 segundos)
  if(voidTime.totalSeconds>=21600 && !gameEnded){
    triggerGameEnd();
