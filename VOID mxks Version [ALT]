@keyframes voidFearMonitorFlicker{0%,100%{opacity:1;filter:brightness(1);}30%{opacity:.4;filter:brightness(.25);}58%{opacity:.22;filter:brightness(.12);}}

@keyframes callRing{0%{opacity:1;}50%{opacity:0.5;}100%{opacity:1;}}
@keyframes continuePulse{0%,100%{transform:scale(1);box-shadow:0 0 0 rgba(130,220,255,0);}50%{transform:scale(1.04);box-shadow:0 0 18px rgba(130,220,255,0.45);}}

.mail-container{display:flex;gap:8px;height:100%;box-sizing:border-box;}
.mail-list{width:170px;background:#111;border:1px solid var(--line);overflow-y:auto;}
.mail-item{padding:8px;border-bottom:1px solid var(--line);cursor:pointer;}
.mail-item.unread{background:#161616;font-weight:bold;color:var(--accent);}
