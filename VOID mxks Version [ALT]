function showElevatorAnimation(fromFloor, toFloor, callback){
  playSound('sfxDoor');
  
  // Crear overlay del ascensor
  const overlay=document.createElement('div');
  overlay.className='elevator-transition';
  overlay.id='elevatorOverlay';
  
  const floorMap={office:'0',floor1:'1',floor2:'2',floor3:'3',basement:'-3'};
  const fromNum=floorMap[fromFloor];
  const toNum=floorMap[toFloor];
  
  overlay.innerHTML=`
    <div class="elevator-floor-display">${fromNum}</div>
    <div class="elevator-bar">
      <div class="elevator-bar-fill"></div>
    </div>
    <div class="elevator-text">▲▼ ELEVATOR IN TRANSIT ▼▲</div>
    <div style="margin-top:20px;font-size:12px;color:#f0a;letter-spacing:2px;">FLOOR: <strong>${floorMap[toFloor]}</strong></div>
  `;
  
  document.body.appendChild(overlay);
  
  // Animar número de piso EN MEDIO
  setTimeout(()=>{
    const floorDisplay=overlay.querySelector('.elevator-floor-display');
    if(floorDisplay) floorDisplay.textContent=toNum;
  }, 800);
  
  playSound('sfxDoor');
  
  // Ejecutar callback y remover overlay
  setTimeout(()=>{
    if(callback) callback();
    if(overlay && overlay.parentNode){
