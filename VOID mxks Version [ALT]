  const circumference=138;
  if(indicator) indicator.classList.add('active');
  if(progressRing) progressRing.style.strokeDashoffset=String(circumference);

  const tick=()=>{
    if(!introHoldSkipStartedAt) return;
    const elapsed=Date.now()-introHoldSkipStartedAt;
    const progress=Math.max(0, Math.min(1, elapsed/INTRO_HOLD_SKIP_MS));
    if(progressRing){
      progressRing.style.strokeDashoffset=String(circumference*(1-progress));
    }
    introHoldSkipProgressRaf=requestAnimationFrame(tick);
  };
  introHoldSkipProgressRaf=requestAnimationFrame(tick);

  introHoldSkipTimer=setTimeout(()=>{
    introHoldSkipTimer=null;
    introHoldSkipStartedAt=0;
    if(introHoldSkipProgressRaf){
      cancelAnimationFrame(introHoldSkipProgressRaf);
      introHoldSkipProgressRaf=null;
    }
    if(indicator) indicator.classList.remove('active');
    if(introPlaybackActive){
      skipIntroVideo();
    }
  }, INTRO_HOLD_SKIP_MS);
}

