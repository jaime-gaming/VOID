function getBurnsTutorialProgress(){
  const required=ecoAssistantState.requiredBurnsFiles||[];
  const opened=ecoAssistantState.openedBurnsFiles||{};
  const doneCount=required.filter(name=>opened[name]).length;
  const done=doneCount===required.length;
  const missing=required.filter(name=>!opened[name]);
  return {required,doneCount,done,missing};
}

function registerTutorialBurnsOpen(fileName){
  if(!ecoAssistantState||!ecoAssistantState.openedBurnsFiles) return;
  if(Object.prototype.hasOwnProperty.call(ecoAssistantState.openedBurnsFiles,fileName)){
    ecoAssistantState.openedBurnsFiles[fileName]=true;
    renderEcoAssistantStep();
  }
}

function canCloseEcoAssistant(){
  return getBurnsTutorialProgress().done;
}

function attemptCloseEcoAssistant(){
  if(!canCloseEcoAssistant()){
    showGameAlert('ECO Assistant lock:\nOpen Burns files first to finish onboarding.');
    return;
  }
  closeWindow('ecoAssistantWindow');
}

function ecoAssistantStepAction(index){
  if(index===0){
    openEcoPressureApp();
    return;
  }
  if(index===1){
    openMiniGamesApp();
    return;
  }
  if(index===2){
    const progress=getBurnsTutorialProgress();
    const target=progress.missing[0]||'burns_profile.txt';
    openFile(target);
    return;
  }
  openEcoPressureApp();
  openMiniGamesApp();
}

function renderEcoAssistantStep(){
  const steps=getEcoAssistantSteps();
  const safeIndex=Math.max(0,Math.min(steps.length-1,ecoAssistantState.step));
  ecoAssistantState.step=safeIndex;
  const step=steps[safeIndex];
  const title=document.getElementById('ecoAssistantTitle');
  const body=document.getElementById('ecoAssistantBody');
  const count=document.getElementById('ecoAssistantCount');
  const actionBtn=document.getElementById('ecoAssistantActionBtn');
  const prevBtn=document.getElementById('ecoAssistantPrevBtn');
  const nextBtn=document.getElementById('ecoAssistantNextBtn');
  const progress=getBurnsTutorialProgress();
  if(title) title.textContent=step.title;
  if(body){
    let renderedBody=step.body;
    if(safeIndex===2){
      renderedBody+=`\n\nStatus: ${progress.doneCount}/${progress.required.length}`;
      if(progress.missing.length){
        renderedBody+=`\nMissing: ${progress.missing.join(', ')}`;
      }
    }
    body.textContent=renderedBody;
  }
  if(count) count.textContent=`Step ${safeIndex+1}/${steps.length}`;
  if(actionBtn){
    if(safeIndex===2){
      actionBtn.textContent=progress.done?'Burns files verified':`Open ${progress.missing[0]||'burns_profile.txt'}`;
    }else{
      actionBtn.textContent=step.cta;
    }
  }
  if(prevBtn) prevBtn.disabled=safeIndex===0;
  if(nextBtn){
    const lockedAtBurns=safeIndex===2 && !progress.done;
    nextBtn.textContent=safeIndex===steps.length-1?'FINISH':'NEXT';
    nextBtn.disabled=lockedAtBurns;
    nextBtn.style.opacity=lockedAtBurns?'0.55':'1';
  }
}

function ecoAssistantNext(){
  const steps=getEcoAssistantSteps();
  if(ecoAssistantState.step===2 && !getBurnsTutorialProgress().done){
    showGameAlert('Tutorial locked:\nOpen burns_profile.txt and burns_last_shift.log to continue.');
    return;
  }
  if(ecoAssistantState.step>=steps.length-1){
    attemptCloseEcoAssistant();
    return;
  }
  ecoAssistantState.step++;
  renderEcoAssistantStep();
}

function ecoAssistantPrev(){
  ecoAssistantState.step=Math.max(0,ecoAssistantState.step-1);
  renderEcoAssistantStep();
}

