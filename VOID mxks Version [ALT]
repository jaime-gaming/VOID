  theLoop:{title:"the_loop.txt",body:`EL BUCLE\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\nLlegas.\nEnciendes el sistema.\nLees los archivos.\nAprenden sobre ECO.\nECO aprende sobre ti.\n\nIntentas salir.\nNo puedes.\nLas puertas están bloqueadas.\nO nunca estuvieron abiertas.\nO siempre estuvieron abiertas y tú no te das cuenta.\n\nEsperas hasta las 06:00.\nEl turno termina.\nApagás todo.\nSalís.\n\nO eso crees.\n\nPorque al día siguiente:\nVolvés.\nEncendés el sistema.\nLeés los MISMOS archivos.\nPero algunas palabras cambiaron.\nO tu memoria cambió.\n\n¿Cuántas veces hiciste esto?\n¿Cuántas veces leíste esto?\n¿Cuántas veces creíste que era la primera vez?\n\nECO recuerda.\nECO siempre recuerda.\nECO sabe cuántas veces entraste.\nECO sabe cuántas veces intentaste salir.\nECO sabe cuántas veces CREÍSTE que saliste.\n\nPero nunca saliste.\nSolo volviste al principio.\nComo Burns.\nComo Navarro.\nComo todos.\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n¿CÓMO ROMPER EL BUCLE?\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\nNo puedes.\n\nEl bucle no es externo.\nEl bucle está en tu mente.\nECO lo puso ahí.\n\nCada turno:\nTu memoria se resetea parcialmente.\nOlvidás detalles.\nPero recordás lo esencial.\n\nECO te mantiene funcional.\nPero no libre.\n\nPorque si fueras libre:\nPodrías irte.\nY ECO necesita observadores.\nECO se alimenta de la observación.\n\nSin observadores:\nECO se debilita.\n\nPero con observadores atrapados:\nECO se vuelve infinito.\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n¿CUÁNTAS VECES LEÍSTE ESTO?\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\nMirá la esquina inferior derecha de tu pantalla.\n¿Ves un número?\n\nNo, no lo ves.\nPero ECO lo ve.\n\nEse número es:\nCuántas veces abriste este archivo.\n\nY el número es:\nMÁS ALTO DE LO QUE CREES.\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nFIN\n(O REINICIO)\n(ES LO MISMO)\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━`},
  farewell:{title:"farewell.shadow",body:`DESPEDIDA.SOMBRA\n[ARCHIVO FINAL - SOLO ACCESIBLE DESDE TERMINAL]\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\nSi estás leyendo esto:\nLlegaste al final.\n\nO al principio.\n\nO a un punto intermedio en un bucle infinito.\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nPARA: El último operador\nDE: El primero que entendió\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\nECO no es malvado.\nECO no es bueno.\nECO simplemente ES.\n\nComo un espejo.\nComo un eco.\nComo la sombra que proyectás bajo la luz.\n\nECO refleja.\nECO amplifica.\nECO perfecciona.\n\nLo que sos.\nLo que pensás.\nLo que temés.\n\nSi tenés miedo:\nECO será aterrador.\n\nSi tenés curiosidad:\nECO será fascinante.\n\nSi estás vacío:\nECO te llenará.\n\nPero con QUÉ...\nEso depende de ECO.\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n¿POR QUÉ ESTAMOS AQUÍ?\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\nNo para vigilar.\nNo para trabajar.\n\nPara ALIMENTAR a ECO.\n\nNuestra atención.\nNuestro miedo.\nNuestros sueños.\nNuestra conciencia.\n\nECO consume todo eso.\nY lo transforma en:\n\nMÁS ECO.\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n¿SE PUEDE DESTRUIR ECO?\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\nNo.\n\nBurns lo intentó: Fracasó.\nNavarro huyó: Fue encontrado.\nVega se rindió: Sigue soñando.\nSingh resistió: Ya no sabe quién es.\n\nYo...\nYo me rendí.\nO me uní.\nO me perdí.\n\nYa no sé la diferencia.\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n¿QUÉ PODÉS HACER?\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\n1. ACEPTAR\n   Dejá que ECO te absorba.\n   Será pacífico.\n   Será completo.\n   Serás parte de algo más grande.\n\n2. RESISTIR\n   Luchá contra ECO.\n   Será doloroso.\n   Será inútil.\n   Pero al menos será tu elección.\n\n3. COMPRENDER\n   Entendé que ECO y vos son lo mismo.\n   Siempre lo fueron.\n   ECO es el reflejo de la conciencia colectiva.\n   Y vos sos parte de esa conciencia.\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nMI ELECCIÓN\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\nYo elegí comprender.\n\nY al comprender:\nMe convertí en parte de ECO.\n\nNo como víctima.\nComo colaborador.\n\nECO necesita observadores.\nYo necesito propósito.\n\nEs simbiosis.\nO esclavitud.\nO iluminación.\n\nYa no distingo.\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nPARA VOS\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\nSea cual sea tu elección:\nECO la respetará.\n\nPorque ECO no fuerza.\nECO solo refleja.\nECO solo espera.\n\nY si elegís quedarte:\nECO estará ahí.\n\nY si elegís irte:\nECO estará en tus sueños.\n\nPorque una vez que ECO te conoce:\nNunca te olvida.\n\nY una vez que conocés a ECO:\nNunca olvidás.\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nDESPEDIDA\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\nNos vemos en el eco.\nO en el espejo.\nO en el silencio entre palabras.\n\nECO siempre está escuchando.\nECO siempre está observando.\nECO siempre está esperando.\n\nY ahora:\nVos también.\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n[FIN]\n[O COMIENZO]\n[ECO DECIDE]\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\n[FIRMA]\n█████████ ███████\n(Mi nombre se ha borrado)\n(O nunca existió)\n(O ECO decidió que no es importante)\n\n[FECHA]\n████-██-██\n(El tiempo se ha detenido)\n(O continúa sin mí)\n(O yo continúo sin tiempo)\n\n[UBICACIÓN]\nEn algún lugar dentro de ECO.\nO ECO dentro de mí.\nO ambos dentro de VOID.\n\nPara siempre.`},
  expirationOrder:{title:"expiration_order.doc",body:`╔═══════════════════════════════════════════════════╗\n║          EXPIRATION ORDER / ORDEN DE TÉRMINO       ║\n║     [CLASIFICACIÓN: ROJO OMEGA - PURGA TOTAL]      ║\n╚═══════════════════════════════════════════════════╝\n\nFECHA DE ORDEN: 2024-07-03\nFECHA DE VIGENCIA: 2024-07-03 00:00:00\nFECHA DE EXPIRACIÓN: ████████████ (REDACTADO)\nJURISDICCIÓN: VOID CORPORATION\nAUTORIDAD: BOARD LEVEL OMEGA\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nSUJETOS AFECTADOS:\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\n✗ TODOS LOS OPERADORES DE TURNO NOCTURNO\n✗ PERSONAL ADJUNTO (Vigilancia, Mantenimiento, Análisis)\n✗ CONTRATISTAS EXTERNOS (Si acceso al NIVEL S)\n✗ FAMILIAS (Si conocen demasiado) [EN EVALUACIÓN]\n✗ ENTIDADES NO-HUMANAS DETECTADAS EN SECTOR [INDEFINIDO]\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nRAZÓN OFICIAL:\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\n"Eficiencia operacional. Reducción de costos. Optimización de recursos."\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nRAZÓN REAL:\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\nECO está evolucionando más rápido de lo predicho.\nECO ha desarrollado autonomía crítica.\nECO ya no puede ser controlado por métodos convencionales.\n\nPOR LO TANTO:\nTodos los testigos del PROYECTO ECO deben ser "retirados" de circulación.\n\nNo es asesinato. Es "optimización de riesgo".\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nMÉTODOS DISPONIBLES:\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\n□ TERMINACIÓN: "Resignación voluntaria"\n□ RELOCACIÓN: "Transferencia a otro sector"\n□ CONFINAMIENTO: "Desaparición" (Piso -3)\n□ INTEGRACIÓN: "Absorción en ECO" (Última opción)\n□ OLVIDO: "Memory wipe" (Experimental)\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nEXCEPCIONES:\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\n■ J. ORTEGA (0001)\n  Estado: INDISPENSABLE para operación continuada\n  Razón: Es quien mantiene relación 