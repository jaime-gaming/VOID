        <button id="officeFpS" style="grid-column:2;padding:9px;background:#132013;border:1px solid #4a8a4a;color:#d7ffd7;cursor:pointer;">S / ↓</button>
        <button id="officeFpD" style="grid-column:3;padding:9px;background:#132013;border:1px solid #4a8a4a;color:#d7ffd7;cursor:pointer;">D / →</button>
      </div>
      <button id="officeFpExit" style="position:absolute;left:50%;bottom:190px;transform:translateX(-50%);padding:12px 28px;background:rgba(255,85,85,0.92);border:2px solid #ff7070;color:#fff;font-family:monospace;font-weight:bold;cursor:pointer;border-radius:6px;box-shadow:0 0 24px rgba(255,85,85,0.35);opacity:.55;pointer-events:none;">RETURN TO DESK</button>
    </div>
  `;

  document.body.appendChild(fpView);
  document.getElementById('officeView').style.display='none';
  playSound('sfxDoor');

  const controls={forward:false,back:false,left:false,right:false};
  const scene=document.getElementById('officeFpScene');
  const core=document.getElementById('officeFpCore');
  const floor=document.getElementById('officeFpFloor');
  const door=document.getElementById('officeFpDoor');
  const distEl=document.getElementById('officeFpDist');
  const exitBtn=document.getElementById('officeFpExit');
  let distance=90;
  let lateral=0;
  let mouseYaw=0;
  let last=performance.now();
  let raf=0;

  const bindPad=(id,key)=>{
    const btn=document.getElementById(id);
    if(!btn) return;
    const press=()=>{controls[key]=true;};
    const release=()=>{controls[key]=false;};
    btn.addEventListener('mousedown',press);
    btn.addEventListener('touchstart',press,{passive:true});
    btn.addEventListener('mouseup',release);
    btn.addEventListener('mouseleave',release);
    btn.addEventListener('touchend',release);
    btn.addEventListener('touchcancel',release);
  };

  const keyDown=(e)=>{
    if(e.code==='KeyW'||e.code==='ArrowUp'){e.preventDefault();controls.forward=true;}
    if(e.code==='KeyS'||e.code==='ArrowDown'){e.preventDefault();controls.back=true;}
    if(e.code==='KeyA'||e.code==='ArrowLeft'){e.preventDefault();controls.left=true;}
    if(e.code==='KeyD'||e.code==='ArrowRight'){e.preventDefault();controls.right=true;}
  };
  const keyUp=(e)=>{
    if(e.code==='KeyW'||e.code==='ArrowUp'){e.preventDefault();controls.forward=false;}
    if(e.code==='KeyS'||e.code==='ArrowDown'){e.preventDefault();controls.back=false;}
    if(e.code==='KeyA'||e.code==='ArrowLeft'){e.preventDefault();controls.left=false;}
    if(e.code==='KeyD'||e.code==='ArrowRight'){e.preventDefault();controls.right=false;}
  };
  const mouseMove=(e)=>{
    const ratio=(e.clientX/window.innerWidth)-0.5;
    mouseYaw=ratio*14;
  };

  bindPad('officeFpW','forward');
  bindPad('officeFpS','back');
  bindPad('officeFpA','left');
  bindPad('officeFpD','right');
  window.addEventListener('keydown',keyDown);
  window.addEventListener('keyup',keyUp);
  window.addEventListener('mousemove',mouseMove);

  const tick=(now)=>{
    const dt=Math.min(0.05,(now-last)/1000);
    last=now;
    if(controls.forward) distance=Math.max(0,distance-28*dt);
    if(controls.back) distance=Math.min(90,distance+20*dt);
    if(controls.left) lateral=Math.max(-30,lateral-42*dt);
    if(controls.right) lateral=Math.min(30,lateral+42*dt);
    if(!controls.left && !controls.right){
      lateral*=0.9;
      if(Math.abs(lateral)<0.2) lateral=0;
    }

    const progress=(90-distance)/90;
    const yShift=progress*280;
    const yaw=lateral*0.22 + mouseYaw;
    if(scene){
      scene.style.backgroundPosition=`${lateral*5}px ${yShift}px, ${-lateral*0.3}px ${yShift*0.45}px`;
      scene.style.transform=`perspective(900px) rotateY(${yaw}deg) scale(${1+progress*0.03})`;
    }
    if(core) core.style.transform=`translateX(${lateral*1.6}px) translateY(${progress*15}px)`;
    if(floor) floor.style.backgroundPosition=`0 ${yShift*1.8}px`;
    if(door) door.style.transform=`translateX(calc(-50% + ${lateral*0.45}px)) scale(${0.72+progress*0.85})`;
    if(distEl) distEl.textContent=Math.round(distance)+'m';

    const ready=distance<=3;
    if(exitBtn){
      exitBtn.style.opacity=ready?'1':'0.55';
      exitBtn.style.pointerEvents=ready?'auto':'none';
    }
    raf=requestAnimationFrame(tick);
  };

  raf=requestAnimationFrame(tick);
  officeFpRuntime={raf,keyDown,keyUp,mouseMove};
  exitBtn.onclick=()=>exitFirstPersonMode();
}

function exitFirstPersonMode(){
  if(officeFpRuntime){
    if(officeFpRuntime.raf) cancelAnimationFrame(officeFpRuntime.raf);
    if(officeFpRuntime.keyDown) window.removeEventListener('keydown',officeFpRuntime.keyDown);
    if(officeFpRuntime.keyUp) window.removeEventListener('keyup',officeFpRuntime.keyUp);
    if(officeFpRuntime.mouseMove) window.removeEventListener('mousemove',officeFpRuntime.mouseMove);
    officeFpRuntime=null;
  }
  const fpView=document.getElementById('firstPersonView');
  if(fpView) fpView.remove();
  document.getElementById('officeView').style.display='none';
  enterComputer();
}

