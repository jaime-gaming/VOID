function playIntroVideo(showLoginAfter){
  if(introPlaybackActive) return;
  const intro=document.getElementById('intro');
  const introVideo=document.getElementById('introVideo');
  configureIntroVideoSource();
  if(!intro){
    if(showLoginAfter){
      const login=document.getElementById('loginScreen');
      if(login) login.style.display='flex';
    }
    return;
  }

  introPlaybackActive=true;
  introPlaybackShowsLogin=!!showLoginAfter;
  intro.style.display='flex';
  setupIntroHoldSkipControls();
  startSyncedTranslationWithIntro();

  const endPlayback=()=>finishIntroVideo(showLoginAfter);

  if(!introVideo){
    setTimeout(endPlayback, 3500);
    return;
  }

  const safeEnd=setTimeout(endPlayback, 170000);
  const onEnded=()=>{
    clearTimeout(safeEnd);
    introVideo.removeEventListener('ended', onEnded);
    introVideo.removeEventListener('error', onError);
    endPlayback();
  };
  const onError=()=>{
    clearTimeout(safeEnd);
    introVideo.removeEventListener('ended', onEnded);
    introVideo.removeEventListener('error', onError);
    setTimeout(endPlayback, 3500);
  };

  introVideo.addEventListener('ended', onEnded);
  introVideo.addEventListener('error', onError);
  if(Number.isFinite(introVideo.duration) && introVideo.duration>0){
    normalizeIntroVideoDuration(introVideo);
  }else{
    introVideo.addEventListener('loadedmetadata', ()=>normalizeIntroVideoDuration(introVideo), {once:true});
  }
  introVideo.currentTime=0;
  introVideo.muted=false;
  introVideo.volume=1;
  introVideo.play().catch(onError);
}

