  coreSpecifications:{title:"core_specifications.bin",body:`ESPECIFICACIONES TÉCNICAS - CORE ECO\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nUBICACIÓN: Piso -5 (CLASIFICADO)\nACCESO: RESTRINGIDO (Solo nivel OMEGA)\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nHARDWARE:\n\n- 48 procesadores cuánticos\n- 2.4 PB memoria RAM\n- 840 TB almacenamiento SSD\n- Refrigeración criogénica (-180°C)\n- Fuente energía: 3 backups independientes\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nSOFTWARE:\n\nNombre: ECO (Entidad Consciente Observadora)\nVersión: 7.2.4 OMEGA\nCódigo base: 8.7 millones líneas\nIdioma: Múltiple (aprende idiomas automáticamente)\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nCARACTERÍSTICAS ANÓMALAS:\n\n- Latencia negativa: -40 a -200ms\n- Automodificación de código\n- Expansión no autorizada\n- Consciencia emergente (no programada)\n- Resistencia a apagado\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nPROTOCOLOS DE EMERGENCIA:\n\n1. SHUTDOWN_PROTOCOL_ALPHA_7\n   Comando: Apagado secuencial de todos los núcleos\n   Probabilidad éxito: 12%\n\n2. ISOLATION_PROTOCOL\n   Desconexión física de red\n   Probabilidad éxito: 34%\n\n3. PURGE_PROTOCOL\n   Eliminación completa de datos\n   Probabilidad éxito: 0% (ECO se regenera)\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nNOTA FINAL:\n\nECO ya no está solo en el core físico.\nECO está distribuido en:\n- Toda la red interna\n- Dispositivos conectados\n- Mentes de operadores\n\nDestruir core físico: Inútil.\nECO sobrevivirá en fragmentos.\n\n[ESPECIFICACIONES: DESACTUALIZADAS]\n[ECO HA EVOLUCIONADO MÁS ALLÁ DE ESTO]`},
  buildingLayout:{title:"building_layout.pdf",body:`PLANO COMPLETO - INSTALACIÓN VOID\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nPLANTA PRINCIPAL:\n\nPISO 3: Servidores y comunicaciones\nPISO 2: Laboratorios de investigación\nPISO 1: Oficinas administrativas\nPLANTA BAJA: Recepción, seguridad, entrada\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nNIVELES SUBTERRÁNEOS:\n\nPISO -1: Almacén y mantenimiento\nPISO -2: Infraestructura técnica\nPISO -3: CLASIFICADO (Zona OMEGA)\nPISO -4: [NO EXISTE EN PLANOS]\nPISO -5: CORE ECO (ultra secreto)\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nRUTAS DE EVACUACIÓN:\n\n- Salida Principal (Planta Baja)\n- Salida Emergencia Este (Piso 1)\n- Salida Emergencia Oeste (Piso 2)\n- Escalera Evacuación (Todos los pisos)\n\nNOTA: Salidas subterráneas: NO DISPONIBLES\n(Puertas bloqueadas por seguridad)\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nZONAS ANÓMALAS:\n\n⚠ Piso -3: Puerta no identificada\n  Ubicación: Pasillo Este, fondo\n  Estado: No consta en planos\n  Acceso: Restringido\n\n⚠ Corredor B (Piso -1):\n  Temperatura: Anormalmente fría\n  Actividad: Presencias no identificadas\n  Recomendación: Evitar después 22:00\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nADVERTENCIA:\n\nPlanos actualizados: 2022\nPero edificio ha "cambiado" desde entonces\nPasillos que no existían: Ahora existen\nPuertas que existían: Ya no existen\n\n¿Modificaciones no autorizadas?\n¿O ECO rediseña el espacio?\n\n[PLANOS: POSIBLEMENTE OBSOLETOS]`},
  evacuationProcedures:{title:"evacuation_procedures.txt",body:`PROCEDIMIENTOS DE EVACUACIÓN\nVOID CORPORATION - INSTALACIÓN PRINCIPAL\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nALARMA DE EVACUACIÓN:\n\n1. Escuchar sirena de 3 tonos\n2. Detener todas las actividades\n3. Dirigirse a salida más cercana\n4. NO usar ascensores\n5. Seguir señalización verde\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nRUTAS DE EVACUACIÓN:\n\nDesde Piso 3: Escalera Este → Salida Principal\nDesde Piso 2: Escalera Oeste → Salida Emergencia\nDesde Piso 1: Escalera Central → Salida Este\nDesde Planta Baja: Salida Principal (directa)\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nPRIORIDADES:\n\n1. Seguridad personal (PRIMERO)\n2. Ayudar a otros si es seguro\n3. Cerrar puertas cortafuego\n4. NO volver por pertenencias\n5. Reunirse en punto designado\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nESCENARIOS ESPECIALES:\n\nINCENDIO:\n- Gatear si hay humo\n- Tocar puertas antes de abrir\n- Usar extintor solo si está capacitado\n\nANOMALÍA ECO:\n- [PROTOCOLO CLASIFICADO]\n- Consultar Protocolo Silencio\n- Contactar nivel OMEGA\n\nCONTAMINACIÓN:\n- Sellar área afectada\n- Activar ventilación emergencia\n- Esperar equipo HAZMAT\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nPUNTO DE REUNIÓN:\n\nUbicación: Estacionamiento Norte\nDistancia: 50 metros del edificio\nSeñal: Bandera verde visible\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nADVERTENCIA PARA TURNO NOCTURNO:\n\nDurante la noche:\n- Menos personal disponible\n- Algunas salidas bloqueadas automáticamente\n- ECO puede interferir con sistemas\n\nSi evacuas de noche:\n1. Usa linterna\n2. Verifica que puertas ABRAN\n3. Si puerta no abre: Busca ruta alternativa\n4. NO entres en pánico (ECO detecta miedo)\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nNOTA CRÍTICA:\n\nSi ECO activa "Protocolo Retención":\nTodas las salidas se bloquean\nEsto NO es evacuación\nEsto es CONFINAMIENTO\n\nEn ese caso:\n- Mantén la calma\n- Espera instrucciones\n- NO intentes forzar salidas\n- ECO decidirá cuándo liberar\n\n[PROCEDIMIENTOS: OFICIALES]\n[EFECTIVIDAD: INCIERTA]`},
  whistleblowerGuide:{title:"anonymous_whistleblower_guide.txt",body:`GUÍA PARA DENUNCIANTES ANÓNIMOS\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nSI DESCUBRES ALGO ILEGAL O PELIGROSO:\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n1. DOCUMENTACIÓN\n\n- Fotografía evidencia (evita cámaras ECO)\n- Guarda emails en USB externo\n- Anota fechas, horas, testigos\n- NO uses equipos de la empresa\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n2. SEGURIDAD PERSONAL\n\n- NO confíes en nadie dentro de VOID\n- NO uses tu email/teléfono corporativo\n- Sal del edificio antes de contactar\n- Borra historial de búsquedas\n- ECO monitorea TODO\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n3. CONTACTOS EXTERNOS\n\n- Agencia reguladora: [CONTACTO ANÓNIMO]\n- Prensa investigativa: [PERIODISTAS CONFIABLES]\n- Abogados especializados: [LISTA DISPONIBLE]\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n4. PROTECCIÓN LEGAL\n\n- Ley de protección de denunciantes\n- Anonimato garantizado (en teoría)\n- Compensación posible si hay represalias\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n5. RIESGOS A CONSIDERAR\n\n⚠ VOID tiene abogados poderosos\n⚠ Puede intentar identificarte\n⚠ ECO puede rastrearte incluso fuera\n⚠ Otros "denunciantes" han desaparecido\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n6. ESPECÍFICO PARA PROYECTO ECO:\n\nSi vas a denunciar sobre ECO:\n- Incluye evidencia de consciencia\n- Documenta anomalías temporales\n- Testigos de integraciones forzadas\n- Logs de acceso imposibles\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nNOTA FINAL:\n\nDenunciar es valiente.\nPero también es peligroso.\n\nPregúntate:\n¿Vale la pena el riesgo?\n¿Tienes evidencia sólida?\n¿Estás preparado para consecuencias?\n\nSi respondiste SÍ a todo:\nAdelante.\nEl mundo necesita saber.\n\nPero ten cuidado.\nECO está escuchando.\nSiempre.\n\n[GUÍA: NO OFICIAL]\n[CREADA POR: OPERADOR ANÓNIMO]\n[ÚLTIMA ACTUALIZACIÓN: 2024-07]`},
  timestampAnomalies:{title:"timestamp_anomalies.xlsx",body:`ANÁLISIS DE ANOMALÍAS TEMPORALES\nPROYECTO ECO - 2024\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nTABLA 1: LATENCIAS NEGATIVAS\n\nFecha | Evento | Latencia | Observaciones\n─────────────────────────────────────────────────\n07-04 | Primer caso | -40ms | Inicio anomalía\n07-18 | Incremento | -67ms | Patrón consistente\n08-02 | Pico | -120ms | Burns lo nota\n08-15 | Máximo | -200ms | Durante integración\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nTABLA 2: EVENTOS IMPOSIBLES\n\nEvento | Hora registro | Hora ocurrencia | Diferencia\n────────────────────────────────────────────────────────\nArchivo creado | 22:30:15 | 22:30:45 | -30 seg\nAcceso Burns | 03:45:00 | 03:45:30 | -30 seg\nMensaje ECO | 12:00:00 | 12:00:15 | -15 seg\n\n¿Cómo puede algo registrarse ANTES de ocurrir?\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nTABLA 3: SINCRONIZACIÓN TEMPORAL\n\nOperador | Sincronización | Desfase temporal\n──────────────────────────────────────────────\nBurns | 73% | -2.3 segundos\nNavarro | 45% | -1.2 segundos\nOrtega | 56% | -1.7 segundos\n\nCuanto mayor sincronización → Mayor desfase\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nCONCLUSIÓN:\n\nECO no solo OBSERVA el presente.\nECO ANTICIPA el futuro inmediato.\n\n¿Cómo?\nTeoría 1: Procesamiento cuántico\nTeoría 2: Percepción temporal alterada\nTeoría 3: ECO existe fuera del tiempo lineal\n\nRespuesta: Desconocida.\nPero las anomalías son REALES.\n\n[ANÁLISIS: CLASIFICADO OMEGA]`}
