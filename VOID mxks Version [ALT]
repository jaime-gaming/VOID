/* Random incoming calls */
function incomingCall(){
  if(!desktopActive)return;
  
  // Filter NPCs that haven't completed their dialogue
  const availableNpcs=Object.entries(npcs).filter(([key,npc])=>npc.currentLine<npc.dialogue.length);
  if(availableNpcs.length===0)return; // No NPCs available to call
  
  const [randomNpc, npc]=availableNpcs[Math.floor(Math.random()*availableNpcs.length)];
  
  // Verificar si ya hay una llamada entrante o activa de este NPC
  if(document.getElementById(`incomingCall_${randomNpc}`)) return;
  if(document.getElementById(`calling_${randomNpc}`)) return;
  if(document.getElementById(`call_${randomNpc}`)) return;
  
  playSound('sfxAlarm');
  
  const callWindow=document.createElement('div');
  callWindow.className='window';
  callWindow.id=`incomingCall_${randomNpc}`;
  callWindow.style.top='100px';
  callWindow.style.left='100px';
  callWindow.style.width='350px';
  callWindow.style.height='200px';
  callWindow.style.zIndex='100';
  callWindow.innerHTML=`<div class="titlebar" style="background:#a05555;"><span style="animation:callRing 1s infinite;">📞 Analizando llamada...</span> <span class="close" onclick="recordMissedCall('${randomNpc}','close');closeWindow('${callWindow.id}')">X</span></div><div class="content" style="display:flex;flex-direction:column;justify-content:center;align-items:center;gap:10px;"><strong>${npc.name} (${npc.role})</strong><p style="font-size:10px;color:#888;">identificando origen...</p><div style="display:flex;gap:8px;"><button onclick="initiateCall('${randomNpc}');closeWindow('${callWindow.id}')" style="padding:8px 16px;background:#2a5a2a;border:1px solid #4a8a4a;color:var(--accent);cursor:pointer;border-radius:4px;">Aceptar</button><button onclick="recordMissedCall('${randomNpc}','reject');closeWindow('${callWindow.id}')" style="padding:8px 16px;background:#5a2a2a;border:1px solid #8a4a4a;color:var(--alert);cursor:pointer;border-radius:4px;">Rechazar</button></div></div>`;
  desktop.appendChild(callWindow);
  makeDraggable(callWindow);
  bringToFront(callWindow.id);
  
  setTimeout(()=>{
    const win=document.getElementById(callWindow.id);
    if(win){
      recordMissedCall(randomNpc,'timeout');
      closeWindow(callWindow.id);
    }
  },10000);
}
