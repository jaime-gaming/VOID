function makeDraggable(element){
  const title=element.querySelector('.titlebar');
  let offsetX=0,offsetY=0,dragging=false;
  const move=(e)=>{
    if(!dragging)return;
    let newX=e.clientX-offsetX;
    let newY=e.clientY-offsetY;
    
    // Limitar a los bordes del viewport
    const maxX=window.innerWidth-element.offsetWidth;
    const taskbarHeight=(document.getElementById('taskbar') && document.getElementById('taskbar').style.display!=='none')?32:0;
    const maxY=window.innerHeight-element.offsetHeight-taskbarHeight;
    
    if(newX<0)newX=0;
    if(newY<0)newY=0;
    if(newX>maxX)newX=maxX;
    if(newY>maxY)newY=maxY;
    
    element.style.left=newX+'px';
    element.style.top=newY+'px';
  };
  const up=()=>{
    dragging=false;
    clampWindowToViewport(element);
    document.removeEventListener('mousemove',move);
    document.removeEventListener('mouseup',up);
  };
  title.addEventListener('mousedown',(e)=>{
    dragging=true;
    const rect=element.getBoundingClientRect();
    offsetX=e.clientX-rect.left;
    offsetY=e.clientY-rect.top;
    bringToFront(element.id);
    document.addEventListener('mousemove',move);
    document.addEventListener('mouseup',up);
  });
}

function clampWindowToViewport(win){
  if(!win) return;
  const rect=win.getBoundingClientRect();
  const pad=8;
  const taskbarHeight=(document.getElementById('taskbar') && document.getElementById('taskbar').style.display!=='none')?32:0;
  const maxX=Math.max(pad, window.innerWidth-rect.width-pad);
  const maxY=Math.max(pad, window.innerHeight-rect.height-pad-taskbarHeight);
  const nextX=Math.min(Math.max(pad, rect.left), maxX);
  const nextY=Math.min(Math.max(pad, rect.top), maxY);
  win.style.left=nextX+'px';
  win.style.top=nextY+'px';
}

function openWindow(id){
  const win=document.getElementById(id);
  if(!win)return;
  playSound('sfxClick');
  win.style.display='flex';
  bringToFront(id);
  clampWindowToViewport(win);
  if(!taskbarWindows.includes(id))taskbarWindows.push(id);
  updateTaskbar();
  
  // Inicializar cámaras cuando se abre la ventana
  if(id === 'cameraWindow'){
    setTimeout(initCameras, 100);
  }
  
  // Iniciar monitor idle cuando se abre terminal
  if(id==='terminalWindow'){
    resetTerminalActivity();
    startTerminalIdleMonitor();
  }
}

function closeWindow(id){
  const win=document.getElementById(id);
  if(win){
    playSound('sfxClick');
    win.style.display='none';
    
    // Detener monitor idle cuando se cierra terminal
    if(id==='terminalWindow'){
      stopTerminalIdleMonitor();
    }

    if(id==='cameraWindow'){
      if(cameraSilhouetteInterval){
        clearInterval(cameraSilhouetteInterval);
        cameraSilhouetteInterval=null;
      }
    }
    
    // Eliminar acceso del escritorio cuando se cierra open_server
    if(id==='openServerWindow'){
      const openServerIcon=document.querySelector('.icon[data-key="openServer"]');
      if(openServerIcon){
        openServerIcon.remove();
      }
      const openServerFile=files.find(f=>f.key==='openServer');
      if(openServerFile){
        openServerFile.hidden=true;
      }
    }
  }
}

function bringToFront(id){
  let max=10;
  document.querySelectorAll('.window').forEach(w=>{max=Math.max(max,parseInt(window.getComputedStyle(w).zIndex)||10);});
  const win=document.getElementById(id);
  if(win)win.style.zIndex=max+1;
}

function updateTaskbar(){
  const bar=document.getElementById('taskbar');
  bar.querySelectorAll('.taskbarTask').forEach(el=>el.remove());
  
  // Array de programas que queremos en la taskbar
  const programs=[
    {id:'jobsWindow',label:'Jobs',name:'jobs'},
    {id:'callWindow',label:'Calls',name:'calls'},
    {id:'cameraWindow',label:'Cams',name:'cameras'},
    {id:'mailWindow',label:'Mail',name:'mail'},
    {id:'terminalWindow',label:'Terminal',name:'terminal'}
  ];
  
  programs.forEach(prog=>{
    const win=document.getElementById(prog.id);
    if(!win)return;
    
    const el=document.createElement('div');
    el.className='task taskbarTask';
    el.textContent=prog.label;
    el.style.fontSize='10px';
    el.style.padding='2px 6px';
    el.style.marginRight='3px';
    el.onclick=()=>{
      if(win.style.display==='none' || win.style.display===''){openWindow(prog.id);}else{win.style.display='none';}
    };
    bar.insertBefore(el,document.getElementById('clock'));
  });
}

function randomGridPosition(){
  const cols=Math.max(1,Math.floor((window.innerWidth-160-gridOrigin.x)/gridSize));
  const rows=Math.max(1,Math.floor((window.innerHeight-240-gridOrigin.y)/gridSize));
  const iconWidth=92;
  const iconHeight=120;
  let x,y,collision;
  let attempts=0;
  do{
    const col=Math.floor(Math.random()*cols);
    const row=Math.floor(Math.random()*rows);
    x=gridOrigin.x+col*gridSize;
    y=gridOrigin.y+row*gridSize;
    collision=!isSpotFree(x,y,null,iconWidth,iconHeight);
    attempts++;
  }while(collision && attempts<40);
  return {x,y};
}

function snapToGrid(value,origin,limit){
  const snapped=origin+Math.round((value-origin)/gridSize)*gridSize;
  return Math.max(origin,Math.min(snapped,limit));
}

function rectsOverlap(a,b){
  return !(a.right<=b.left || a.left>=b.right || a.bottom<=b.top || a.top>=b.bottom);
}

function isSpotFree(x,y,icon,forcedWidth,forcedHeight){
  const width=forcedWidth || (icon ? (icon.offsetWidth||92) : 92);
  const height=forcedHeight || (icon ? (icon.offsetHeight||120) : 120);
  const test={left:x,top:y,right:x+width,bottom:y+height};
  const icons=document.querySelectorAll('.icon');
  for(const other of icons){
    if(other===icon) continue;
    const r=other.getBoundingClientRect();
    if(rectsOverlap(test,r)) return false;
  }
  return true;
}

function findNearestFreeSpot(x,y,icon){
  const maxX=window.innerWidth-140;
  const maxY=window.innerHeight-200;
  const baseX=snapToGrid(x,gridOrigin.x,maxX);
  const baseY=snapToGrid(y,gridOrigin.y,maxY);
  const cols=Math.max(1,Math.floor((window.innerWidth-160-gridOrigin.x)/gridSize));
  const rows=Math.max(1,Math.floor((window.innerHeight-240-gridOrigin.y)/gridSize));
  const startCol=Math.round((baseX-gridOrigin.x)/gridSize);
  const startRow=Math.round((baseY-gridOrigin.y)/gridSize);

  if(isSpotFree(baseX,baseY,icon)) return {x:baseX,y:baseY};

  const maxRadius=Math.max(cols,rows);
  for(let r=1;r<=maxRadius;r++){
    for(let dx=-r;dx<=r;dx++){
      for(let dy=-r;dy<=r;dy++){
        if(Math.abs(dx)+Math.abs(dy)!==r) continue;
        const col=startCol+dx;
        const row=startRow+dy;
        if(col<0 || row<0 || col>=cols || row>=rows) continue;
        const candX=gridOrigin.x+col*gridSize;
        const candY=gridOrigin.y+row*gridSize;
        if(isSpotFree(candX,candY,icon)) return {x:candX,y:candY};
      }
    }
  }
  return {x:baseX,y:baseY};
}

function resolveDesktopOverlaps(){
  const icons=Array.from(document.querySelectorAll('.icon'));
  icons.forEach((icon)=>{
    const rect=icon.getBoundingClientRect();
    const spot=findNearestFreeSpot(rect.left,rect.top,icon);
    icon.style.left=spot.x+'px';
    icon.style.top=spot.y+'px';
  });
}

function layoutDesktopIcons(){
  const icons=Array.from(document.querySelectorAll('.icon'));
  const cols=Math.max(1,Math.floor((window.innerWidth-160-gridOrigin.x)/gridSize));
  let col=0;
  let row=0;
  icons.sort((a,b)=>String(a.dataset.key).localeCompare(String(b.dataset.key)));
  icons.forEach((icon)=>{
    const x=gridOrigin.x+col*gridSize;
    const y=gridOrigin.y+row*gridSize;
    icon.style.left=x+'px';
    icon.style.top=y+'px';
    col++;
    if(col>=cols){
      col=0;
      row++;
    }
  });
}

function scheduleDesktopLayout(){
  requestAnimationFrame(()=>{
    layoutDesktopIcons();
    resolveDesktopOverlaps();
    requestAnimationFrame(()=>{
      layoutDesktopIcons();
      resolveDesktopOverlaps();
    });
  });
  setTimeout(()=>{
    layoutDesktopIcons();
    resolveDesktopOverlaps();
  },50);
}

function snapIcon(icon){
  const rect=icon.getBoundingClientRect();
  const spot=findNearestFreeSpot(rect.left,rect.top,icon);
  icon.style.left=spot.x+'px';
  icon.style.top=spot.y+'px';
}

function makeIconDraggable(icon){
  let dragging=false,offsetX=0,offsetY=0;
  const move=(e)=>{
    if(!dragging)return;
    const proposedX=e.clientX-offsetX;
    const proposedY=e.clientY-offsetY;
    const spot=findNearestFreeSpot(proposedX,proposedY,icon);
    icon.style.left=spot.x+'px';
    icon.style.top=spot.y+'px';
  };
  const up=()=>{
    dragging=false;
    snapIcon(icon);
    scheduleDesktopLayout();
    document.removeEventListener('mousemove',move);
    document.removeEventListener('mouseup',up);
  };
  icon.addEventListener('mousedown',(e)=>{
    if(e.button!==0)return;
    dragging=true;const rect=icon.getBoundingClientRect();offsetX=e.clientX-rect.left;offsetY=e.clientY-rect.top;
    document.addEventListener('mousemove',move);document.addEventListener('mouseup',up);
  });
}

