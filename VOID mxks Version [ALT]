function readExternalFlags(){
  try{
    const raw=sessionStorage.getItem('void_external_flags');
    if(!raw) return {};
    const parsed=JSON.parse(raw);
    return parsed && typeof parsed === 'object' ? parsed : {};
  }catch(e){
    console.warn('[VOID] External flags read failed', e);
    return {};
  }
}

function applyExternalEffects(){
  const flags=readExternalFlags();
  if(flags.gateUnlocked && !externalEffectsApplied.gate){
    externalEffects.gateUnlocked=true;
    externalEffectsApplied.gate=true;
    const file=files.find(f=>f.key==='gateHandshake');
    if(file){
      file.hidden=false;
      file.secretTerminalOnly=true;
    }
    receiveMail('system@void','ENLACE EXTERNO DETECTADO','Se registro un apreton de manos fuera de red.\n\nEl enlace puede contener ruido.\nArchivo agregado: gate_handshake.log');
    playthroughTracking.suspiciousActions.push('external_gate');
