function saveToHardDrive(){
  const fileName=document.getElementById('hardDriveFileName').value.trim();
  if(!fileName){alert('Ingresa un nombre para el archivo');return;}
  askPasswordUI(HARD_DRIVE_PASSWORD,'hard drive',()=>{
    const unlockedFiles=files.filter(f=>unlockedDocs.includes(f.key));
    if(unlockedFiles.length===0){alert('No hay archivos desbloqueados para guardar.');return;}
    const fileData=unlockedFiles.map(f=>({
      key:f.key,
      name:f.name,
      folder:f.folder,
      content:fileContents[f.key]?.body||''
    }));
    hardDriveStorage[fileName]={timestamp:new Date().toLocaleString(),files:fileData,count:fileData.length};
    document.getElementById('hardDriveFileName').value='';
    renderHardDrive();
    alert(`✓ ${fileData.length} files saved to hard drive as "${fileName}"`);
    updateMissionProgress('save_files');
  });
}

