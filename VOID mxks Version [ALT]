function configureIntroVideoSource(){
  const introVideo=document.getElementById('introVideo');
  if(!introVideo || introVideo.dataset.assetResolved==='1') return;

  const assetName=introVideo.dataset.assetName||'VOIDMXKSnight_shift.mp4';
  const candidates=[
    `../../assets/${assetName}`,
    `../assets/${assetName}`,
    `assets/${assetName}`,
    `./assets/${assetName}`,
    `../../../assets/${assetName}`
  ];

  let currentIndex=0;

  const cleanup=()=>{
    introVideo.removeEventListener('loadeddata', onLoaded);
    introVideo.removeEventListener('error', onError);
  };

  const onLoaded=()=>{
    introVideo.dataset.assetResolved='1';
    cleanup();
    console.log('[VOID] Intro video resolved:', introVideo.currentSrc || introVideo.src);
  };

  const onError=()=>{
    if(currentIndex>=candidates.length){
      cleanup();
      console.warn('[VOID] Intro video asset not found in expected paths:', candidates.join(' | '));
      return;
    }
    introVideo.src=candidates[currentIndex++];
    introVideo.load();
  };

  introVideo.addEventListener('loadeddata', onLoaded);
  introVideo.addEventListener('error', onError);
  onError();
}

