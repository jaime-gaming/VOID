  return true;
}

function triggerMiniCinematic(type){
  if(!desktopActive || gameEnded || miniCinematicActive) return;
  miniCinematicActive=true;
  const hourIntensity=getMemoryHourIntensity();
  const typeBoost=(type==='childLaugh') ? 0.18 : (type==='flashbackIntro' ? 0.1 : 0.06);
  const memoryIntensity=Math.min(1.45, hourIntensity+typeBoost);
  const audioFirstInterference=(type==='childLaugh' || type==='serverMemory');

  const overlay=document.createElement('div');
  overlay.id='miniCinematicOverlay';
  overlay.dataset.type=type;
  const frame=document.createElement('div');
  frame.className='frame';
  const noise=document.createElement('div');
  noise.className='noise';
  const ghost=document.createElement('div');
  ghost.className='ghost';
  const tear=document.createElement('div');
  tear.className='tear';
  const vignette=document.createElement('div');
  vignette.className='vignette';
  frame.appendChild(noise);
  frame.appendChild(ghost);
  frame.appendChild(tear);
  frame.appendChild(vignette);
  if(audioFirstInterference){
    overlay.style.background='radial-gradient(circle at 50% 50%,rgba(8,10,12,.08) 0%,rgba(0,0,0,.34) 66%,rgba(0,0,0,.58) 100%)';
  }
  overlay.style.backdropFilter=`blur(${(1.0+memoryIntensity*1.25).toFixed(2)}px) contrast(${(1.02+memoryIntensity*0.08).toFixed(2)})`;
  frame.style.filter=`contrast(${(1.04+memoryIntensity*0.12).toFixed(2)}) saturate(${(0.88-memoryIntensity*0.12).toFixed(2)})`;
  startMiniCinematicBuzz(memoryIntensity);

  if(type==='flashbackIntro'){
    const introVideo=document.getElementById('introVideo');
    const src=(introVideo && (introVideo.currentSrc || introVideo.src)) || '';
    if(src){
      const memoryVideo=document.createElement('video');
      memoryVideo.src=src;
      memoryVideo.autoplay=true;
      memoryVideo.playsInline=true;
      memoryVideo.muted=false;
      memoryVideo.volume=Math.min(0.45, 0.2 + memoryIntensity*0.13);
      memoryVideo.playbackRate=Math.max(0.72, 0.86 - memoryIntensity*0.08);
      frame.insertBefore(memoryVideo, noise);
      memoryVideo.play().catch(()=>{});
    }
    playSound('sfxGlitch');
  }else if(type==='serverMemory'){
    const servers=document.createElement('div');
    servers.className='servers';
    frame.insertBefore(servers, noise);
    playSound('sfxHover');
  }else if(type==='childLaugh'){
    const servers=document.createElement('div');
    servers.className='servers';
    frame.insertBefore(servers, noise);
    playChildLaughMemory();
  }

  overlay.appendChild(frame);
  document.body.appendChild(overlay);

  const applyDistortionPulse=()=>{
    const jitterX=2.2+memoryIntensity*2.8;
    const jitterY=1.4+memoryIntensity*1.8;
    const offsetX=(Math.random()-0.5)*jitterX;
    const offsetY=(Math.random()-0.5)*jitterY;
    const scale=1+(Math.random()*(0.009+memoryIntensity*0.01));
    const noiseOpacity=(0.12+Math.random()*(0.12+memoryIntensity*0.14)).toFixed(2);
    frame.style.transform=`translate(${offsetX}px,${offsetY}px) scale(${scale})`;
    noise.style.opacity=noiseOpacity;
    ghost.style.opacity=(0.11+Math.random()*(0.08+memoryIntensity*0.08)).toFixed(2);
    tear.style.top=`${10+Math.random()*68}%`;
    tear.style.opacity=(0.06+Math.random()*(0.08+memoryIntensity*0.08)).toFixed(2);
    if(miniCinematicBuzzNodes){
      const now=miniCinematicBuzzNodes.ctx.currentTime;
      const target=0.018 + memoryIntensity*0.045 + Math.random()*0.008;
      miniCinematicBuzzNodes.master.gain.setTargetAtTime(target, now, 0.14);
      miniCinematicBuzzNodes.lowPass.frequency.setTargetAtTime(210+memoryIntensity*520+Math.random()*70, now, 0.2);
      miniCinematicBuzzNodes.notch.frequency.setTargetAtTime(105+memoryIntensity*175+Math.random()*18, now, 0.2);
    }
  };
  if(miniCinematicDistortionInterval){
    clearInterval(miniCinematicDistortionInterval);
  }
  miniCinematicDistortionInterval=setInterval(applyDistortionPulse, Math.max(80, 132-memoryIntensity*35));
  if(miniCinematicBuzzUpdateInterval){
    clearInterval(miniCinematicBuzzUpdateInterval);
    miniCinematicBuzzUpdateInterval=null;
  }
  applyDistortionPulse();

  let closed=false;
  const closeOverlay=()=>{
    if(closed) return;
    closed=true;
    if(miniCinematicDistortionInterval){
      clearInterval(miniCinematicDistortionInterval);
      miniCinematicDistortionInterval=null;
    }
    if(miniCinematicBuzzUpdateInterval){
      clearInterval(miniCinematicBuzzUpdateInterval);
      miniCinematicBuzzUpdateInterval=null;
    }
    stopMiniCinematicBuzz();
    if(overlay.parentNode) overlay.remove();
    miniCinematicActive=false;
  };

  const lifetime=(type==='childLaugh' ? 3300 : 2900) + Math.round(memoryIntensity*320);
  setTimeout(closeOverlay, lifetime);
}

