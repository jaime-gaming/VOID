// Sistema de intentos de eliminar ECO
function attemptECODisable(){
  if(!ecoDisablingStatus.attempt){
    ecoDisablingStatus.failed=true;
    ecoDisablingStatus.timestamp=voidTime.totalSeconds;
    triggerNiceTryEnding();
    return;
  }
  
  // Verify this is the correct timing window
  if(voidTime.hours!==5 || voidTime.minutes!==59){
    playSound('sfxAlarm');
    receiveMail('eco@system','DETECTION','Manipulation attempt detected.\n\nProcess aborted.\n\nNo punishment. Only... increased monitoring.');
    ecoDisablingStatus.failed=true;
    return;
  }
  
  // Si todo es correcto, éxito
  ecoDisablingStatus.success=true;
  triggerDisabledEnding();
}

