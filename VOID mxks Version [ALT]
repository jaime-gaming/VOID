function sleepMs(ms){
  return new Promise(resolve=>setTimeout(resolve,ms));
}

async function decryptTypeText(element, targetText, speed=28, scrambleFrames=5){
  if(!element) return;
  const glyphs='%¬=|ª#@*/\\~+-_';
  let resolved='';

  for(let i=0;i<targetText.length;i++){
    const char=targetText[i];
    for(let frame=0;frame<scrambleFrames;frame++){
      const fakeChar=(char===' ')?' ':glyphs[Math.floor(Math.random()*glyphs.length)];
      const fakeTailLen=Math.max(0,Math.min(4,targetText.length-i-1));
      let fakeTail='';
      for(let t=0;t<fakeTailLen;t++){
        fakeTail+=glyphs[Math.floor(Math.random()*glyphs.length)];
      }
      element.textContent=resolved+fakeChar+fakeTail;
      await sleepMs(Math.max(10,Math.floor(speed/Math.max(2,scrambleFrames))));
    }
    resolved+=char;
    element.textContent=resolved;
    await sleepMs(speed);
  }
}

async function cycleCreditNames(element, names, holdMs=700){
  if(!element||!Array.isArray(names)) return;
  element.style.transition='opacity .35s ease';
  for(const name of names){
    element.style.opacity='1';
    await decryptTypeText(element,name,20,4);
    await sleepMs(holdMs);
    element.style.opacity='0';
    await sleepMs(380);
    element.textContent='';
  }
  element.style.opacity='1';
}

