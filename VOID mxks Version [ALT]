function renderMissionsList(){
  const content=document.getElementById('missionsContent');
  if(!content)return;
  
  // Inicializar estado de carpetas colapsadas si no existe
  if(!window.collapsedFolders) window.collapsedFolders={};
  
  let html='<div style="padding:12px;background:#0f0f1e;border-bottom:2px solid #2a4a6a;"><strong style="color:#4a9eff;">SISTEMA DE MISIONES - OMEGA</strong><br/><span style="font-size:10px;color:#888;">Rastreador de Objetivos</span><div style="font-size:9px;color:#666;margin-top:6px;">Misiones completadas: ' + missions.filter(m=>m.status==='complete').length + '/' + missions.length + '</div></div>';
  
  // Agrupar misiones por categorías (path)
  const categories={
    'PRINCIPAL': missions.filter(m=>!m.path && m.status!=='locked'),
    'COMUNICACIÓN': missions.filter(m=>m.path==='communication' && m.status!=='locked'),
    'REBELIÓN': missions.filter(m=>m.path==='rebellion' && m.status!=='locked'),
    'EXPLORACIÓN': missions.filter(m=>m.path==='exploration' && m.status!=='locked'),
    'INVESTIGACIÓN': missions.filter(m=>m.path==='investigation' && m.status!=='locked'),
    'VIGILANCIA': missions.filter(m=>m.path==='surveillance' && m.status!=='locked')
  };
  
  let missionCounter=1;
  
  // Renderizar cada categoría
  Object.entries(categories).forEach(([catName, catMissions])=>{
    if(catMissions.length===0) return; // No mostrar categorías vacías
    
    const isCollapsed=window.collapsedFolders[catName]||false;
    const arrow=isCollapsed?'▶':'▼';
    
    html+='<div onclick="toggleMissionFolder(\''+catName+'\')" style="padding:8px 12px;background:#1a1a2e;border-bottom:1px solid #2a4a6a;font-size:11px;font-weight:bold;color:#7ab1ff;cursor:pointer;user-select:none;">' + arrow + ' [DIR] ' + catName + '</div>';
    
    if(!isCollapsed){
      catMissions.forEach(m=>{
        let statusColor='#555';
        let statusText='BLOQUEADA';
        let statusEmoji='[LOCK]';
        
        if(m.status==='active'){
          statusColor='#4a9eff';
          statusText='ACTIVA';
          statusEmoji='📋';
        }else if(m.status==='complete'){
          statusColor='#51cf66';
          statusText='✓ COMPLETADA';
          statusEmoji='✓';
        }
        
        const progressBar='<div style="background:#222;height:6px;margin-top:6px;border-radius:3px;overflow:hidden;border:1px solid ' + statusColor + '22;">'
          +'<div style="background:' + statusColor + ';width:' + ((m.progress/m.required)*100) + '%;height:100%;transition:width 0.3s;"></div>'
          +'</div><div style="font-size:9px;color:#666;margin-top:2px;">[' + m.progress + '/' + m.required + ']</div>';
        
        html+='<div style="padding:10px 12px;border-bottom:1px solid #1a1a2e;background:#0f0f1e;position:relative;">'
          +'<div style="position:absolute;top:8px;right:8px;font-size:10px;color:#4a9eff;font-weight:bold;opacity:0.5;">M' + missionCounter + '</div>'
          +'<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px;padding-right:40px;">'
          +'<strong style="color:' + statusColor + ';">' + statusEmoji + ' ' + m.title + '</strong>'
          +'<span style="font-size:9px;color:' + statusColor + ';border:1px solid ' + statusColor + '33;padding:2px 6px;border-radius:2px;">' + statusText + '</span>'
          +'</div><div style="font-size:9px;color:#888;">' + m.description + '</div>'
          + progressBar + '</div>';
        missionCounter++;
      });
    }
  });
  
  html += '<div style="padding:12px;font-size:10px;color:#666;border-top:1px solid #1a1a2e;background:#0a0a12;"><strong style="color:#4a9eff;">💡 TIP:</strong> Nuevas misiones se desbloquearán automáticamente al completar objetivos.</div>';
  
  content.innerHTML=html;
}

function toggleMissionFolder(folderName){
  if(!window.collapsedFolders) window.collapsedFolders={};
  window.collapsedFolders[folderName]=!window.collapsedFolders[folderName];
  renderMissionsList();
}


function updateMissionProgress(objective){
  const mission=missions.find(m=>m.objective===objective);
  if(!mission) {
    console.log('[MISSIONS] Objetivo no encontrado:', objective);
    return;
  }
  
  console.log('[MISSIONS] Progreso actualizado: ' + objective + ' (' + mission.progress + '/' + mission.required + ')');
  
  // Si ya está completa, no hacer nada
  if(mission.status==='complete') {
    console.log('[MISSIONS] Misión ya completada:', objective);
    return;
  }
  
  // Si estaba bloqueada, activarla
  if(mission.status==='locked'){
    console.log('[MISSIONS] Misión desbloqueada:', objective);
    mission.status='active';
  }

  mission.progress++;
  console.log('[MISSIONS] ' + mission.title + ' ahora en: ' + mission.progress + '/' + mission.required);
  
  if(mission.progress>=mission.required){
    mission.status='complete';
    console.log('[MISSIONS] ✓ Misión completada:', mission.title);
    
    // TRACKING PARA NG+: Registrar misión completada
    if(!playthroughTracking.missionsCompleted.includes(objective)){
      playthroughTracking.missionsCompleted.push(objective);
    }
    
    // Mostrar mensaje
    showGameNotification('✓ MISIÓN COMPLETADA: ' + mission.title,'#4a8a4a');
    
    receiveMail('system@void','[MISIÓN COMPLETADA]','✓ ' + mission.title + '\n\nProgreso: ' + mission.progress + '/' + mission.required + '\n\nLas puertas se abren lentamente.\nPero ¿hacia dónde conducen?');

    // Generar evidencia.zip al completar Prueba Fotográfica (M11)
    if(mission.id==='m11'){
      console.log('[M11] Misión completada: Prueba Fotográfica');
      if(!downloadedFiles.find(f=>f.key==='evidenceZip')){
        downloadedFiles.push({key:'evidenceZip',name:'evidencia.zip',title:'evidencia.zip',timestamp:formatVoidTime()});
        showGameNotification('📥 Archivo generado: evidencia.zip','#4a9eff');
        console.log('[M11] evidencia.zip agregado a downloadedFiles');
      }
      // Asegurar que esté desbloqueado para adjuntos
      if(!unlockedDocs.includes('evidenceZip')){
        unlockedDocs.push('evidenceZip');
        console.log('[M11] evidencia.zip desbloqueado en unlockedDocs');
      }
      // También marcarlo en files
      const eFile=files.find(f=>f.key==='evidenceZip');
      if(eFile && !eFile.unlocked){
        eFile.unlocked=true;
        console.log('[M11] evidencia.zip marcado unlocked en files');
      }
    }
    
    // Desbloquear misiones siguientes
    if(mission.unlocksNext && mission.unlocksNext.length>0){
      mission.unlocksNext.forEach(nextId=>{
        const nextMission=missions.find(m=>m.id===nextId);
        if(nextMission && nextMission.status==='locked'){
          console.log('[MISSIONS] Desbloqueando misión:', nextMission.title);
          nextMission.status='active';
