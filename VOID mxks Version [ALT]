function addDocumentToReport(){
  const select=document.getElementById('jobsDocumentList');
  if(!select || select.value==='')return;
  
  const docKey=select.value;
  const file=files.find(f=>f.key===docKey);
  
  // Evitar duplicados
  if(jobsAttachedDocs.includes(docKey)){
    alert('This document is already attached.');
    return;
  }
  
  // Máximo 3 documentos por reporte
  if(jobsAttachedDocs.length>=3){
    alert('Maximum 3 documents per report.');
    return;
  }
  
  jobsAttachedDocs.push(docKey);
  updateJobsAttachedList();
  select.value=''; // Reset selector
