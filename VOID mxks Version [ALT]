    entry.style.borderBottom='1px solid #222';
    entry.textContent='✓ ['+timestamp+'] Reporte #'+jobsReportsCompleted+' enviado';
    historyList.insertBefore(entry, historyList.firstChild);
  }
  
  // Limpiar inputs
  verifyInput.value='';
  reportContent.value='';
  verifyInput.focus();
  
  // Sonido de éxito
