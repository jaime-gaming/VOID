  openWindow(winId);
}

function renderCallList(){
  const content=document.getElementById('callsContent');
  content.innerHTML=Object.entries(npcs).map(([key,npc])=>{
    const isOffline=npc.currentLine>=npc.dialogue.length;
    const status=isOffline?'<span style="color:#666;font-size:9px;"> [OFFLINE]</span>':'';
    const style=isOffline?'padding:8px;border-bottom:1px solid #222;opacity:0.4;cursor:not-allowed;':'padding:8px;border-bottom:1px solid #222;cursor:pointer;';
    const onclick=isOffline?'':'onclick="initiateCall(\''+key+'\');"';
    return `<div style="${style}" ${onclick}>${npc.name} (${npc.role})${status}</div>`;
  }).join('');
}

