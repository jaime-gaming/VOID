function executeEcoCommand(cmd){
  const output=document.getElementById('ecoOutput');
  if(!output) return;
  
  const input=document.getElementById('ecoInput');
  if(input) input.value='';
  
  const cmd_trim=cmd.trim().toLowerCase();
  let response='';
  
  // 30% de probabilidad de que Eco.sys se rebele (no en comandos críticos)
  const protectedCommands=new Set([
    'help','exit',
    'shutdown_protocol_alpha_7',
    'reestablish_michael_protocol',
    'negotiate_coexistence',
    'establish_communication_bridge'
