function updateJobsAttachedList(){
  const listEl=document.getElementById('jobsAttachedList');
  if(!listEl)return;
  
  if(jobsAttachedDocs.length===0){
    listEl.innerHTML='<div style="color:#888;">No attached documents</div>';
    return;
  }
  
  let html='';
  jobsAttachedDocs.forEach((docKey,idx)=>{
    if(docKey==='ecoInterviewReview'){
      html+='<div style="margin:4px 0;padding:4px;background:#0a2a0a;border:1px solid #2a6a2a;display:flex;justify-content:space-between;align-items:center;">'
        +'<span>ECO review (interview)</span>'
        +'<button onclick="removeDocumentFromReport(\'' + docKey + '\')" style="background:#661a1a;border:1px solid #ff6b6b;color:#ff6b6b;padding:2px 6px;font-size:8px;cursor:pointer;border-radius:2px;">✕</button>'
        +'</div>';
      return;
    }
    const file=files.find(f=>f.key===docKey);
    if(file){
      html+='<div style="margin:4px 0;padding:4px;background:#0a2a0a;border:1px solid #2a6a2a;display:flex;justify-content:space-between;align-items:center;">'
        +'<span>' + getLocalizedName(file) + '</span>'
        +'<button onclick="removeDocumentFromReport(\'' + docKey + '\')" style="background:#661a1a;border:1px solid #ff6b6b;color:#ff6b6b;padding:2px 6px;font-size:8px;cursor:pointer;border-radius:2px;">✕</button>'
        +'</div>';
    }
  });
  
  listEl.innerHTML=html;
}

function removeDocumentFromReport(docKey){
  const idx=jobsAttachedDocs.indexOf(docKey);
  if(idx>-1){
    jobsAttachedDocs.splice(idx,1);
    updateJobsAttachedList();
  }
}

