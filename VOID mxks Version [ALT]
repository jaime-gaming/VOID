function miniGameResult(success, reward=5, penalty=4){
  miniGameStats.played++;
  if(success){
    miniGameStats.won++;
    miniGameStats.streak++;
    if(miniGameState.currentMission && miniGameState.completedMissions[miniGameState.currentMission]===false){
      miniGameState.completedMissions[miniGameState.currentMission]=true;
      showGameNotification(`Objective progress: ${getCompletedMiniMissionCount()}/5`, '#9fdc7f');
    }
    ecoPressureLevel=Math.max(0, ecoPressureLevel-reward);
    updateMentalSync(2,'mini-win');
    registerEcoInteraction('mini-win',1);
    showGameNotification('Mission completed: ECO pressure reduced', '#74cc4f');
  }else{
    miniGameStats.lost++;
    miniGameStats.streak=0;
    ecoPressureLevel=Math.min(100, ecoPressureLevel+penalty);
    maybeTriggerJumpscare(0.35,'mini-fail');
    showGameNotification('Mission failed: ECO pressure increased', '#ff6666');
  }
  updateEcoWidget();
  const mentalSync=document.getElementById('ecoMentalSyncValue');
  if(mentalSync) mentalSync.textContent=`${mentalSyncLevel}`;
  if(success && getCompletedMiniMissionCount()>=5 && !miniGameState.ecoSessionTerminated){
    setTimeout(()=>forceEcoSessionTermination(),650);
  }
}

function normalizeMiniInput(value){
  return String(value||'').toLowerCase().trim().replace(/\s+/g,'').replace(/[._-]/g,'');
}

function parseMiniFloor(value){
  const raw=String(value||'').trim();
  const match=raw.match(/-?\d+/);
  if(!match) return null;
  return Number(match[0]);
}

