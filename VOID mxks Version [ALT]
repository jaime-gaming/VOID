// Pad sintético de respaldo para música (acorde menor oscuro, sin estática)
function playSynthMusic(kind, targetVol=0.18){
  try{
    const ctx = window.__voidAudioCtx || new (window.AudioContext || window.webkitAudioContext)();
    window.__voidAudioCtx = ctx;
    const now = ctx.currentTime;

    const voices = [
      { freq: 55, type: 'sine', detune: 0 },      // A1
      { freq: 65.41, type: 'triangle', detune: -8 }, // C2 (menor)
      { freq: 82.41, type: 'sawtooth', detune: 6 },  // E2
    ];

    const lfo = ctx.createOscillator();
    const lfoGain = ctx.createGain();
    lfo.type = 'sine';
    lfo.frequency.value = 0.28;
    lfoGain.gain.value = 3;
    lfo.connect(lfoGain);

    const filter = ctx.createBiquadFilter();
    filter.type = 'lowpass';
    filter.frequency.value = 1800;

    const gain = ctx.createGain();
    gain.gain.setValueAtTime(0.0001, now);
    gain.gain.exponentialRampToValueAtTime(targetVol, now + 1.5);
    gain.gain.exponentialRampToValueAtTime(0.0001, now + 14);

    voices.forEach(v => {
      const o = ctx.createOscillator();
      o.type = v.type;
      o.frequency.value = v.freq;
      o.detune.value = v.detune;
      lfoGain.connect(o.frequency);
      o.connect(filter);
      o.start(now);
      o.stop(now + 14.5);
    });

    filter.connect(gain);
    gain.connect(ctx.destination);

    lfo.start(now);
    lfo.stop(now + 14.5);
  }catch(err){
    console.log('Synth music fallback failed', err);
  }
}

