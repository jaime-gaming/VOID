<!-- BLOQUEO GLOBAL DE IMPRESION -->
<script>
  // Deshabilitar window.print inmediatamente
  window.print = function() { return false; };
  
  // Bloquear eventos de impresión
  window.addEventListener('beforeprint', (e) => { 
    e.preventDefault();
    e.stopPropagation();
  }, true);
  
  window.addEventListener('afterprint', (e) => { 
    e.preventDefault();
    e.stopPropagation();
  }, true);
  
  // Bloquear Ctrl+P y Ctrl+S a nivel global
  document.addEventListener('keydown', (e) => {
    if((e.ctrlKey || e.metaKey) && (e.key === 'p' || e.key === 'P' || e.key === 's' || e.key === 'S')) {
      e.preventDefault();
      e.stopPropagation();
      e.stopImmediatePropagation();
      return false;
    }
  }, true);
</script>

