#officeChair{position:absolute;left:52%;top:58%;width:120px;height:80px;background:linear-gradient(135deg, #3a3a4a 0%, #2a2a3a 100%);border:2px solid #4a4a5a;border-radius:10px;transform:translateX(-50%) translateZ(40px) rotateX(8deg);box-shadow:0 20px 50px rgba(0,0,0,0.95), 0 0 20px rgba(100,120,150,0.2);z-index:9;pointer-events:none;animation:chairFloat 5s ease-in-out infinite;transform-style:preserve-3d;}
