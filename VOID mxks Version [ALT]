  box.innerHTML=`<div style="font-weight:bold;margin-bottom:8px;">Contraseña de ${label}</div><input id="pwdInput" type="password" style="width:100%;padding:8px;background:#222;border:1px solid #444;color:#c0c0c0;"/><div style="display:flex;gap:8px;margin-top:12px;"><button id="pwdOk" style="flex:1;padding:8px;background:#2a4a5a;border:1px solid #4a8a8a;color:#c0c0c0;cursor:pointer;">Confirmar</button><button id="pwdCancel" style="flex:1;padding:8px;background:#5a2a2a;border:1px solid #8a4a4a;color:#ff5555;cursor:pointer;">Cancelar</button></div>`;
  overlay.appendChild(box);
