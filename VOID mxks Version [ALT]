  // Export all translations to JSON file
  exportToJSON() {
    const translations = {
      fileContents: {},
      npcs: {},
      mailInbox: [],
      metadata: {
        exportDate: new Date().toISOString(),
        version: '1.0',
        sourceLanguage: 'es',
        targetLanguage: 'en',
        totalItems: 0
      }
    };
    
    // Export fileContents
    if (typeof fileContents !== 'undefined') {
      for (const key in fileContents) {
        const file = fileContents[key];
        translations.fileContents[key] = {
          title: file.title || '',
          body: file.body || '',
          content: file.content || ''
        };
      }
      translations.metadata.totalItems += Object.keys(fileContents).length;
    }
    
    // Export NPCs
    if (typeof npcs !== 'undefined') {
      for (const npcKey in npcs) {
        const npc = npcs[npcKey];
        translations.npcs[npcKey] = {
          name: npc.name || '',
          role: npc.role || '',
          dialogue: npc.dialogue ? JSON.parse(JSON.stringify(npc.dialogue)) : []
        };
      }
      translations.metadata.totalItems += Object.keys(npcs).length;
    }
    
    // Export mails
    if (typeof mailInbox !== 'undefined') {
      translations.mailInbox = JSON.parse(JSON.stringify(mailInbox));
      translations.metadata.totalItems += mailInbox.length;
    }
    
    // Create and download JSON file
    const jsonString = JSON.stringify(translations, null, 2);
    const blob = new Blob([jsonString], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'void-translations-en.json';
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
    
    console.log('[AutoTranslator] Translations exported to JSON');
    alert(`✅ Translations exported!\n\n${translations.metadata.totalItems} items saved to void-translations-en.json\n\nPlace this file in the same folder as the HTML and reload the page.`);
  },
  
  // Load translations from JSON file
  async loadFromJSON() {
    try {
      // Try to fetch the JSON file from the same directory
      const response = await fetch('void-translations-en.json', { cache: 'no-store' });
      if (!response.ok) {
        throw new Error('JSON file not found');
      }
      
      const translations = await response.json();
      console.log('[AutoTranslator] Loading translations from JSON...');
      
      // Apply fileContents
      if (translations.fileContents && typeof fileContents !== 'undefined') {
        for (const key in translations.fileContents) {
          if (fileContents[key]) {
            const trans = translations.fileContents[key];
            if (trans.title) fileContents[key].title = trans.title;
            if (trans.body) fileContents[key].body = trans.body;
            if (trans.content) fileContents[key].content = trans.content;
          }
        }
      }
      
      // Apply NPCs
      if (translations.npcs && typeof npcs !== 'undefined') {
        for (const npcKey in translations.npcs) {
          if (npcs[npcKey]) {
