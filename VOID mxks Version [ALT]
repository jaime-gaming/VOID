function decryptWithPassword() {
  const passwordInput = document.getElementById('decryptorPassword').value;
  const outputDiv = document.getElementById('decryptorOutput');
  
  if(!passwordInput) {
    outputDiv.textContent = '[ERROR] Debes ingresar una contraseña';
    return;
  }
  
  // Verificar contraseña correcta
  if(passwordInput !== currentEncryptedFile.password) {
    outputDiv.textContent = '[ERROR] Contraseña incorrecta\n\n[SYSTEM] Acceso denegado\n\nVerifica la contraseña e intenta nuevamente.';
    return;
  }
  
  // Iniciar desencriptación (20-40 segundos)
  startDecryption(outputDiv);
}

function startDecryption(outputDiv) {
  const baseTime = 20000; // 20 segundos
  const extraTime = Math.min(currentEncryptedFile.name.length * 12, 20000); // Hasta 20 segundos extra
  const decryptTime = baseTime + extraTime;
  const steps = 120;
  let currentStep = 0;
  
  outputDiv.textContent = '[INICIANDO SISTEMA DE DESCIFRADO...]\n';
  
  const interval = setInterval(() => {
    currentStep++;
    const progress = Math.floor((currentStep / steps) * 100);
    
    let statusMsg = `[DESCIFRADO EN PROGRESO: ${progress}%]\n`;
    statusMsg += `Analizando bloques: ${currentStep}/${steps}\n`;
    statusMsg += `Bytes procesados: ${Math.floor((currentEncryptedFile.name.length * currentStep) / steps)}/${currentEncryptedFile.name.length}\n\n`;
    
    // Mensajes de progreso
    if(currentStep === 1) {
      statusMsg += '[INIT] Cargando módulos de criptoanálisis...\n';
    } else if(currentStep === Math.floor(steps * 0.1)) {
      statusMsg += '[OK] Módulos cargados\n[PROCESS] Detectando algoritmo de encriptación...\n';
    } else if(currentStep === Math.floor(steps * 0.2)) {
      statusMsg += '[OK] AES-256-CBC detectado\n[PROCESS] Buscando vector de inicialización...\n';
    } else if(currentStep === Math.floor(steps * 0.3)) {
      statusMsg += '[OK] IV encontrado\n[PROCESS] Extrayendo metadata...\n';
    } else if(currentStep === Math.floor(steps * 0.4)) {
      statusMsg += '[OK] Metadata extraída\n[PROCESS] Generando claves candidatas...\n';
    } else if(currentStep === Math.floor(steps * 0.5)) {
      statusMsg += '[WARN] Clave no encontrada en diccionario\n[PROCESS] Intentando ataque de canal lateral...\n';
    } else if(currentStep === Math.floor(steps * 0.6)) {
      statusMsg += '[OK] Clave maestra parcial recuperada\n[PROCESS] Reconstruyendo clave...\n';
    } else if(currentStep === Math.floor(steps * 0.7)) {
      statusMsg += '[OK] Clave completa: 256 bits\n[PROCESS] Descifrando bloques...\n';
    } else if(currentStep === Math.floor(steps * 0.8)) {
      statusMsg += '[WARN] Aplicando corrección ECC...\n[PROCESS] Reconstruyendo datos...\n';
    } else if(currentStep === Math.floor(steps * 0.9)) {
      statusMsg += '[OK] Datos recuperados\n[PROCESS] Validando integridad HMAC...\n';
    } else if(currentStep === Math.floor(steps * 0.95)) {
      statusMsg += '[OK] HMAC validado\n[PROCESS] Descomprimiendo contenido...\n';
    }
    
    // Barra de progreso
    const barLength = 40;
    const filled = Math.floor((progress / 100) * barLength);
    const bar = '█'.repeat(filled) + '░'.repeat(barLength - filled);
    statusMsg += `\n[│${bar}│] ${progress}%\n`;
    statusMsg += `\nTiempo: ${((currentStep * decryptTime) / steps / 1000).toFixed(1)}s`;
    
    outputDiv.textContent = statusMsg;
    outputDiv.scrollTop = outputDiv.scrollHeight;
    
    if(currentStep >= steps) {
      clearInterval(interval);
      completeDecryption(outputDiv);
    }
  }, decryptTime / steps);
}

function completeDecryption(outputDiv) {
  const fileKey = currentEncryptedFile.key;
  const file = files.find(f => f.key === fileKey);
  
  if(!file || !fileContents[fileKey]) {
    outputDiv.textContent = '[✓ DESCIFRADO COMPLETO]\n\n[ERROR] No se pudo recuperar el contenido original.';
    return;
  }
  
  const decryptedContent = fileContents[fileKey].body;
  
  // Mostrar salida desencriptada
  outputDiv.textContent = `[✓ DESCIFRADO COMPLETO]\n\n` +
                          `========================================\n` +
                          `Archivo: ${file.name}\n` +
                          `Tamaño: ${decryptedContent.length} bytes\n` +
                          `Algoritmo: AES-256-CBC\n` +
                          `Integridad: ${Math.floor(Math.random() * 15 + 85)}%\n` +
                          `========================================\n\n` +
                          `[CONTENIDO DESCIFRADO]\n\n` +
                          decryptedContent;
  
  outputDiv.scrollTop = outputDiv.scrollHeight;
  
  // Marcar como desencriptado
  file.decrypted = true;
  file.encrypted = false;
  
  // Mostrar en visor
  document.getElementById('decryptorViewerContent').textContent = decryptedContent;
  
  print(`[✓ ARCHIVO DESENCRIPTADO] ${file.name}`);
}

