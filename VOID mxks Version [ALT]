function initiateCall(npcKey){
  const npc=npcs[npcKey];
  if(!npc)return;
  
  // TRACKING PARA NG+: Registrar NPC llamado
  if(!playthroughTracking.npcsCalled.includes(npcKey)){
    playthroughTracking.npcsCalled.push(npcKey);
  }
  
  // Prevenir llamadas duplicadas - cerrar cualquier ventana de llamada existente
  const existingCallingWin=document.getElementById(`calling_${npcKey}`);
  const existingCallWin=document.getElementById(`call_${npcKey}`);
  if(existingCallingWin) closeWindow(`calling_${npcKey}`);
  if(existingCallWin) closeWindow(`call_${npcKey}`);
  
  npc.lastCall=new Date();
  
  // Crear ventana de "Llamando..."
  const callingWin=document.createElement('div');
  callingWin.className='window';
  callingWin.id=`calling_${npcKey}`;
  callingWin.style.top='140px';
  callingWin.style.left='220px';
  callingWin.style.width='420px';
  callingWin.style.height='320px';
  
  let callingTimer=10;
  callingWin.innerHTML=`
    <div class="titlebar" style="background:#1a2a3a;">${npc.name} - ${npc.role}</div>
    <div class="content" style="display:flex;flex-direction:column;justify-content:center;align-items:center;gap:20px;padding:40px;">
      <div style="font-size:16px;font-weight:bold;color:#7ab1ff;">LLAMANDO...</div>
      <div style="font-size:48px;animation:blink 1s infinite;">📞</div>
      <div style="font-size:18px;font-weight:bold;color:#51cf66;text-align:center;min-height:30px;" id="callTimer_${npcKey}">${callingTimer}s</div>
    </div>
  `;
  
  desktop.appendChild(callingWin);
  makeDraggable(callingWin);
  bringToFront(callingWin.id);
  openWindow(callingWin.id);
  
  // Contar hacia atrás
  const timerInterval=setInterval(()=>{
    callingTimer--;
    const timerEl=document.getElementById(`callTimer_${npcKey}`);
    if(timerEl){
      timerEl.textContent=callingTimer+'s';
      timerEl.style.color=(callingTimer<=3)?'#ff5555':'#51cf66';
    }
    
    if(callingTimer<=0){
      clearInterval(timerInterval);
      closeWindow(`calling_${npcKey}`);
      
      // Mostrar ventana de diálogo
      const dialogWin=document.createElement('div');
      dialogWin.className='window';
      dialogWin.id=`call_${npcKey}`;
      dialogWin.style.top='140px';
      dialogWin.style.left='220px';
      dialogWin.style.width='420px';
      dialogWin.style.height='320px';
      
      const currentDialogue=npc.dialogue[npc.currentLine%npc.dialogue.length];
      const npcLine=currentDialogue.npc;
      const options=currentDialogue.options;
      
      let optionsHTML=`<div style="display:flex;flex-direction:column;gap:6px;padding:8px;border-top:1px solid #222;">`;
      options.forEach((opt,i)=>{
        const optText=typeof opt==='string'?opt:opt.text;
        const safeOpt=optText.replace(/"/g,'&quot;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
        optionsHTML+=`<button data-npc="${npcKey}" data-idx="${i}" class="callOptionBtn" style="padding:8px;background:#1a2a3a;border:1px solid #2a4a6a;color:var(--text);cursor:pointer;font-size:11px;text-align:left;">${safeOpt}</button>`;
      });
      optionsHTML+=`</div>`;
      
      dialogWin.innerHTML=`<div class="titlebar" style="background:#1a2a3a;">${npc.name} - ${npc.role} <span class="close" onclick="closeWindow('call_${npcKey}')" style="color:var(--alert);">X</span></div><div class="content" style="display:flex;flex-direction:column;justify-content:space-between;padding:0;overflow:hidden;"><div style="padding:12px;color:#7ab1ff;flex:1;border-bottom:1px solid #222;overflow-y:auto;"><strong>[${npc.mood.toUpperCase()}]</strong><br/><br/>${npcLine}</div>${optionsHTML}`;
      desktop.appendChild(dialogWin);
      makeDraggable(dialogWin);
      bringToFront(dialogWin.id);
      openWindow(dialogWin.id);
      
      setTimeout(()=>{
        dialogWin.querySelectorAll('.callOptionBtn').forEach(btn=>{
          btn.addEventListener('click',()=>{
            const npcKey=btn.dataset.npc;
            const idx=parseInt(btn.dataset.idx);
            respondCall(npcKey, idx);
          });
        });
      },0);
      
      // Registrar llamada para misión
      updateMissionProgress('call_npcs');
    }
  }, 1000);
}

