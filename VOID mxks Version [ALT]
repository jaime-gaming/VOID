function ambientEvents(){
  if(!desktopActive)return;
  const roll=Math.random();
  if(roll<0.3 && !fansMessageSent){
    // Solo una vez: mensaje de ventiladores
    playSound('sfxAlarm');
    receiveMail('unknown@null','(sin asunto)','Escucha los ventiladores. Te están diciendo tu nombre.');
    fansMessageSent=true;
  }else{
    if(Math.random()<getAmbientInterferenceChance()){
      triggerMemoryInterference();
    }else if(Math.random()<getFearEventChance()){
      triggerEnvironmentalFearEvent();
    }else if(Math.random()<0.32){
      playSound('sfxGlitch');
      document.body.classList.add('session-glitch');
      setTimeout(()=>document.body.classList.remove('session-glitch'),500);
    }
  }
}

// Eventos de correos basados en tiempo VOID
let timedMailsSent=new Set();
function checkTimedMails(){
  if(!desktopActive || gameEnded) return;
  
  // En 01:30 - Singh reporta anomalía de audio
  if(voidTime.hours===1 && voidTime.minutes===30 && !timedMailsSent.has('singh_130')){
    receiveMail('rsingh@void','REPORTE: Anomalía en pasillo E','Acabo de escuchar algo en pasillo E. Son voces. O una sola voz repitiéndose.',
      [{name:'audio_anomaly_log.txt',key:'audioAnomalyLog'}]);
    timedMailsSent.add('singh_130');
  }
  
  // En 02:00 - Vega envía nota sobre experimento
  if(voidTime.hours===2 && voidTime.minutes===0 && !timedMailsSent.has('vega_200')){
    receiveMail('lvega@void','URGENTE: Discrepancias en logs','Los experimentos tienen timestamps que no concuerdan.\n\nAlguno de estos archivos tiene fecha... del futuro.',
      [{name:'experiment_048.log',key:'experimentoECO048'}]);
    timedMailsSent.add('vega_200');
  }
  
  // En 02:45 - Sistema detecta acceso no autorizado
  if(voidTime.hours===2 && voidTime.minutes===45 && !timedMailsSent.has('system_245')){
    receiveMail('system@void','ALERTA CRÍTICA: Acceso no autorizado','Se detectó lectura de archivos clasificados desde tu terminal.\n\nEl sistema está registrando todo.',
      [{name:'access_log.sys',key:'accessLog'}]);
