function startJobsTimer(){
  if(jobsTimerActive) return;
  jobsTimerActive=true;
  jobsLastReportTime=voidTime.totalSeconds; // Inicializar el último reporte al tiempo actual
  jobsLastCorrectiveToneAt=-9999;
  updateJobsTimer();
}

function updateJobsTimer(){
  const statusEl=document.getElementById('jobsStatus');
  if(!statusEl){
    setTimeout(updateJobsTimer, 1000);
    return;
  }
  
  // Prevenir enviar más de 5 reportes
  if(jobsReportsCompleted>=5){
    alert('❌ SISTEMA CERRADO\n\nYa has completado los 5 reportes requeridos.\n\nEl sistema de reportes ha sido desactivado.');
    return;
  }
  
  const now=voidTime.totalSeconds;
  const timeSinceStart=jobsLastReportTime===null?now:(now-jobsLastReportTime);
  const timeLeft=JOBS_REPORT_MAX_DELAY-timeSinceStart;
  jobsCanSubmit=true;

  if(timeLeft<=0){
    statusEl.innerHTML='<strong style="color:#ff4444;">⚠ REPORT OVERDUE // TERMINATION PENDING</strong>';
    if(!gameEnded){
      playSound('sfxAlarm');
      triggerFiredEnding();
      return;
    }
  }else{
    const mins=Math.floor(timeLeft/60);
    const secs=Math.floor(timeLeft%60);
    const urgency=timeLeft<=120?'#ff4444':timeLeft<=300?'#ff8844':'#9fdc9f';
    statusEl.innerHTML='<strong style="color:' + urgency + ';">REPORT WINDOW: ' + mins + ':' + secs.toString().padStart(2,'0') + ' remaining</strong>';

    if(timeLeft<=120 && (now-jobsLastCorrectiveToneAt)>=60){
      jobsLastCorrectiveToneAt=now;
      playSound('sfxAlarm');
      showGameNotification('Corrective tone: report cadence falling behind.', '#ffb0b0');
    }
  }
  
  setTimeout(updateJobsTimer, 1000);
}

function submitJobReport(){
  const now=voidTime.totalSeconds;
  const verifyInput=document.getElementById('jobsVerifyInput');
  const reportContent=document.getElementById('jobsReportContent');
  
  if(!verifyInput || !reportContent) return;
  
  const userText=verifyInput.value.trim();
  const reportText=reportContent.value.trim();
  
  // Verificar que hay contenido en el reporte
  if(reportText.length===0){
    playSound('sfxGlitch');
    alert('❌ El reporte no puede estar vacío.');
    return;
  }
  
  // Verificar que se hayan adjuntado documentos (después del segundo reporte)
  if(jobsReportsCompleted>=2 && jobsAttachedDocs.length===0){
    playSound('sfxGlitch');
    alert('❌ Debes adjuntar al menos 1 documento del correo para este reporte.');
    return;
  }
  
  const timeSinceLastReport=jobsLastReportTime===null?now:(now-jobsLastReportTime);
  
  // Verificar que no pasaron más de 10 minutos
  if(timeSinceLastReport>=JOBS_REPORT_MAX_DELAY){
    playSound('sfxGlitch');
    alert('❌ DEMASIADO TARDE\n\nPasaron más de 20 minutos.\n\nSe activará el protocolo de despido...');
    triggerFiredEnding();
    return;
  }
  
  // Verificar que la frase es correcta (sin importar mayúsculas)
  if(userText.toUpperCase()!==jobsCurrentPhrase.toUpperCase()){
    playSound('sfxGlitch');
    alert('❌ Verificación fallida.\n\nEscriba exactamente: '+jobsCurrentPhrase);
    verifyInput.value='';
    verifyInput.focus();
    return;
  }
  
  // ÉXITO - procesar reporte
  jobsLastReportTime=now;
  jobsReportsCompleted++;
  jobsNextReportDue=now+JOBS_REPORT_INTERVAL;
  
  // Generar nueva frase
  const phrases=[
    'STABLE LEVEL',
    'ACTIVE MONITORING',
    'ANOMALY DENIED',
    'NORMAL SYSTEM',
    'EVERYTHING UNDER CONTROL',
