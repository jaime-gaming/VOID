function changeFloor(direction){
  const floors=['office','floor1','floor2','floor3','basement'];
  const currentIndex=floors.indexOf(currentFloor);
  let newIndex=currentIndex;
  
  if(direction==='next'&&currentIndex<floors.length-1) newIndex=currentIndex+1;
  if(direction==='prev'&&currentIndex>0) newIndex=currentIndex-1;
  
  if(newIndex===currentIndex) return;  
  
  const nextFloor=floors[newIndex];
  const floorData=floorNotes[nextFloor];
  
  if(floorData.locked && floorData.locked_with!=='NONE' && !window.godModeActive){
    alert(`⚠️ ${floorData.name} [LOCKED]\n${floorData.hint}`);
    return;
  } else if(window.godModeActive && floorData.locked){
    floorData.locked=false;
  }
  
  // SAVE content before changing
  if(currentFloor==='office'){
    const contentEl=document.getElementById('officePapersContent');
    if(contentEl){
      let content=contentEl.textContent;
      if(!content || content.trim().length===0){
        content=contentEl.innerHTML;
      }
      floorNotes[currentFloor].content=content;
    }
  }
  
  // Show full elevator animation
  showElevatorAnimation(currentFloor, nextFloor, ()=>{
    currentFloor=nextFloor;
    switchToFloor(nextFloor);
  });
}

