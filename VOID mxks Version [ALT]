function setupFingerprintScanner(){
  const scanner=document.getElementById('loginFingerprint');
  const statusLabel=document.getElementById('fingerprintStatus');
  if(!scanner) return;

  const resetLabel=()=>{
    if(fingerprintVerified){
      scanner.classList.add('ok');
      scanner.classList.remove('fail');
      if(statusLabel){
        statusLabel.textContent='✓ FINGERPRINT VERIFIED';
        statusLabel.classList.add('ok');
        statusLabel.classList.remove('fail');
      }
    }else{
      scanner.classList.remove('ok','fail');
      if(statusLabel){
        statusLabel.textContent='HOLD ICON 3s FOR FINGERPRINT';
        statusLabel.classList.remove('ok','fail');
      }
    }
  };

  const clearTimer=()=>{
    if(fingerprintHoverTimer){
      clearInterval(fingerprintHoverTimer);
      fingerprintHoverTimer=null;
    }
  };

  scanner.onmousedown=(event)=>{
    if(event.button!==0) return;
    if(fingerprintVerified) return;
    clearTimer();
    let elapsed=0;
    scanner.classList.remove('fail');
    if(statusLabel){
      statusLabel.textContent='Scanning... 0%';
      statusLabel.classList.remove('ok','fail');
    }
    fingerprintHoverTimer=setInterval(()=>{
      elapsed+=100;
      const pct=Math.min(100, Math.floor((elapsed/3000)*100));
      if(statusLabel) statusLabel.textContent=`Scanning... ${pct}%`;
      if(elapsed>=3000){
        clearTimer();
        const failed=Math.random()<0.35;
        if(failed){
          fingerprintVerified=false;
          scanner.classList.remove('ok');
          scanner.classList.add('fail');
          if(statusLabel){
            statusLabel.textContent='✗ SCAN FAILED - PRESS FIRMER / WARM GLASS';
            statusLabel.classList.add('fail');
            statusLabel.classList.remove('ok');
          }
          playSound('sfxGlitch');
        }else{
          fingerprintVerified=true;
          scanner.classList.add('ok');
          scanner.classList.remove('fail');
          if(statusLabel){
            statusLabel.textContent='✓ FINGERPRINT VERIFIED';
            statusLabel.classList.add('ok');
            statusLabel.classList.remove('fail');
          }
          playSound('sfxClick');
        }
      }
    },100);
  };

  scanner.onmouseup=()=>{
    clearTimer();
    resetLabel();
  };

  scanner.onmouseleave=()=>{
    clearTimer();
    resetLabel();
  };

  resetLabel();
}

setTimeout(setupFingerprintScanner, 0);

