function stopMiniCinematicBuzz(){
  if(!miniCinematicBuzzNodes) return;
  try{
    const ctx=miniCinematicBuzzNodes.ctx;
    const now=ctx.currentTime;
    miniCinematicBuzzNodes.master.gain.cancelScheduledValues(now);
    miniCinematicBuzzNodes.master.gain.setTargetAtTime(0.0001, now, 0.09);
    miniCinematicBuzzNodes.oscLow.stop(now+0.22);
    miniCinematicBuzzNodes.oscHigh.stop(now+0.22);
    miniCinematicBuzzNodes.lfo.stop(now+0.22);
  }catch(e){}
  miniCinematicBuzzNodes=null;
}

function startMiniCinematicBuzz(hourIntensity){
  stopMiniCinematicBuzz();
  try{
    const ctx=window.__voidAudioCtx || new (window.AudioContext || window.webkitAudioContext)();
    window.__voidAudioCtx=ctx;
    if(ctx.state==='suspended') ctx.resume().catch(()=>{});

    const now=ctx.currentTime;
    const master=ctx.createGain();
    const lowPass=ctx.createBiquadFilter();
    const notch=ctx.createBiquadFilter();
    const oscLow=ctx.createOscillator();
    const oscHigh=ctx.createOscillator();
    const lfo=ctx.createOscillator();
    const lfoGain=ctx.createGain();

    master.gain.setValueAtTime(0.0001, now);
    master.gain.exponentialRampToValueAtTime(0.022 + hourIntensity*0.04, now+0.25);

    lowPass.type='lowpass';
    lowPass.frequency.setValueAtTime(240 + hourIntensity*420, now);
    notch.type='notch';
    notch.frequency.setValueAtTime(120 + hourIntensity*140, now);
    notch.Q.value=5;

    oscLow.type='sawtooth';
    oscHigh.type='triangle';
    oscLow.frequency.setValueAtTime(43 + hourIntensity*18, now);
    oscHigh.frequency.setValueAtTime(82 + hourIntensity*26, now);

    lfo.type='sine';
    lfo.frequency.setValueAtTime(0.28 + hourIntensity*0.6, now);
    lfoGain.gain.setValueAtTime(4 + hourIntensity*8, now);

    lfo.connect(lfoGain);
    lfoGain.connect(oscLow.frequency);
    lfoGain.connect(oscHigh.frequency);

    oscLow.connect(lowPass);
    oscHigh.connect(lowPass);
    lowPass.connect(notch);
    notch.connect(master);
    master.connect(ctx.destination);

    oscLow.start(now);
    oscHigh.start(now);
    lfo.start(now);

    miniCinematicBuzzNodes={ctx,master,oscLow,oscHigh,lfo,lowPass,notch};
  }catch(e){
    miniCinematicBuzzNodes=null;
  }
}

function playChildLaughMemory(){
  try{
    const ctx=window.__voidAudioCtx || new (window.AudioContext || window.webkitAudioContext)();
    window.__voidAudioCtx=ctx;
    const now=ctx.currentTime;

    const gain=ctx.createGain();
    gain.connect(ctx.destination);
    gain.gain.setValueAtTime(0.0001, now);
    gain.gain.exponentialRampToValueAtTime(0.14, now+0.06);
    gain.gain.exponentialRampToValueAtTime(0.0001, now+1.5);

    const osc=ctx.createOscillator();
    osc.type='triangle';
    osc.frequency.setValueAtTime(680, now);
    osc.frequency.setTargetAtTime(520, now+0.2, 0.28);
    osc.frequency.setValueAtTime(740, now+0.72);
    osc.frequency.setTargetAtTime(420, now+0.78, 0.35);

    const lfo=ctx.createOscillator();
    const lfoGain=ctx.createGain();
