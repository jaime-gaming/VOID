function screenshotFullscreenCamera(videoId){
  const video=document.querySelector(`#fullscreen_${videoId} video`);
  if(!video) return;
  
  const canvas=document.createElement('canvas');
  canvas.width=video.videoWidth||video.width;
  canvas.height=video.videoHeight||video.height;
  const ctx=canvas.getContext('2d');
  
  if(ctx){
    ctx.drawImage(video, 0, 0);
    const imgData=canvas.toDataURL('image/png');
    const link=document.createElement('a');
    link.href=imgData;
    link.download=`camera_${videoId}_${Date.now()}.png`;
    link.click();
    
    showGameNotification('📸 CAPTURA GUARDADA','#4a9eff');
    
    // Registrar para M11 si es aplicable
    updateMissionProgress('photo_evidence');
  }
}

