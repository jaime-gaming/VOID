function receiveMail(from,subject,body,attachments=[]){
  playSound('sfxAlarm');
  if(/eco|\?\?\?|system_oracle/i.test(String(from))){
    registerEcoInteraction(`mail:${from}`,2);
  }
  const mail=applyMindFilterToMail({from,subject,body,attachments});
  const inboxEntry={
    from:mail.from,
    subject:mail.subject,
    body:mail.body,
    unread:true,
    ts:formatVoidTimeShort(),
    attachments:mail.attachments
  };

  const finalizeMailInsert=()=>{
    mailInbox.push(inboxEntry);
    renderMail();
    if(/eco|\?\?\?/i.test(String(from))){
      maybeTriggerJumpscare(0.22,'mail-event');
    }
  };

  if(window.forceLanguage==='en' && window.AutoTranslator){
    AutoTranslator.translateMailEntryInPlace(inboxEntry)
      .catch(()=>{})
      .finally(finalizeMailInsert);
    return;
  }

  finalizeMailInsert();
}

function updateMentalSync(amount, reason){
  const prev=mentalSyncLevel;
  mentalSyncLevel=Math.max(0, Math.min(100, mentalSyncLevel+amount));
  if(prev===mentalSyncLevel) return;

  if(mentalSyncLevel>=30 && mentalSyncStage<1){
    mentalSyncStage=1;
    receiveMail('eco@system','[RESONANCIA]','Señal detectada. Tu ritmo mental se alinea con ECO.');
  }
  if(mentalSyncLevel>=60 && mentalSyncStage<2){
    mentalSyncStage=2;
    receiveMail('eco@system','[ECO // SINCRONIA]','No pienses en voz alta. ECO ya escucha la parte silenciosa.');
  }
  if(mentalSyncLevel>=85 && mentalSyncStage<3){
    mentalSyncStage=3;
    mentalEchoActive=true;
    receiveMail('eco@system','[ECO // UMBRAL]','La frontera es porosa. Algunas respuestas llegarán antes de tus preguntas.');
  }
}

function applyMindFilterToMail(mail){
  if(mentalSyncLevel<40){
    return mail;
  }
  const echoLine=mentalSyncLevel>=80
    ? '\n\n[ECO] Ya estas sincronizado. No necesitas repetir la pregunta.'
    : '\n\n[ECO] Tu mente resuena en el sistema.';
  return {
    from:mail.from,
    subject:mentalSyncLevel>=80 ? '[ECO] '+mail.subject : mail.subject,
    body:mail.body + echoLine,
    attachments:mail.attachments
  };
}

function renderMail(){
  const container=document.getElementById('mailContent');
  const unread=mailInbox.filter(m=>m.unread).length;
  const badge=unread?`(${unread})`:'';
  document.querySelector('#mailWindow .titlebar').innerHTML=`Mail ${badge} <span class="close" onclick="closeWindow('mailWindow')">X</span>`;
  if(!mailInbox.length){container.innerHTML='<div style="padding:8px;color:#666;font-size:10px;">Sin mensajes</div>';return;}
  
  let html='';
  mailInbox.forEach((m,idx)=>{
    const unreadClass=m.unread?' unread':'';
    html+=`<div class="mail-item${unreadClass}" onclick="showMail(${idx});">`;
    html+=`<span class="mail-time">${m.ts}</span>`;
    html+=`<div class="mail-from">${m.from}</div>`;
    html+=`<div class="mail-subject">${m.subject.substring(0,35)}${m.subject.length>35?'...':''}</div>`;
    html+=`</div>`;
  });
  
  container.innerHTML=html;
}

function showMail(idx){
  const mail=mailInbox[idx];
  if(!mail)return;
  
  // Marcar como leído y actualizar lista
  if(mail.unread){
    mail.unread=false;
    renderMail();
  }
  
  // Crear ventana única para este correo
  const winId=`mail_${idx}_${Date.now()}`;
  const win=document.createElement('div');
  win.id=winId;
  win.className='window mail-msg-window';
  win.style.display='block';
  win.style.left='50px';
  win.style.top='50px';
  win.style.zIndex=1000+idx;
  
  let html=`<div class="titlebar">${mail.subject} <span class="close" onclick="this.closest('.window').remove()">X</span></div>`;
  html+=`<div class="content">`;
  html+=`<div class="mail-header">`;
  html+=`<div class="mail-from-line"><strong>De:</strong> ${mail.from}</div>`;
  html+=`<div class="mail-from-line"><strong>Fecha:</strong> ${mail.ts}</div>`;
  html+=`<div class="mail-subject-line">${mail.subject}</div>`;
  html+=`</div>`;
  html+=`<div class="mail-body">${mail.body}</div>`;
  
  // Mostrar attachments si existen
  if(mail.attachments && mail.attachments.length>0){
    html+=`<div class="mail-attachments" style="margin-top:10px;border-top:1px solid #2a2a2a;padding-top:8px;">`;
    html+=`<div style="font-weight:bold;font-size:9px;color:#6f6;margin-bottom:4px;">📎 ADJUNTOS:</div>`;
    mail.attachments.forEach(att=>{
      html+=`<div style="padding:4px;background:#0a0a0a;border:1px solid #1a1a1a;margin:2px 0;cursor:pointer;color:#6f6;" onclick="openFileFromMail('${att.key}')">${att.name}</div>`;
    });
    html+=`</div>`;
  }
  
  if(mail.respondable && mail.responses){
    html+=`<div class="mail-responses">`;
    mail.responses.forEach((resp,i)=>{
      html+=`<button onclick="respondMail(${idx},${i});this.closest('.window').remove();">${resp.text}</button>`;
    });
    html+=`</div>`;
  }
  
  html+=`</div>`;
  win.innerHTML=html;
  
  document.body.appendChild(win);
  makeDraggable(win);
  
  // Ajustar si se sale de la pantalla
  setTimeout(()=>{
    const rect=win.getBoundingClientRect();
    if(rect.right>window.innerWidth)win.style.left=(window.innerWidth-rect.width-20)+'px';
    if(rect.bottom>window.innerHeight)win.style.top=(window.innerHeight-rect.height-20)+'px';
    if(rect.left<0)win.style.left='10px';
    if(rect.top<0)win.style.top='10px';
  },10);
}

function openFileFromMail(fileKey){
  const file=files.find(f=>f.key===fileKey);
  if(!file){
    alert('Archivo no encontrado');
    return;
  }
  
  // Descargar archivo a la carpeta Downloads
  const downloadInfo={key:fileKey,name:file.name,title:file.name,timestamp:formatVoidTime()};
  
  // Evitar duplicados
  if(!downloadedFiles.find(f=>f.key===fileKey)){
    downloadedFiles.push(downloadInfo);
  }
  
  // Mostrar confirmación
  playSound('sfxClick');
  const notification=document.createElement('div');
  notification.style.cssText=`
    position:fixed;bottom:80px;right:20px;background:#0a2a0a;border:2px solid #6f6;
    color:#6f6;padding:12px 16px;font-family:monospace;font-size:11px;
    z-index:9000;box-shadow:0 0 10px rgba(102,255,102,0.3);max-width:250px;
  `;
  notification.innerHTML=`
    📥 Descargado: ${file.name}<br>
    <span style="color:#999;font-size:10px;">A: Downloads/</span>
  `;
  document.body.appendChild(notification);
  setTimeout(()=>notification.remove(),3000);
}


function respondMail(mailIdx,responseIdx){
  const mail=mailInbox[mailIdx];
  if(!mail || !mail.responses || !mail.responses[responseIdx])return;
  const response=mail.responses[responseIdx];
  mail.respondable=false;
  mail.body+=`\n\n[TÚ RESPONDISTE:]\n${response.text}\n\n[RESPUESTA:]\n`;
  
  // Execute consequence
  handleMailResponse(response.effect, mail);
  
  showMail(mailIdx);
  updateTaskbar();
}

