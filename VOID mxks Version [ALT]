  win.id='usbTransferWindow';
  win.style.top='150px';
  win.style.left='250px';
  win.style.width='400px';
  win.style.height='auto';
  win.innerHTML=`<div class="titlebar">Transferencia USB <span class="close" onclick="closeWindow('usbTransferWindow')">X</span></div><div class="content" id="usbTransferContent">${html}</div>`;
  document.getElementById('officeView').appendChild(win);
  openWindow('usbTransferWindow');
  makeDraggable(win);
}

function confirmUSBTransfer(){
  const unlockedFiles=files.filter(f=>unlockedDocs.includes(f.key) && !f.userCreated);
  let transferred=0;
  unlockedFiles.forEach(f=>{
    const checkbox=document.getElementById(`usb_${f.key}`);
    if(checkbox && checkbox.checked && !usbStorage.some(u=>u.key===f.key)){
      usbStorage.push({key:f.key,name:f.name,folder:f.folder,content:fileContents[f.key]});
      transferred++;
    }
  });
  // Local download disabled; data remains in-memory
  alert(`✅ ${transferred} archivo(s) transferido(s) a USB.\n\nArchivo "usb_VOID.json" descargado.\nCárgalo en tu PC personal.`);
  closeWindow('usbTransferWindow');
}

