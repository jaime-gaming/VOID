// Desbloquea audio global al primer gesto (evita bloqueos de autoplay en todas las pistas)
let audioUnlocked = false;
function setupAudioUnlock(){
  if(audioUnlocked) return;
  const unlockHandler = () => {
    if(window.__voidAudioCtx){
      window.__voidAudioCtx.resume().catch(()=>{});
    }
    ['ambientMusic','officeMusic','loginMusic','desktopMusic','windowOpenMusic','windowCloseMusic','mailMusic','glitchMusic','callMusic'].forEach(id => {
      const a = document.getElementById(id);
      if(a){
        const targetVol = parseFloat(a.getAttribute('data-volume')) || 0.3;
        const prevVol = a.volume;
        a.muted = true;
        a.play().catch(()=>{}).finally(()=>{
          a.pause();
          a.currentTime = 0;
          a.muted = false;
          a.volume = targetVol || prevVol || 0.3;
        });
      }
    });
    audioUnlocked = true;
    document.removeEventListener('pointerdown', unlockHandler);
    document.removeEventListener('keydown', unlockHandler);
  };
  document.addEventListener('pointerdown', unlockHandler);
  document.addEventListener('keydown', unlockHandler);
}

