function playServerShutdownFirstPerson(){
  return new Promise(resolve=>{
    const overlay=document.createElement('div');
    overlay.id='ecoFirstPersonFinal';
    overlay.style.cssText='position:fixed;inset:0;z-index:250001;background:radial-gradient(circle at 50% 50%, #121212 0%, #050505 65%, #000 100%);display:flex;align-items:center;justify-content:center;font-family:monospace;color:#d8ffd8;padding:0;overflow:hidden;';
    document.body.appendChild(overlay);

    let phase=0;
    let animFrame=0;
    let keyDownHandler=null;
    let keyUpHandler=null;
    const controls={forward:false,back:false,left:false,right:false,run:false};
    const state={distance:140,lateral:0};
    const panelState={
      target:[],
      current:[0,0,0,0],
      attempts:0,
      timeLeft:18,
      solved:false,
      timer:null
    };

    const playShutdownBlackout=(done)=>{
      const blackout=document.createElement('div');
      blackout.style.cssText='position:fixed;inset:0;z-index:250005;background:#000;opacity:0;pointer-events:none;transition:opacity .55s ease;';
      document.body.appendChild(blackout);

      try{
        const ctx=window.__voidAudioCtx || new (window.AudioContext || window.webkitAudioContext)();
        window.__voidAudioCtx=ctx;
        if(ctx.state==='suspended') ctx.resume().catch(()=>{});
        const now=ctx.currentTime;

        const relay=ctx.createOscillator();
        const relayGain=ctx.createGain();
        relay.type='square';
        relay.frequency.setValueAtTime(160, now);
        relayGain.gain.setValueAtTime(0.0001, now);
        relayGain.gain.exponentialRampToValueAtTime(0.17, now+0.01);
        relayGain.gain.exponentialRampToValueAtTime(0.0001, now+0.09);
        relay.connect(relayGain);
        relayGain.connect(ctx.destination);
        relay.start(now);
        relay.stop(now+0.1);

        const whisper=ctx.createOscillator();
        const whisperGain=ctx.createGain();
        const whisperFilter=ctx.createBiquadFilter();
        whisper.type='triangle';
        whisper.frequency.setValueAtTime(620, now+0.14);
        whisper.frequency.exponentialRampToValueAtTime(210, now+0.75);
        whisperFilter.type='bandpass';
        whisperFilter.frequency.setValueAtTime(540, now+0.14);
        whisperFilter.Q.value=0.7;
        whisperGain.gain.setValueAtTime(0.0001, now+0.14);
        whisperGain.gain.exponentialRampToValueAtTime(0.04, now+0.21);
        whisperGain.gain.exponentialRampToValueAtTime(0.0001, now+0.82);
        whisper.connect(whisperFilter);
        whisperFilter.connect(whisperGain);
        whisperGain.connect(ctx.destination);
        whisper.start(now+0.14);
        whisper.stop(now+0.83);
      }catch(e){
        playSound('sfxGlitch');
      }

      requestAnimationFrame(()=>{ blackout.style.opacity='1'; });
      setTimeout(()=>{
        blackout.style.opacity='0';
        setTimeout(()=>{
          blackout.remove();
          done();
        },320);
      },760);
    };

    const clearPanelTimer=()=>{
      if(panelState.timer){
        clearInterval(panelState.timer);
        panelState.timer=null;
      }
    };

    const cleanupPhaseOne=()=>{
      if(animFrame){
        cancelAnimationFrame(animFrame);
        animFrame=0;
      }
      if(keyDownHandler) window.removeEventListener('keydown',keyDownHandler);
      if(keyUpHandler) window.removeEventListener('keyup',keyUpHandler);
      keyDownHandler=null;
      keyUpHandler=null;
      controls.forward=false;
      controls.back=false;
      controls.left=false;
      controls.right=false;
      controls.run=false;
      clearPanelTimer();
    };

    const bindMovePadButton=(btnId,key,isRun=false)=>{
      const btn=document.getElementById(btnId);
      if(!btn) return;
      const press=()=>{
        if(isRun) controls.run=true;
        else controls[key]=true;
      };
      const release=()=>{
        if(isRun) controls.run=false;
        else controls[key]=false;
      };
      btn.addEventListener('mousedown',press);
      btn.addEventListener('touchstart',press,{passive:true});
      btn.addEventListener('mouseup',release);
      btn.addEventListener('mouseleave',release);
      btn.addEventListener('touchend',release);
      btn.addEventListener('touchcancel',release);
    };

    const startPhaseOneMovement=()=>{
      const hall=document.getElementById('fpHallScene');
      const hallCore=document.getElementById('fpHallCore');
      const leftWall=document.getElementById('fpLeftWall');
      const rightWall=document.getElementById('fpRightWall');
      const floor=document.getElementById('fpFloorGrid');
      const farDoor=document.getElementById('fpFarDoor');
      const doorLeft=document.getElementById('fpDoorLeft');
      const doorRight=document.getElementById('fpDoorRight');
      const doorStatus=document.getElementById('fpDoorStatus');
      const warnA=document.getElementById('fpWarnA');
      const warnB=document.getElementById('fpWarnB');
      const hudDist=document.getElementById('fpDistance');
      const hudSide=document.getElementById('fpLateral');
      const hudHint=document.getElementById('fpMoveHint');
      const panelBtn=document.getElementById('fpPanelBtn');
      const last={t:performance.now()};

      const updateHUD=()=>{
        if(hudDist) hudDist.textContent=Math.round(state.distance)+'m';
        if(hudSide) hudSide.textContent=(state.lateral>=0?'+':'')+Math.round(state.lateral);
        if(hudHint){
          hudHint.textContent=state.distance<=0
            ?'Panel alcanzado. Presiona OPEN SHUTDOWN PANEL.'
            :'Avanza por el pasillo de servidores hasta el panel de apagado.';
        }
        if(panelBtn){
          const ready=state.distance<=0;
          panelBtn.disabled=!ready;
          panelBtn.style.opacity=ready?'1':'0.55';
          panelBtn.style.pointerEvents=ready?'auto':'none';
        }
      };

      const tick=(now)=>{
        const dt=Math.min(0.05,(now-last.t)/1000);
        last.t=now;

        const baseSpeed=controls.run?50:30;
        if(controls.forward) state.distance=Math.max(0,state.distance-baseSpeed*dt);
        if(controls.back) state.distance=Math.min(140,state.distance+20*dt);
        if(controls.left) state.lateral=Math.max(-42,state.lateral-55*dt);
        if(controls.right) state.lateral=Math.min(42,state.lateral+55*dt);
        if(!controls.left && !controls.right){
          state.lateral*=0.9;
          if(Math.abs(state.lateral)<0.2) state.lateral=0;
        }

        if(hall){
          const progress=(140-state.distance)/140;
          const yShift=progress*420;
          const xShift=state.lateral*4;
          const yaw=state.lateral*0.22;
          hall.style.backgroundPosition=`${xShift}px ${yShift}px, ${-xShift*0.5}px ${yShift*0.6}px, ${xShift*0.8}px 0px`;
          hall.style.transform=`perspective(900px) rotateY(${yaw}deg) scale(${1+progress*0.05})`;
          hall.style.boxShadow=state.distance<=20
            ?'inset 0 0 120px rgba(255,120,120,0.18), 0 0 25px rgba(255,160,160,0.25)'
            :'inset 0 0 100px rgba(0,0,0,0.75), 0 0 20px rgba(120,255,120,0.12)';

          if(hallCore){
            hallCore.style.transform=`translateX(${state.lateral*1.8}px) translateY(${progress*18}px) scale(${1+progress*0.04})`;
          }
          if(leftWall){
            leftWall.style.backgroundPosition=`0 ${yShift*1.2}px, 0 ${yShift*0.4}px`;
            leftWall.style.filter=`brightness(${0.9+progress*0.28})`;
          }
          if(rightWall){
            rightWall.style.backgroundPosition=`0 ${yShift*1.2}px, 0 ${yShift*0.4}px`;
            rightWall.style.filter=`brightness(${0.9+progress*0.28})`;
          }
          if(floor){
            floor.style.backgroundPosition=`0 ${yShift*1.8}px, ${xShift*0.2}px ${yShift*0.6}px`;
          }
          if(farDoor){
            const doorScale=0.55+progress*1.12;
            const doorLift=-progress*14;
            farDoor.style.transform=`translateX(calc(-50% + ${state.lateral*0.45}px)) translateY(${doorLift}px) scale(${doorScale})`;
          }
          const nearPanel=state.distance<=5;
          const doorOpenPx=nearPanel ? Math.min(34,(5-state.distance)*6.8) : 0;
          if(doorLeft) doorLeft.style.transform=`translateX(${-doorOpenPx}px)`;
          if(doorRight) doorRight.style.transform=`translateX(${doorOpenPx}px)`;
          if(doorStatus){
            doorStatus.textContent=nearPanel?'ACCESS PATH OPEN':'ACCESS PATH LOCKED';
            doorStatus.style.color=nearPanel?'#9dff9d':'#ffb3a3';
            doorStatus.style.textShadow=nearPanel?'0 0 8px rgba(120,255,120,0.55)':'0 0 8px rgba(255,120,120,0.5)';
          }
          const pulse=(Math.sin(now/180)+1)/2;
          if(warnA) warnA.style.opacity=String(0.35+pulse*0.65);
          if(warnB) warnB.style.opacity=String(0.35+(1-pulse)*0.65);
        }

        updateHUD();
        animFrame=requestAnimationFrame(tick);
      };

      keyDownHandler=(e)=>{
        if(e.code==='KeyW'||e.code==='ArrowUp'){ e.preventDefault(); controls.forward=true; }
        if(e.code==='KeyS'||e.code==='ArrowDown'){ e.preventDefault(); controls.back=true; }
        if(e.code==='KeyA'||e.code==='ArrowLeft'){ e.preventDefault(); controls.left=true; }
        if(e.code==='KeyD'||e.code==='ArrowRight'){ e.preventDefault(); controls.right=true; }
        if(e.code==='ShiftLeft'||e.code==='ShiftRight'){ e.preventDefault(); controls.run=true; }
      };
      keyUpHandler=(e)=>{
        if(e.code==='KeyW'||e.code==='ArrowUp'){ e.preventDefault(); controls.forward=false; }
        if(e.code==='KeyS'||e.code==='ArrowDown'){ e.preventDefault(); controls.back=false; }
        if(e.code==='KeyA'||e.code==='ArrowLeft'){ e.preventDefault(); controls.left=false; }
        if(e.code==='KeyD'||e.code==='ArrowRight'){ e.preventDefault(); controls.right=false; }
        if(e.code==='ShiftLeft'||e.code==='ShiftRight'){ e.preventDefault(); controls.run=false; }
      };
      window.addEventListener('keydown',keyDownHandler);
      window.addEventListener('keyup',keyUpHandler);

      bindMovePadButton('fpBtnW','forward');
      bindMovePadButton('fpBtnS','back');
      bindMovePadButton('fpBtnA','left');
      bindMovePadButton('fpBtnD','right');
      bindMovePadButton('fpBtnRun','run',true);

      if(panelBtn){
        panelBtn.onclick=()=>{
          cleanupPhaseOne();
          phase=2;
          render();
        };
      }

      animFrame=requestAnimationFrame(tick);
    };

    const randomPanelTarget=()=>{
      const base=[0,0,0,0].map(()=>Math.random()<0.5?0:1);
      if(base.every(v=>v===0)) base[Math.floor(Math.random()*base.length)]=1;
      return base;
    };

    const updateShutdownPanelUI=()=>{
      const time=document.getElementById('fpPanelTime');
      const attempts=document.getElementById('fpPanelAttempts');
      const status=document.getElementById('fpPanelStatus');
      const executeBtn=document.getElementById('fpExecuteBtn');
      const bars=document.querySelectorAll('[data-fp-bar]');
      const targets=document.querySelectorAll('[data-fp-target]');

      bars.forEach((bar,idx)=>{
        const active=panelState.current[idx]===1;
        bar.style.background=active?'linear-gradient(180deg,#7dff7d,#3daa3d)':'linear-gradient(180deg,#331616,#190a0a)';
        bar.style.boxShadow=active?'0 0 12px rgba(110,255,110,0.55)':'inset 0 0 8px rgba(0,0,0,0.55)';
      });
      targets.forEach((node,idx)=>{
        node.textContent=panelState.target[idx]===1?'HIGH':'LOW';
        node.style.color=panelState.target[idx]===1?'#9dff9d':'#ffb9b9';
      });

      if(time) time.textContent=panelState.timeLeft+'s';
      if(attempts) attempts.textContent=String(panelState.attempts);

      const matched=panelState.current.every((v,idx)=>v===panelState.target[idx]);
      if(matched && !panelState.solved){
        panelState.solved=true;
        clearPanelTimer();
        if(status){
          status.textContent='PATTERN ACCEPTED // RUN SHUTDOWN';
          status.style.color='#a9ffa9';
        }
        if(executeBtn){
          executeBtn.disabled=false;
          executeBtn.style.opacity='1';
          executeBtn.style.pointerEvents='auto';
          executeBtn.textContent='EXECUTE SHUTDOWN';
        }
      }
    };

    const startShutdownPanelMinigame=()=>{
      panelState.target=randomPanelTarget();
      panelState.current=[0,0,0,0];
      panelState.attempts=0;
      panelState.timeLeft=18;
      panelState.solved=false;

      const status=document.getElementById('fpPanelStatus');
      const executeBtn=document.getElementById('fpExecuteBtn');
      if(executeBtn){
        executeBtn.disabled=true;
        executeBtn.style.opacity='0.55';
        executeBtn.style.pointerEvents='none';
        executeBtn.textContent='MATCH REQUIRED';
      }
      if(status){
        status.textContent='Align output levels with target pattern.';
        status.style.color='#d7d7d7';
      }

      document.querySelectorAll('[data-fp-toggle]').forEach(btn=>{
        btn.onclick=()=>{
          if(panelState.solved || panelState.timeLeft<=0) return;
          const idx=Number(btn.getAttribute('data-fp-toggle'));
          panelState.current[idx]=panelState.current[idx]===1?0:1;
          panelState.attempts++;
          updateShutdownPanelUI();
        };
      });

      if(executeBtn){
        executeBtn.onclick=()=>{
          phase=3;
          render();
        };
      }

      updateShutdownPanelUI();
      clearPanelTimer();
      panelState.timer=setInterval(()=>{
        if(panelState.solved) return;
        panelState.timeLeft=Math.max(0,panelState.timeLeft-1);
        if(panelState.timeLeft===0){
          clearPanelTimer();
          if(status){
            status.textContent='Timeout. ECO override engaged.';
            status.style.color='#ffb6b6';
          }
          if(executeBtn){
            executeBtn.disabled=false;
            executeBtn.style.opacity='1';
            executeBtn.style.pointerEvents='auto';
            executeBtn.textContent='FORCE CONTINUE';
            executeBtn.onclick=()=>{
              phase=3;
              render();
            };
          }
        }
        updateShutdownPanelUI();
      },1000);
    };

    const render=()=>{
      if(phase===0){
        overlay.innerHTML=''
          +'<div style="position:absolute;inset:0;background:radial-gradient(circle at 50% 25%,rgba(18,38,56,.45) 0%,rgba(6,10,16,.88) 48%,#010203 100%);"></div>'
          +'<div style="position:absolute;inset:0;pointer-events:none;background:repeating-linear-gradient(0deg,rgba(255,255,255,.035) 0px,rgba(255,255,255,.035) 1px,transparent 2px,transparent 4px),linear-gradient(90deg,rgba(120,210,255,.08),transparent 30%,rgba(255,120,120,.07));mix-blend-mode:screen;opacity:.4;"></div>'
          +'<div style="position:absolute;left:0;right:0;top:0;height:44px;background:linear-gradient(90deg,#371b1b,#5a2a2a,#371b1b);border-bottom:2px solid #9c5b5b;color:#ffd7d7;display:flex;align-items:center;justify-content:center;letter-spacing:3px;font-size:12px;">VOID CENTRAL CORE // SHUTDOWN ACCESS CORRIDOR</div>'
          +'<div style="position:absolute;left:18px;top:64px;bottom:24px;width:140px;border:1px solid #324654;background:linear-gradient(180deg,#0b1218,#070b10);box-shadow:inset 0 0 22px rgba(0,0,0,.7),0 0 16px rgba(90,170,255,.12);"></div>'
          +'<div style="position:absolute;right:18px;top:64px;bottom:24px;width:140px;border:1px solid #324654;background:linear-gradient(180deg,#0b1218,#070b10);box-shadow:inset 0 0 22px rgba(0,0,0,.7),0 0 16px rgba(90,170,255,.12);"></div>'
          +'<div style="position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:min(980px,calc(100vw - 360px));min-width:min(96vw,520px);border:1px solid #355062;background:linear-gradient(180deg,rgba(8,14,20,.95),rgba(4,7,10,.96));padding:24px 26px;text-align:center;box-shadow:0 0 42px rgba(0,0,0,.75),0 0 26px rgba(120,210,255,.14);">'
