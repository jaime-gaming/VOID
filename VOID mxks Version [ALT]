<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' fill='%2304220a'/%3E%3Ctext x='32' y='33' font-family='Consolas,monospace' font-size='20' text-anchor='middle' fill='%232ecc71'%3EVOID%3C/text%3E%3Ctext x='32' y='48' font-family='Consolas,monospace' font-size='10' text-anchor='middle' fill='%232ecc71'%3EMXKS%3C/text%3E%3C/svg%3E">
<title>VOID mxks version</title>
<style>
:root {
  --bg:#0a0a0a;
  --panel:#111;
  --line:#222;
  --text:#c2c2c2;
  --accent:#d6d6d6;
  --alert:#ff6666;
  --muted:#7a7a7a;
  --green:#9a9a9a;
  --blue:#9aa4a8;
  --red:#c46a6a;
  --glow-green:0 0 15px rgba(255,255,255,0.25);
  --glow-blue:0 0 15px rgba(170,185,190,0.35);
  --glow-red:0 0 15px rgba(200,110,110,0.5);
};

* {
  cursor: default;
};

/* Custom scrollbars */
::-webkit-scrollbar {
  width: 8px;
  height: 8px;
}
::-webkit-scrollbar-track {
  background: #0a0a0a;
}
::-webkit-scrollbar-thumb {
  background: #444;
  border-radius: 4px;
}
/* Firefox */
* {
  scrollbar-width: thin;
  scrollbar-color: #444 #0a0a0a;
}

html,body{
  margin:0;padding:0;height:100%;width:100%;
  background:var(--bg);color:var(--text);
  font-family:ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  overflow:hidden;
}
body::after{
  content:"";
  position:fixed;inset:0;pointer-events:none;
  background:repeating-linear-gradient(0deg,rgba(255,255,255,0.02) 0px,rgba(255,255,255,0.02) 1px,transparent 2px,transparent 4px);
  mix-blend-mode:overlay;
  opacity:0.25;
  animation:scan 7s linear infinite;
}

@keyframes scan{
  0%{transform:translateY(-8%);opacity:0.15;}
  50%{transform:translateY(8%);opacity:0.3;}
  100%{transform:translateY(-8%);opacity:0.15;}
}

@keyframes introAutoHide{
  0%{opacity:1;visibility:visible;}
  90%{opacity:1;visibility:visible;}
  100%{opacity:0;visibility:hidden;}
}

#intro{position:fixed;inset:0;z-index:1200;background:#000;display:flex;align-items:center;justify-content:center;overflow:hidden;}
#intro video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:brightness(.75) contrast(1.05);}
#introSkipIndicator{position:absolute;right:26px;bottom:24px;width:54px;height:54px;opacity:0;transform:scale(.92);transition:opacity .15s ease,transform .15s ease;pointer-events:none;z-index:3;}
#introSkipIndicator.active{opacity:1;transform:scale(1);}
#introSkipIndicator svg{width:100%;height:100%;display:block;filter:drop-shadow(0 0 8px rgba(255,255,255,.25));}
#introSkipIndicator .bg{stroke:rgba(255,255,255,.28);stroke-width:4;fill:none;}
#introSkipIndicator .fg{stroke:#eaf6ff;stroke-width:4;fill:none;stroke-linecap:round;stroke-dasharray:138;stroke-dashoffset:138;transform:rotate(-90deg);transform-origin:50% 50%;}
#introSkipIndicator .label{position:absolute;left:50%;top:-20px;transform:translateX(-50%);font-size:10px;letter-spacing:.8px;color:#eaf6ff;text-shadow:0 0 6px rgba(160,220,255,.4);white-space:nowrap;}

#miniCinematicOverlay{position:fixed;inset:0;z-index:100050;pointer-events:none;background:radial-gradient(circle at 50% 50%,rgba(10,14,18,.14) 0%,rgba(0,0,0,.52) 66%,rgba(0,0,0,.78) 100%);display:flex;align-items:center;justify-content:center;animation:miniCinematicFade .35s ease;backdrop-filter:blur(1.2px) contrast(1.06);}
#miniCinematicOverlay .frame{width:min(1060px,98vw);height:min(610px,88vh);border:1px solid #24343a;background:#050709;box-shadow:0 0 40px rgba(0,0,0,.86),0 0 20px rgba(100,180,255,.14);position:relative;overflow:hidden;animation:miniFrameWarp .22s steps(2) infinite;}
#miniCinematicOverlay .noise{position:absolute;inset:0;opacity:.2;background:repeating-linear-gradient(0deg,rgba(255,255,255,.07) 0px,rgba(255,255,255,.07) 1px,transparent 2px,transparent 5px),linear-gradient(90deg,rgba(255,40,40,.05),transparent 38%,rgba(40,255,255,.06));mix-blend-mode:screen;animation:miniNoiseMove .95s linear infinite;}
#miniCinematicOverlay .ghost{position:absolute;inset:0;opacity:.16;background:linear-gradient(90deg,rgba(255,255,255,.06),transparent 22%,rgba(255,255,255,.07) 45%,transparent 70%);mix-blend-mode:screen;animation:miniGhostDrift 1.35s steps(2) infinite;}
#miniCinematicOverlay .tear{position:absolute;left:0;right:0;height:16%;top:22%;background:linear-gradient(180deg,rgba(255,255,255,.18),rgba(255,255,255,0));mix-blend-mode:screen;opacity:.08;animation:miniTearShift .42s steps(2) infinite;}
#miniCinematicOverlay .vignette{position:absolute;inset:0;background:radial-gradient(circle at 50% 50%,transparent 34%,rgba(0,0,0,.44) 68%,rgba(0,0,0,.85) 100%);mix-blend-mode:multiply;animation:miniVignettePulse 2.1s ease-in-out infinite;}
#miniCinematicOverlay video{width:100%;height:100%;object-fit:cover;filter:brightness(.52) contrast(1.28) saturate(.58) blur(.35px) hue-rotate(-9deg);animation:miniChromatic .35s steps(2) infinite;}
#miniCinematicOverlay .servers{position:absolute;inset:0;background:radial-gradient(circle at 50% 30%,#0f1e2a,#05070a 65%);}
#miniCinematicOverlay .servers::before{content:'';position:absolute;left:14%;right:14%;top:8%;bottom:8%;background:repeating-linear-gradient(90deg,rgba(100,180,255,.25) 0px,rgba(100,180,255,.25) 2px,transparent 2px,transparent 44px),linear-gradient(180deg,transparent 0%,rgba(80,140,180,.35) 50%,transparent 100%);opacity:.55;animation:miniServerPulse 2.2s ease-in-out infinite;}
@keyframes miniCinematicFade{from{opacity:0}to{opacity:1}}
@keyframes miniNoiseMove{0%{transform:translateY(0)}100%{transform:translateY(16px)}}
@keyframes miniServerPulse{0%,100%{opacity:.35}50%{opacity:.75}}
@keyframes miniFrameWarp{0%,100%{transform:translate(0,0)}35%{transform:translate(-2px,1px)}66%{transform:translate(2px,-1px)}}
@keyframes miniGhostDrift{0%,100%{transform:translateX(0)}45%{transform:translateX(-5px)}75%{transform:translateX(4px)}}
@keyframes miniTearShift{0%{transform:translateY(0)}50%{transform:translateY(35vh)}100%{transform:translateY(0)}}
@keyframes miniVignettePulse{0%,100%{opacity:.75}50%{opacity:.95}}
@keyframes miniChromatic{0%,100%{transform:translate(0,0)}25%{transform:translate(-1px,0)}60%{transform:translate(1px,0)}}

#introConsole{position:fixed;inset:0;z-index:1250;display:none;align-items:center;justify-content:center;background:radial-gradient(circle,#070707,#000);}
#introConsole .panel{width:min(760px,92vw);background:#050607;border:1px solid #1d2a2a;box-shadow:0 0 40px rgba(0,0,0,0.9),0 0 15px rgba(120,220,220,0.15);padding:24px;display:flex;flex-direction:column;gap:14px;}
#introConsole .title{font-size:12px;letter-spacing:2px;color:#7fe3e3;}
#introConsole .headline{font-size:26px;color:#7fe3e3;letter-spacing:3px;text-shadow:0 0 14px rgba(127,227,227,0.35);}
#introConsole .boot{color:#9dff9d;font-size:13px;letter-spacing:0.5px;display:flex;flex-direction:column;gap:4px;padding:12px;max-height:250px;overflow:hidden;background:#050705;border:1px solid #2a5a2a;box-shadow:inset 0 0 12px rgba(0,0,0,0.7),0 0 10px rgba(80,200,80,0.2);font-family:Consolas,monospace;}
#introConsole .play-btn{margin-top:6px;padding:12px 20px;background:#0a1a2a;border:1px solid #4a78a8;color:#cfe6ff;cursor:pointer;font-family:monospace;letter-spacing:1px;font-size:14px;}
#introConsole .play-btn:hover{background:#0f2336;border-color:#74aaff;color:#e8f2ff;}

#loginScreen{position:fixed;inset:0;z-index:90;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;background:radial-gradient(circle,#141414,#000);color:var(--text);text-align:center;letter-spacing:0.8px;}
#loginScreen > div{font-size:22px;letter-spacing:6px;color:var(--accent);text-shadow:0 0 12px rgba(255,255,255,0.18);margin-bottom:8px;}
#loginScreen input{width:240px;background:#0c0c0c;border:1px solid #2a2a2a;color:var(--text);padding:8px 10px;box-shadow:inset 0 0 8px rgba(0,0,0,0.6);text-align:center;}
#loginScreen input:focus{outline:none;border-color:var(--accent);box-shadow:0 0 8px rgba(255,255,255,0.15), inset 0 0 8px rgba(0,0,0,0.7);}
#loginScreen input::placeholder{color:var(--muted);}
#loginScreen button{margin-top:6px;padding:10px 30px;background:var(--accent);border:none;color:#000;cursor:pointer;font-family:inherit;font-weight:bold;}
#loginScreen button:hover{background:#e0e0e0;}
#loginFingerprint{width:54px;height:54px;border:1px solid #1f4f1f;border-radius:12px;background:radial-gradient(circle at 30% 30%, #103010, #071407);display:flex;align-items:center;justify-content:center;cursor:pointer;box-shadow:0 0 12px rgba(42,130,42,0.35), inset 0 0 8px rgba(0,0,0,0.45);transition:transform 0.15s ease, box-shadow 0.2s ease, border-color 0.2s ease;}
#loginFingerprint:hover{transform:scale(1.05);border-color:#36a836;box-shadow:0 0 16px rgba(56,190,56,0.5), inset 0 0 8px rgba(0,0,0,0.45);}
#loginFingerprint.ok{border-color:#5a9f5a;box-shadow:0 0 20px rgba(110,220,110,0.5), inset 0 0 8px rgba(0,0,0,0.45);}
#loginFingerprint.fail{border-color:#a45a5a;box-shadow:0 0 16px rgba(210,90,90,0.45), inset 0 0 8px rgba(0,0,0,0.45);}
#loginFingerprint svg{width:30px;height:30px;display:block;}
#loginFingerprint svg path{stroke:#63e363;stroke-width:1.8;fill:none;stroke-linecap:round;stroke-linejoin:round;}
#fingerprintStatus{font-size:10px;letter-spacing:0.7px;color:#8fc98f;min-height:14px;margin-top:-2px;}
#fingerprintStatus.fail{color:#ffd2d2;}
#fingerprintStatus.ok{color:#d2ffd2;}

.window{position:absolute;background:var(--panel);border:2px solid var(--line);box-shadow:0 0 20px rgba(0,0,0,0.8), 0 0 15px rgba(100,100,100,0.1);resize:both;overflow:hidden;min-width:200px;min-height:100px;max-width:95vw;max-height:90vh;display:flex;flex-direction:column;z-index:200;transition:box-shadow 0.3s;box-sizing:border-box;}
.window:hover{box-shadow:0 0 30px rgba(0,0,0,0.8), 0 0 20px rgba(100,100,100,0.2);}
.window .titlebar{background:linear-gradient(90deg, #1c1c1c 0%, #252525 100%);color:var(--accent);padding:6px 12px;cursor:move;display:flex;justify-content:space-between;align-items:center;flex-shrink:0;border-bottom:1px solid var(--line);font-weight:bold;letter-spacing:0.5px;}
.window .titlebar .close{cursor:pointer;color:var(--alert);font-weight:bold;transition:all 0.2s;padding:2px 8px;}
.window .titlebar .close:hover{color:#ff9999;text-shadow:var(--glow-red);}
.window .content{padding:10px;color:var(--text);font-size:12px;white-space:pre-wrap;overflow-y:auto;flex:1;box-sizing:border-box;}
#cameraWindow .content{padding:8px;white-space:normal;overflow:hidden;}

.open-server-window{position:relative;}
.open-server-window.open-server-glitch{animation:glitch 0.12s infinite;}
.open-server-window.open-server-glitch .content{animation:glitch 0.18s infinite;filter:contrast(1.2) saturate(1.4);text-shadow:1px 0 rgba(255,0,0,0.35),-1px 0 rgba(0,255,255,0.35);}
.open-server-glitch-overlay{position:absolute;inset:0;pointer-events:none;background:repeating-linear-gradient(0deg,rgba(255,255,255,0.08) 0px,rgba(255,255,255,0.08) 1px,transparent 2px,transparent 4px),linear-gradient(90deg,rgba(255,0,0,0.12),transparent 45%,rgba(0,255,255,0.12));mix-blend-mode:screen;animation:glitchOverlay 0.2s infinite;z-index:5;}
@keyframes glitchOverlay{0%{transform:translate(2px,-1px);}50%{transform:translate(-2px,1px);}100%{transform:translate(0,0);}}


#mailWindow{width:320px;height:280px;max-height:400px;}
#mailWindow .content{font-size:10px;padding:6px;max-height:230px;overflow-y:auto;}
#mailWindow .mail-item{padding:4px;margin:2px 0;border-bottom:1px solid #2a2a2a;cursor:pointer;}
#mailWindow .mail-item:hover{background:#1a1a1a;}
#mailWindow .mail-item.unread{color:var(--accent);}
#mailWindow .mail-from{font-weight:bold;font-size:9px;}
#mailWindow .mail-subject{font-size:10px;}
#mailWindow .mail-time{float:right;font-size:8px;color:#666;}

.mail-msg-window{max-width:90vw;max-height:90vh;min-width:300px;min-height:200px;width:auto;height:auto;}
.mail-msg-window .content{font-size:11px;padding:10px;overflow-y:auto;max-height:calc(90vh - 40px);line-height:1.4;}
.mail-msg-window .mail-header{border-bottom:1px solid #2a4a2a;padding-bottom:8px;margin-bottom:10px;}
.mail-msg-window .mail-from-line{font-size:10px;color:#888;margin-bottom:4px;}

.mail-msg-window .mail-subject-line{font-weight:bold;font-size:12px;margin-bottom:8px;}
.mail-msg-window .mail-body{white-space:pre-wrap;word-wrap:break-word;}
.mail-msg-window .mail-responses{display:flex;gap:6px;margin-top:12px;flex-wrap:wrap;}
.mail-msg-window .mail-responses button{padding:6px 12px;background:#1a2a3a;border:1px solid #2a4a6a;color:#aaa;cursor:pointer;font-size:10px;border-radius:2px;}
.mail-msg-window .mail-responses button:hover{background:#2a3a4a;color:#fff;}
 
#cameraWindow{width:700px;height:500px;max-width:90vw;max-height:90vh;box-shadow:0 0 20px rgba(15,255,0,0.3);}
.camera-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:8px;width:100%;height:100%;}
.camera-feed{position:relative;border:2px solid var(--line);background:#0a0a0a;cursor:pointer;overflow:hidden;}
.camera-feed:hover{box-shadow:inset 0 0 20px rgba(0,0,0,0.5), 0 0 25px rgba(255,255,255,0.2);border-color:var(--accent);}
.camera-feed video{width:100%;height:100%;object-fit:cover;}
.camera-overlay{position:absolute;top:0;left:0;right:0;bottom:0;pointer-events:none;}
.camera-shadow-entity{position:absolute;width:74px;height:178px;bottom:18px;left:57%;transform:translateX(-50%);z-index:35;pointer-events:none;animation:silhouetteFloat 4.2s ease-in-out infinite;opacity:0.62;display:none;background:rgba(0,0,0,0.88);clip-path:polygon(50% 0%,67% 10%,72% 24%,76% 38%,72% 52%,66% 62%,66% 80%,78% 100%,63% 100%,52% 78%,48% 78%,37% 100%,22% 100%,34% 80%,34% 62%,28% 52%,24% 38%,28% 24%,33% 10%);box-shadow:0 0 26px rgba(0,0,0,0.95);}
.camera-shadow-entity::before{content:"";position:absolute;top:-24px;left:50%;width:34px;height:34px;transform:translateX(-50%);background:rgba(0,0,0,0.9);border-radius:50%;box-shadow:0 0 16px rgba(0,0,0,0.95);}
.camera-shadow-entity::after{content:"";position:absolute;top:52px;left:50%;width:44px;height:64px;transform:translateX(-50%);background:rgba(0,0,0,0.94);border-radius:45% 45% 30% 30%;}
.camera-label{position:absolute;top:6px;left:8px;background:rgba(0,0,0,0.9);padding:4px 8px;font-size:11px;color:var(--accent);font-family:monospace;border:2px solid var(--accent);font-weight:bold;letter-spacing:1px;box-shadow:var(--glow-green);}
.camera-time{position:absolute;top:6px;right:8px;background:rgba(0,0,0,0.9);padding:4px 8px;font-size:11px;color:#f00;font-family:monospace;border:2px solid #f00;font-weight:bold;letter-spacing:1px;box-shadow:var(--glow-red);}
.camera-status{position:absolute;bottom:6px;left:8px;background:rgba(0,0,0,0.9);padding:4px 8px;font-size:10px;color:#0ff;font-family:monospace;border:1px solid #0ff;font-weight:bold;box-shadow:var(--glow-blue);}
.camera-rec{position:absolute;bottom:6px;right:8px;color:#f00;font-size:11px;animation:blink 1s infinite;font-weight:bold;text-shadow:var(--glow-red);}
@keyframes blink{0%,50%{opacity:1;}51%,100%{opacity:0;}}
@keyframes glitch{0%{transform:translate(2px,2px);opacity:0.8;}20%{transform:translate(-2px,-2px);opacity:0.7;}40%{transform:translate(1px,-1px);opacity:0.9;}60%{transform:translate(-1px,1px);opacity:0.6;}80%{transform:translate(2px,-2px);opacity:0.8;}100%{transform:translate(0,0);opacity:1;}}
@keyframes glitchAppear{0%{opacity:0;transform:scale(0.8) skew(-5deg);}50%{transform:scale(1.05) skew(2deg);}100%{opacity:1;transform:scale(1) skew(0deg);}}
@keyframes fadeIn{0%{opacity:0;}100%{opacity:1;}}
@keyframes scanlineFlicker{0%,100%{opacity:0.5;}50%{opacity:1;}}
@keyframes fadeInScale{0%{opacity:0;transform:scale(0.5) rotate(-15deg);}100%{opacity:1;transform:scale(1) rotate(0deg);}}

/* Elevator System and Floor Visuals */
.elevator-transition{position:fixed;inset:0;background:linear-gradient(180deg, rgba(0,0,0,0.98) 0%, rgba(20,0,40,0.95) 100%);z-index:99999;display:flex;flex-direction:column;align-items:center;justify-content:center;color:var(--accent);font-family:monospace;animation:elevatorAppear 0.4s ease-out;}
@keyframes elevatorAppear{0%{opacity:0;}100%{opacity:1;}}
.elevator-floor-display{font-size:120px;font-weight:bold;margin-bottom:50px;text-shadow:0 0 30px rgba(100,180,255,0.8), 0 0 60px rgba(100,180,255,0.4);animation:elevatorFloorChange 1.8s ease-in-out;color:#64b4ff;letter-spacing:20px;}
@keyframes elevatorFloorChange{0%{transform:scale(0);opacity:0;filter:blur(10px);}40%{opacity:1;transform:scale(1.3);}100%{transform:scale(1);opacity:1;filter:blur(0px);}}
.elevator-bar{width:500px;height:32px;border:4px solid var(--accent);background:#0a0a1a;position:relative;overflow:hidden;box-shadow:inset 0 0 20px rgba(0,0,0,0.9), 0 0 40px rgba(100,180,255,0.5);border-radius:4px;}
.elevator-bar-fill{height:100%;background:linear-gradient(90deg, #4cc9ff 0%, #00ffff 50%, #4cc9ff 100%);width:0%;animation:elevatorMove 2s ease-in-out forwards;box-shadow:inset 0 0 10px rgba(255,255,255,0.3), 0 0 30px rgba(100,180,255,0.8);}
@keyframes elevatorMove{0%{width:0%;filter:brightness(1);}50%{filter:brightness(1.5);}100%{width:100%;filter:brightness(1);}}
.elevator-text{margin-top:40px;font-size:16px;letter-spacing:4px;color:#7fa8d1;text-transform:uppercase;animation:fadeIn 0.6s ease-out 0.2s both;text-shadow:0 0 10px rgba(100,180,255,0.6);}


#desktop{position:fixed;top:0;left:0;right:0;bottom:32px;background:var(--bg);display:none;overflow:hidden;pointer-events:auto;}

.icon{width:92px;height:120px;text-align:center;color:var(--text);font-size:10px;cursor:pointer;position:absolute;display:flex;flex-direction:column;align-items:center;justify-content:flex-start;overflow:hidden;padding:8px;box-sizing:border-box;user-select:none;pointer-events:auto;z-index:10;gap:6px;}
.icon img{width:50px;height:50px;display:block;margin:0;flex-shrink:0;object-fit:contain;pointer-events:none;image-rendering:auto;}
.icon div{width:100%;overflow:hidden;text-overflow:ellipsis;display:-webkit-box;-webkit-line-clamp:4;line-clamp:4;-webkit-box-orient:vertical;word-break:break-word;line-height:1.2;font-size:9px;margin:0;padding:0 2px;pointer-events:none;flex:1;}
.icon.selected{outline:2px dashed var(--accent);background:rgba(200,200,200,0.1);border-radius:3px;}
.icon:hover{opacity:0.8;}
.icon.open-server-materialize{opacity:0;animation:openServerMaterialize 6s cubic-bezier(0.85, 0, 0.15, 1) forwards;position:relative;}
.icon.open-server-materialize::before{content:'';position:absolute;inset:-4px;background:linear-gradient(45deg, #ff0000, #00ff00, #0000ff, #ff00ff);opacity:0;animation:openServerGlitchRainbow 0.8s infinite;pointer-events:none;filter:blur(8px);z-index:-1;}
.icon.open-server-materialize::after{content:'';position:absolute;inset:6px;background:repeating-linear-gradient(90deg,rgba(80,160,255,0.6) 0px,rgba(80,160,255,0.6) 2px,transparent 2px,transparent 6px),repeating-linear-gradient(0deg,rgba(80,160,255,0.4) 0px,rgba(80,160,255,0.4) 2px,transparent 2px,transparent 6px);mix-blend-mode:screen;opacity:1;animation:openServerPixels 0.15s steps(8) infinite, openServerScanline 2s linear infinite;pointer-events:none;}
@keyframes openServerMaterialize{0%{opacity:0;filter:blur(12px) hue-rotate(0deg);transform:scale(0.6) translateY(-20px);}20%{opacity:0.3;filter:blur(8px) hue-rotate(90deg);transform:scale(0.8) translateY(-10px);}40%{opacity:0.5;filter:blur(6px) hue-rotate(180deg);transform:scale(1.1) translateY(5px);}60%{opacity:0.7;filter:blur(4px) hue-rotate(270deg);transform:scale(0.95) translateY(-2px);}80%{opacity:0.9;filter:blur(2px) hue-rotate(360deg);transform:scale(1.05) translateY(2px);}100%{opacity:1;filter:blur(0) hue-rotate(0deg);transform:scale(1) translateY(0);}}
@keyframes openServerPixels{0%{transform:translate(3px,-2px);opacity:1;}25%{transform:translate(-2px,3px);opacity:0.8;}50%{transform:translate(2px,2px);opacity:1;}75%{transform:translate(-3px,-2px);opacity:0.8;}100%{transform:translate(0,0);opacity:1;}}
@keyframes openServerScanline{0%{background-position:0 0;}100%{background-position:0 100px;}}
