  if(flags.broadcastQueued && !externalEffectsApplied.broadcast){
    externalEffects.broadcastQueued=true;
    externalEffectsApplied.broadcast=true;
    const file=files.find(f=>f.key==='megaphoneOverride');
    if(file){
