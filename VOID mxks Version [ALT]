    if(val===expected){
      document.body.removeChild(overlay);
      try{ onSuccess && onSuccess(); }catch(e){ console.error(e); }
    }else{
      alert('Contraseña incorrecta. Prueba: '+expected);
    }
  };
  overlay.querySelector('#pwdOk').onclick=check;
  input.addEventListener('keypress',(e)=>{ if(e.key==='Enter') check(); });
  overlay.querySelector('#pwdCancel').onclick=()=>{ document.body.removeChild(overlay); };
}

