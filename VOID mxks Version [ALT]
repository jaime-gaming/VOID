function goToFloor(floor){
  const modal=document.getElementById('elevatorModal');
  if(modal) modal.remove();
  
  if(floor==='office'){
    // Return to office
    if(currentFloor!=='office'){
      showElevatorAnimation(currentFloor, 'office', ()=>{
        currentFloor='office';
        returnToOfficeFromFloor();
      });
    }
    hideElevatorArrow();
    elevatorArrowVisible=false;
    return;
  }
  
  // Check if floor is locked
  const floorData=floorNotes[floor];
  if(floorData.locked && floorData.locked_with!=='NONE' && !window.godModeActive){
    showGameAlert(`⚠️ ${floorData.name} [LOCKED]\n\n${floorData.hint}`);
    return;
  } else if(window.godModeActive && floorData.locked){
    floorData.locked=false;
  }
  
  // Save current floor content if in office
  if(currentFloor==='office'){
    const contentEl=document.getElementById('officePapersContent');
    if(contentEl){
      let content=contentEl.textContent;
      if(!content || content.trim().length===0){
        content=contentEl.innerHTML;
      }
      floorNotes[currentFloor].content=content;
    }
  }
  
  // Go directly to selected floor
  showElevatorAnimation(currentFloor, floor, ()=>{
    currentFloor=floor;
    switchToFloor(floor);
  });
}

