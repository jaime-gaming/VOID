  content.innerHTML=Object.entries(hardDriveStorage).map(([name,data])=>`<div style="padding:8px;background:#222;margin:4px 0;border-radius:4px;border-left:3px solid var(--accent);display:flex;justify-content:space-between;align-items:center;"><span>${name}</span><button onclick="deleteFromHardDrive('${name}')" style="padding:4px 8px;background:#5a2a2a;border:1px solid #8a4a4a;color:var(--alert);cursor:pointer;font-size:10px;">Eliminar</button></div>`).join('');
