function isFolderKey(key){
  const f=files.find(x=>x.key===key);return f&&f.isFolder;
}

function selectIcon(key){
  selectedIcon=files.find(f=>f.key===key)||null;
  document.querySelectorAll('.icon').forEach(ic=>ic.classList.toggle('selected',ic.dataset.key===key));
}

function deleteFile(key){
  const file=files.find(f=>f.key===key);
  if(!file)return;
  if(!file.userCreated){alert(t('alert.cannotDelete'));return;}
  const hasSystemFiles=files.some(f=>f.container===key && !f.userCreated);
  if(hasSystemFiles){alert(t('alert.systemFiles'));return;}
  const idx=files.findIndex(f=>f.key===key);
  files.splice(idx,1);
  const icon=document.querySelector('.icon[data-key="'+key+'"]');if(icon)icon.remove();
  const win=document.getElementById(key+'Window');if(win)win.remove();
  selectedIcon=null;hideContextMenu();
}

function createNewFile(kind,targetContainer=null){
  const suggested={note:'nota_'+Math.floor(Math.random()*999)+'.txt',log:'log_'+Math.floor(Math.random()*999)+'.log',folder:'folder_'+Math.floor(Math.random()*999)};
  const name=prompt(t('prompt.newElement'),suggested[kind]||'item_'+Date.now());
  if(!name)return;
  const key=(name.replace(/[^a-z0-9]/gi,'')||'key'+Date.now())+Date.now();
  const folder=kind==='folder'?'CUSTOM':(kind==='note'?'DIARY':'PROJECTS');
  const container=targetContainer!==null?targetContainer:(selectedIcon && isFolderKey(selectedIcon.key)?selectedIcon.key:null);
  files.push({name,folder,key,isFolder:kind==='folder',container,userCreated:true});
  fileContents[key]={title:name,body:kind.toUpperCase()+' creado por '+(currentUser||'user')+'.',editable:true};
  if(!container)createIcon(files[files.length-1]);
  if(container)openFolderWindow(container);
}

function moveToFolder(fileKey){
  const candidates=files.filter(f=>f.isFolder && f.key!==fileKey);
  if(!candidates.length){alert('No hay carpetas disponibles');return;}
  const names=candidates.map(f=>f.name).join(', ');
  const chosen=prompt('Mover a carpeta:\n'+names);
  if(!chosen)return;
  const target=candidates.find(f=>f.name===chosen);
  if(!target){alert('Carpeta no encontrada');return;}
  const file=files.find(f=>f.key===fileKey);
  if(!file)return;
  file.container=target.key;
  const icon=document.querySelector('.icon[data-key="' + fileKey + '"]');
  if(icon)icon.remove();
  openFolderWindow(target.key);
}

function openFolderWindow(folderKey){
  const folder=files.find(f=>f.key===folderKey && f.isFolder);
  if(!folder)return;
  if(folderKey==='openServer' && openServerCorrupted){
    playSound('sfxGlitch');
    return;
  }
  const winId=folderKey+'Window';
  let win=document.getElementById(winId);
  if(!win){
    win=document.createElement('div');
    win.className='window app-window';
    win.id=winId;
    win.style.top=(90+Math.floor(Math.random()*120))+'px';
    win.style.left=(120+Math.floor(Math.random()*200))+'px';
    win.style.width='420px';
    win.style.height='300px';
    win.innerHTML='<div class="titlebar">'+folder.name+'<span class="close" onclick="closeWindow(\''+winId+'\')">X</span></div><div class="content" id="'+folderKey+'Content"></div>';
    if(folderKey==='openServer'){
      win.classList.add('open-server-window');
    }
    desktop.appendChild(win);
    makeDraggable(win);
  }
  const container=document.getElementById(folderKey+'Content');
  const children=files.filter(f=>f.container===folderKey);
  const items=children.map(function(f){
    var icon=f.icon?f.icon:(f.isFolder?'📁':'📄');
    return '<div style="padding:6px 8px;cursor:pointer;border-bottom:1px solid #1a1a1a;" ondblclick="openFile(\''+f.name+'\')" oncontextmenu="event.preventDefault();selectIcon(\''+f.key+'\');showContextMenu(event.pageX,event.pageY,true,files.find(x=>x.key===\''+f.key+'\'));"><span>'+icon+' '+getLocalizedName(f)+'</span></div>';
  }).join('');
  container.innerHTML=children.length?items:`<div style="padding:12px;color:#666;text-align:center;">${t('folder.empty')}</div>`;
  openWindow(winId);
}

function hideContextMenu(){
  if(contextMenu) contextMenu.style.display='none';
}
function showContextMenu(x,y,isIcon,iconData){
  contextMenu.innerHTML='';
  const actions=isIcon?[
    {label:t('ctx.open'),fn:()=>openFile(iconData.name)},
    {label:t('ctx.move'),fn:()=>moveToFolder(iconData.key)},
    {label:t('ctx.delete'),fn:()=>deleteFile(iconData.key)}
  ]:[
    {label:t('ctx.newLog'),fn:()=>createNewFile('log')},
    {label:t('ctx.newNote'),fn:()=>createNewFile('note')},
    {label:t('ctx.newFolder'),fn:()=>createNewFile('folder')}
  ];
  actions.forEach(act=>{
    const div=document.createElement('div');
    div.className='item';
    div.textContent=act.label;
    div.onclick=()=>{act.fn();hideContextMenu();};
    contextMenu.appendChild(div);
  });
  contextMenu.style.left=x+'px';
  contextMenu.style.top=y+'px';
  contextMenu.style.display='block';
}

document.addEventListener('contextmenu',(e)=>{
  if(e.target.closest('#taskbar')||e.target.closest('#startMenu')||e.target.closest('#contextMenu'))return;
  e.preventDefault();
  if(e.target.closest('.icon'))return;
  hideContextMenu();
  showContextMenu(e.pageX,e.pageY,false,null);
});

document.addEventListener('click',()=>hideContextMenu());

function buildStartMenu(){
  const start=document.getElementById('startMenu');
