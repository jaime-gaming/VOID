#homeView{background:linear-gradient(180deg,#141628 0%,#0a0a16 100%);}
#homeView .home-card{cursor:pointer;padding:34px 38px;background:rgba(40,40,70,0.65);border:2px solid rgba(100,180,255,0.35);border-radius:12px;transition:all 0.3s;min-width:220px;box-shadow:0 10px 24px rgba(0,0,0,0.45);backdrop-filter:blur(3px);}
