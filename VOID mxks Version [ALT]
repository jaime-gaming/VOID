function transferToUSB(){
  const unlockedFiles=files.filter(f=>unlockedDocs.includes(f.key) && !f.userCreated);
  if(unlockedFiles.length===0){alert('No tienes archivos desbloqueados para transferir.\n\nDesbloquea documentos primero.');return;}
  let html='<div style="padding:10px;"><strong>Selecciona archivos para USB:</strong><br/><small style="color:var(--muted);">Podrás cargarlos en tu PC de casa</small><br/><br/>';
  unlockedFiles.forEach(f=>{
    const inUSB=usbStorage.some(u=>u.key===f.key);
    html+=`<div style="padding:5px;"><input type="checkbox" id="usb_${f.key}" ${inUSB?'checked disabled':''}/> <label for="usb_${f.key}">${f.name}</label> ${inUSB?'<span style="color:#4a8a4a;">[EN USB]</span>':''}</div>`;
  });
  html+=`<br/><button onclick="confirmUSBTransfer()" style="padding:8px;background:#2a5a2a;border:1px solid #4a8a4a;color:var(--accent);cursor:pointer;width:100%;">Copiar a USB</button></div>`;
  const win=document.createElement('div');
