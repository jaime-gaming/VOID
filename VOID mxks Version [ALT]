.mail-detail{flex:1;border:1px solid var(--line);padding:8px;overflow-y:auto;background:#0c0c0c;}
.mail-meta{color:var(--muted);margin-bottom:6px;font-size:11px;}
.badge{display:inline-block;background:var(--alert);color:#000;padding:1px 5px;border-radius:10px;font-size:10px;margin-left:6px;}

/* Office Desk */
