function triggerEcoJumpscare(source='unknown'){
  if(gameEnded) return;
  if(document.getElementById('ecoJumpScare')) return;

  playSound('sfxGlitch');
  playSound('sfxAlarm');

  const overlay=document.createElement('div');
  overlay.id='ecoJumpScare';
  overlay.style.cssText='position:fixed;inset:0;z-index:250000;background:radial-gradient(circle at 50% 50%, rgba(255,255,255,0.08) 0%, rgba(255,0,0,0.25) 35%, rgba(0,0,0,0.95) 100%);display:flex;align-items:center;justify-content:center;pointer-events:none;animation:glitch 0.12s infinite;';
  overlay.innerHTML=`
    <div style="text-align:center;color:#ff6b6b;font-family:monospace;text-shadow:0 0 22px rgba(255,40,40,0.65);">
      <div style="font-size:130px;line-height:1;">◉</div>
      <div style="font-size:26px;letter-spacing:5px;">ECO SEES YOU</div>
      <div style="font-size:11px;opacity:0.8;margin-top:8px;">SOURCE: ${source.toUpperCase()}</div>
    </div>`;

  document.body.appendChild(overlay);
  document.body.classList.add('session-glitch');

  setTimeout(()=>{
    overlay.remove();
    document.body.classList.remove('session-glitch');
  }, 850);
}

function maybeTriggerJumpscare(chance=0.15, source='ambient'){
  if(!desktopActive || gameEnded) return;
  if(Math.random()<chance){
    triggerEcoJumpscare(source);
  }
}

function registerEcoInteraction(source='action', intensity=1){
  ecoInteractionCount+=intensity;
  ecoPressureLevel=Math.min(100, ecoPressureLevel + (2*intensity));
