/* Floor visuals in editor */
.floor-visual{position:absolute;top:0;left:0;right:0;height:60px;border-bottom:2px solid;display:flex;align-items:center;justify-content:center;font-weight:bold;color:#fff;font-size:12px;letter-spacing:1px;box-shadow:inset 0 -10px 18px rgba(0,0,0,0.5);overflow:hidden;}
.floor-visual::before{content:'';position:absolute;inset:0;background:linear-gradient(90deg,rgba(255,255,255,0.05),transparent 30%,transparent 70%,rgba(255,255,255,0.05));opacity:0.7;}
.floor-visual::after{content:'';position:absolute;inset:0;background:repeating-linear-gradient(0deg,rgba(0,0,0,0.18) 0px,rgba(0,0,0,0.18) 1px,transparent 2px,transparent 4px);opacity:0.6;animation:panelFlicker 3.5s infinite;}
@keyframes panelFlicker{0%,100%{opacity:0.45;}50%{opacity:0.8;}}
.floor-office{background:linear-gradient(90deg, #1a1a1a 0%, #2a4a6a 100%);border-color:#4a8a4a;}
.floor-lab{background:linear-gradient(90deg, #2a0a0a 0%, #3a1a1a 100%);border-color:#ff6b6b;text-shadow:0 0 10px #ff6b6b;}
.floor-archive{background:linear-gradient(90deg, #1a1a2a 0%, #2a3a4a 100%);border-color:#6a8aaa;text-shadow:0 0 5px #6a8aaa;}
.floor-servers{background:linear-gradient(90deg, #0a1a2a 0%, #1a2a3a 100%);border-color:#f0a;text-shadow:0 0 10px #f0a;}
.floor-basement{background:linear-gradient(90deg, #1a0a0a 0%, #2a0a1a 100%);border-color:#ff1a1a;text-shadow:0 0 10px #ff1a1a;}

/* Interior views of each floor */
.floor-interior{width:100%;height:calc(100% - 60px);padding:20px;overflow-y:auto;position:relative;}
.floor-interior.office{background:#0a0a0a;display:grid;grid-template-columns:1fr 1fr;gap:15px;}
.floor-interior.archive{background:linear-gradient(180deg, #0a0a1a 0%, #0a0a0a 100%);display:flex;flex-wrap:wrap;gap:10px;align-content:flex-start;}
.floor-interior.lab{background:linear-gradient(180deg, #1a0a0a 0%, #0a0a0a 100%);display:flex;flex-direction:column;gap:20px;}
.floor-interior.servers{background:linear-gradient(180deg, #000a1a 0%, #0a0a0a 100%);display:grid;grid-template-columns:repeat(3, 1fr);gap:10px;}
.floor-interior.basement{background:#000;display:flex;align-items:center;justify-content:center;}

/* Elements of each floor */
.office-desk{background:#171717;border:2px solid #3f6f3f;padding:12px;border-radius:4px;color:#7fdc7f;box-shadow:inset 0 0 12px rgba(0,0,0,0.5);position:relative;}
.office-desk::after{content:'';position:absolute;right:10px;top:10px;width:18px;height:4px;background:#2a4a2a;box-shadow:0 0 8px rgba(127,220,127,0.25);}
.office-cabinet{background:#2a2a2a;border:2px solid #4a4a4a;padding:10px;border-radius:4px;color:#c2c2c2;position:relative;box-shadow:inset 0 0 8px rgba(0,0,0,0.4);}
.office-cabinet::before{content:'';position:absolute;left:10px;right:10px;top:36px;height:1px;background:#4a4a4a;box-shadow:0 1px 0 rgba(255,255,255,0.1);}
.office-phone{background:#2a2a3a;border:2px solid #4a4a5a;padding:10px;border-radius:4px;color:#c2c2c2;font-size:11px;box-shadow:inset 0 0 6px rgba(0,0,0,0.4);}
.office-panel{background:#2a2a2a;border:2px solid #4a4a4a;padding:10px;border-radius:4px;color:#9aa4a8;font-size:11px;box-shadow:inset 0 0 6px rgba(0,0,0,0.4);}
.office-status{margin-top:6px;color:#6f6;font-size:10px;}
.archive-shelf{background:#1a1a2a;border-left:4px solid #6a8aaa;padding:8px;width:180px;color:#aaa;font-size:11px;cursor:pointer;transition:all 0.3s;}
.archive-shelf:hover{background:#2a3a4a;color:#6a8aaa;}
.lab-equipment{background:linear-gradient(135deg, #2a0a0a 0%, #1a0a0a 100%);border:2px solid #ff6b6b;padding:12px;border-radius:4px;color:#ff6b6b;font-size:10px;text-align:center;flex:1;}
.lab-screen{background:#120a0a;border:1px solid #ff6b6b;color:#ff6b6b;font-family:monospace;font-size:10px;padding:10px;box-shadow:inset 0 0 12px rgba(255,107,107,0.2);}
.server-unit{background:#0a0a2a;border:1px solid #f0a;padding:10px;border-radius:2px;position:relative;height:120px;display:flex;flex-direction:column;justify-content:space-between;overflow:hidden;}
.server-unit::before{content:'';position:absolute;top:0;left:0;right:0;height:100%;background:linear-gradient(90deg, transparent, rgba(240,0,170,0.1), transparent);animation:serverScan 2s infinite;}
@keyframes serverScan{0%{top:-100%;}100%{top:100%;}}
.server-light{display:inline-block;width:6px;height:6px;background:#f0a;border-radius:50%;margin-right:4px;animation:blink 0.6s infinite;}
.server-fan{position:absolute;right:8px;top:8px;width:18px;height:18px;border:1px solid rgba(240,0,170,0.5);border-radius:50%;}
.server-fan::before{content:'';position:absolute;inset:3px;border-top:2px solid rgba(240,0,170,0.7);border-left:2px solid rgba(240,0,170,0.2);border-radius:50%;animation:fanSpin 1.6s linear infinite;}
@keyframes fanSpin{from{transform:rotate(0deg);}to{transform:rotate(360deg);}}
.basement-door{width:200px;height:250px;background:#1a0a0a;border:4px solid #ff1a1a;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;color:#ff1a1a;font-weight:bold;text-shadow:0 0 10px #ff1a1a;position:relative;}
.basement-door::after{content:'⚠ ACCESO DENEGADO ⚠';position:absolute;top:50%;left:50%;transform:translate(-50%, -50%);font-size:18px;}
.basement-chain{width:100%;height:20px;background:repeating-linear-gradient(90deg, #ff1a1a 0px, #ff1a1a 5px, transparent 5px, transparent 15px);margin:10px 0;}

#taskbar{position:fixed;left:0;right:0;bottom:0;height:32px;display:none;align-items:center;background:#101010;border-top:1px solid #1f1f1f;padding:0 10px;color:var(--text);font-size:12px;z-index:150;}
#taskbar .start-btn{margin-right:10px;cursor:pointer;}
