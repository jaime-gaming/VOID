function normalizeLanguage(lang){
  if(!lang) return 'es';
  const norm=String(lang).toLowerCase().replace(/_/g,'-');
  if(norm.startsWith('es')) return 'es';
  if(norm.startsWith('en')) return 'en';
  return 'es';
}

function detectLanguage(){
  const langs=(navigator.languages && navigator.languages.length)?navigator.languages:[navigator.language||'es'];
  for(let i=0;i<langs.length;i++){
    const mapped=normalizeLanguage(langs[i]);
    if(i18n[mapped]) return mapped;
  }
  return 'es';
}

function t(key,vars){
  const table=i18n[currentLanguage]||i18n.es;
  let text=table[key]||i18n.es[key]||key;
  if(vars){
    Object.keys(vars).forEach((k)=>{
      text=text.replace(new RegExp('\\{'+k+'\\}','g'),vars[k]);
    });
  }
  return text;
}

function applyTranslations(){
  currentLanguage=window.forceLanguage || detectLanguage();
  document.documentElement.lang=currentLanguage;
  document.querySelectorAll('[data-i18n]').forEach(el=>{
    el.textContent=t(el.getAttribute('data-i18n'));
  });
  document.querySelectorAll('[data-i18n-html]').forEach(el=>{
    el.innerHTML=t(el.getAttribute('data-i18n-html'));
  });
  document.querySelectorAll('[data-i18n-placeholder]').forEach(el=>{
    el.setAttribute('placeholder',t(el.getAttribute('data-i18n-placeholder')));
  });
  
  // Mostrar disclaimer si no es EN (solo una vez)
  if(currentLanguage!=='en' && !sessionStorage.getItem('disclaimerShown')){
    setTimeout(()=>{
      const modal=document.getElementById('disclaimerModal');
      if(modal) modal.style.display='flex';
    }, 500);
  }
}

function closeDisclaimer(){
