function createVideoFeed(videoElement, camNum){
  // Generar video temporal usando canvas y MediaStream
  const offscreenCanvas = document.createElement('canvas');
  offscreenCanvas.width = 640;
  offscreenCanvas.height = 480;
  const ctx = offscreenCanvas.getContext('2d');
  
  try {
    // Obtener stream del canvas
    const stream = offscreenCanvas.captureStream(30); // 30 FPS
    
    // Asignar stream al video element
    videoElement.srcObject = stream;
    
    // Animar el canvas
    const animate = () => {
      const now = Date.now() / 1000;
      
      // Fondo oscuro según cámara
      const bgColor = 'hsl(120, 100%, ' + (15 + Math.sin(now*0.5)*2) + '%)';
      ctx.fillStyle = bgColor;
      ctx.fillRect(0, 0, offscreenCanvas.width, offscreenCanvas.height);
      
      // Efectos específicos por cámara
      if(camNum === 1){
        // CAM-01 ENTRADA: escaleras con sombras
        ctx.strokeStyle = 'rgba(100, 150, 100, 0.3)';
        ctx.lineWidth = 40;
        for(let y=0; y<offscreenCanvas.height; y+=60){
          ctx.beginPath();
          ctx.moveTo(0, y);
          ctx.lineTo(offscreenCanvas.width, y);
          ctx.stroke();
        }
        // Silueta fantasmal
        ctx.fillStyle = 'rgba(80, 100, 80, 0.4)';
        ctx.beginPath();
        ctx.arc(offscreenCanvas.width*0.5, offscreenCanvas.height*0.4 + Math.sin(now)*20, 80, 0, Math.PI*2);
        ctx.fill();
        
      } else if(camNum === 2){
        // CAM-04 PASILLO-B: perspectiva lineal
        ctx.strokeStyle = 'rgba(80, 120, 80, 0.5)';
        ctx.lineWidth = 3;
        for(let x=0; x<offscreenCanvas.width; x+=40){
          const depth = (x / offscreenCanvas.width) * 0.8 + 0.2;
          ctx.globalAlpha = depth;
          ctx.beginPath();
          ctx.moveTo(x, 0);
          ctx.lineTo(x, offscreenCanvas.height);
          ctx.stroke();
        }
        ctx.globalAlpha = 1;
        
        // Movimiento en el pasillo
        const moveX = offscreenCanvas.width * 0.4 + Math.sin(now*0.3)*80;
        ctx.fillStyle = 'rgba(100, 80, 100, 0.3)';
        ctx.fillRect(moveX-30, offscreenCanvas.height*0.3, 60, offscreenCanvas.height*0.4);
        
      } else if(camNum === 3){
        // CAM-14 HALLWAY: more sinister atmosphere
        const grad = ctx.createLinearGradient(0, 0, 0, offscreenCanvas.height);
        grad.addColorStop(0, 'hsl(120, 100%, 20%)');
        grad.addColorStop(1, 'hsl(120, 100%, 30%)');
        ctx.fillStyle = grad;
        ctx.fillRect(0, 0, offscreenCanvas.width, offscreenCanvas.height);
        
        // Línea de horizonte
        ctx.strokeStyle = 'hsl(120, 100%, 40%)';
        ctx.lineWidth = 4;
        ctx.beginPath();
        ctx.moveTo(0, offscreenCanvas.height*0.55);
        ctx.lineTo(offscreenCanvas.width, offscreenCanvas.height*0.55);
        ctx.stroke();
        
        // Puntos de luz lejanos parpadeando
        ctx.fillStyle = 'rgba(150, 200, 150, ' + (0.5 + Math.sin(now*2)*0.3) + ')';
        ctx.beginPath();
        ctx.arc(offscreenCanvas.width*0.3, offscreenCanvas.height*0.4, 15, 0, Math.PI*2);
        ctx.fill();
        
      } else if(camNum === 5){
        // CAM-07 ARCHIVO: estanterías con documentos, ambiente polvoriento
        ctx.fillStyle = 'hsl(30, 20%, 12%)';
        ctx.fillRect(0, 0, offscreenCanvas.width, offscreenCanvas.height);
        
        // Estanterías verticales
        ctx.strokeStyle = 'rgba(120, 100, 80, 0.4)';
        ctx.lineWidth = 60;
        for(let x=80; x<offscreenCanvas.width; x+=120){
          ctx.beginPath();
          ctx.moveTo(x, 0);
          ctx.lineTo(x, offscreenCanvas.height);
          ctx.stroke();
        }
        
        // Libros/archivos horizontales
        ctx.fillStyle = 'rgba(100, 90, 70, 0.3)';
        for(let y=40; y<offscreenCanvas.height; y+=50){
          for(let x=50; x<offscreenCanvas.width; x+=120){
            const width = 50 + Math.sin(now*0.5 + x)*10;
            ctx.fillRect(x, y, width, 8);
          }
        }
        
        // Sombra moviéndose entre estanterías
        const shadowX = offscreenCanvas.width * (0.3 + Math.sin(now*0.2)*0.4);
        ctx.fillStyle = 'rgba(60, 50, 40, 0.5)';
        ctx.beginPath();
        ctx.arc(shadowX, offscreenCanvas.height*0.6, 40, 0, Math.PI*2);
        ctx.fill();
        
        // Partículas de polvo
        for(let i=0; i<15; i++){
          const px = (now*20 + i*40) % offscreenCanvas.width;
          const py = (Math.sin(now*0.5 + i)*100 + offscreenCanvas.height*0.5);
          ctx.fillStyle = 'rgba(180, 170, 150, ' + (0.2 + Math.sin(now*2+i)*0.1) + ')';
          ctx.fillRect(px, py, 2, 2);
        }
        
      } else if(camNum === 6){
        // CAM-12 SÓTANO: ambiente oscuro, húmedo, tuberías, goteo
        ctx.fillStyle = 'hsl(200, 30%, 8%)';
        ctx.fillRect(0, 0, offscreenCanvas.width, offscreenCanvas.height);
        
        // Tuberías horizontales
        ctx.strokeStyle = 'rgba(80, 90, 100, 0.6)';
        ctx.lineWidth = 12;
        for(let y=80; y<offscreenCanvas.height; y+=90){
          ctx.beginPath();
          ctx.moveTo(0, y);
          ctx.lineTo(offscreenCanvas.width, y);
          ctx.stroke();
          // Soportes de tubería
          for(let x=100; x<offscreenCanvas.width; x+=150){
            ctx.fillStyle = 'rgba(60, 70, 80, 0.5)';
            ctx.fillRect(x-8, y-20, 16, 40);
          }
        }
        
        // Charcos en el suelo
        ctx.fillStyle = 'rgba(40, 60, 80, 0.4)';
        ctx.beginPath();
        ctx.ellipse(offscreenCanvas.width*0.3, offscreenCanvas.height*0.8, 
                   80 + Math.sin(now)*10, 30, 0, 0, Math.PI*2);
        ctx.fill();
        ctx.beginPath();
        ctx.ellipse(offscreenCanvas.width*0.7, offscreenCanvas.height*0.85, 
                   60 + Math.sin(now*1.3)*8, 25, 0, 0, Math.PI*2);
        ctx.fill();
        
        // Gotas cayendo (efecto de goteo)
        for(let i=0; i<5; i++){
          const dropX = offscreenCanvas.width * (0.2 + i*0.15);
          const dropY = ((now*150 + i*100) % offscreenCanvas.height);
          ctx.fillStyle = 'rgba(120, 140, 160, ' + (1 - dropY/offscreenCanvas.height) + ')';
          ctx.fillRect(dropX, dropY, 3, 10 + Math.sin(now*3+i)*5);
        }
        
        // Sombra de figura al fondo
        const figureAlpha = 0.2 + Math.sin(now*0.3)*0.15;
        ctx.fillStyle = 'rgba(40, 50, 60, ' + figureAlpha + ')';
        ctx.beginPath();
        ctx.arc(offscreenCanvas.width*0.5, offscreenCanvas.height*0.3 + Math.sin(now*0.5)*15, 
               60, 0, Math.PI*2);
        ctx.fill();
        ctx.fillRect(offscreenCanvas.width*0.5 - 30, offscreenCanvas.height*0.3 + 50, 
                    60, offscreenCanvas.height*0.3);
        
        // Luz parpadeante (bombilla defectuosa)
        if(Math.sin(now*10) > 0.7 || Math.random() > 0.95){
          ctx.fillStyle = 'rgba(200, 200, 180, 0.1)';
          ctx.fillRect(0, 0, offscreenCanvas.width, offscreenCanvas.height*0.5);
        }
      }
      
      // Ruido analógico universal
      addAnalogNoise(ctx, offscreenCanvas.width, offscreenCanvas.height, 0.08);
      
      // Scanlines
      ctx.strokeStyle = 'rgba(255, 255, 255, 0.02)';
      ctx.lineWidth = 1;
      for(let y=0; y<offscreenCanvas.height; y+=2){
        ctx.beginPath();
        ctx.moveTo(0, y);
        ctx.lineTo(offscreenCanvas.width, y);
        ctx.stroke();
      }
      
      requestAnimationFrame(animate);
    };
    
    animate();
    
  } catch(e) {
    console.warn('Canvas capture no soportado, usando fallback:', e);
    createCCTVFeed(videoElement, camNum);
  }
}

function createGlitchVideoFeed(videoElement){
  // Cámara 4 con interferencia extrema
  const offscreenCanvas = document.createElement('canvas');
  offscreenCanvas.width = 640;
  offscreenCanvas.height = 480;
  const ctx = offscreenCanvas.getContext('2d');
  
  try {
    const stream = offscreenCanvas.captureStream(30);
    videoElement.srcObject = stream;
    
    const animate = () => {
      const now = Date.now() / 1000;
      
      // Base corrupta
      ctx.fillStyle = '#000';
      ctx.fillRect(0, 0, offscreenCanvas.width, offscreenCanvas.height);
      
      // Efecto de glitch aleatorio
      if(Math.random() > 0.6){
        for(let i=0; i<20; i++){
          const y = Math.random() * offscreenCanvas.height;
          const height = Math.random() * 30 + 5;
          const offset = (Math.random() - 0.5) * 100;
          
          ctx.fillStyle = 'rgba(' + (Math.random()*255) + ', 0, ' + (Math.random()*255) + ', ' + (Math.random()*0.4) + ')';
          ctx.fillRect(offset, y, offscreenCanvas.width, height);
        }
      }
      
      // Líneas de interferencia roja
      ctx.strokeStyle = 'rgba(255, 0, 0, ' + (0.3 + Math.sin(now*3)*0.2) + ')';
      ctx.lineWidth = 2;
      for(let i=0; i<5; i++){
        const y = Math.random() * offscreenCanvas.height;
        ctx.beginPath();
        ctx.moveTo(0, y);
        ctx.lineTo(offscreenCanvas.width, y);
        ctx.stroke();
      }
      
      // Distorsión X (RGB shift)
      const imgData = ctx.getImageData(0, 0, offscreenCanvas.width, offscreenCanvas.height);
      const data = imgData.data;
      for(let i=0; i<data.length; i+=4){
        if(Math.random() > 0.95){
          const temp = data[i];
          data[i] = data[i+2];
          data[i+2] = temp;
        }
      }
      ctx.putImageData(imgData, 0, 0);
      
      // Ruido extremo
      addAnalogNoise(ctx, offscreenCanvas.width, offscreenCanvas.height, 0.3);
      
      requestAnimationFrame(animate);
    };
    
    animate();
    
  } catch(e) {
    console.warn('Glitch capture no soportado, usando fallback:', e);
    createGlitchCamera(videoElement);
  }
}

function createCCTVFeed(videoElement, camNum){
  // Crear canvas en lugar de video real (sin necesidad de internet)
  const canvas = document.createElement('canvas');
  canvas.width = 320;
  canvas.height = 240;
  const ctx = canvas.getContext('2d');
  
  const animateCCTV = () => {
    // Fondo negro
    ctx.fillStyle = '#000';
    ctx.fillRect(0, 0, canvas.width, canvas.height);
    
    // Simular algo en la pantalla según cámara
    if(camNum === 1){
      // Entrada: líneas horizontales (escaleras)
      ctx.strokeStyle = '#1a4a1a';
      ctx.lineWidth = 2;
      for(let y=0; y<canvas.height; y+=20){
        ctx.beginPath();
        ctx.moveTo(0, y);
        ctx.lineTo(canvas.width, y);
        ctx.stroke();
      }
      // Silueta borrosa
      ctx.fillStyle = 'rgba(80, 80, 80, 0.3)';
      ctx.fillRect(canvas.width*0.3, canvas.height*0.2, canvas.width*0.4, canvas.height*0.6);
    } else if(camNum === 2){
      // Pasillo: líneas verticales
      ctx.strokeStyle = '#1a4a1a';
      ctx.lineWidth = 1;
      for(let x=0; x<canvas.width; x+=15){
        ctx.beginPath();
        ctx.moveTo(x, 0);
        ctx.lineTo(x, canvas.height);
        ctx.stroke();
      }
    } else if(camNum === 3){
      // Corredor: gradiente
      const grad = ctx.createLinearGradient(0, 0, 0, canvas.height);
      grad.addColorStop(0, '#0a2a0a');
      grad.addColorStop(1, '#1a3a1a');
      ctx.fillStyle = grad;
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      // Línea de horizonte
      ctx.strokeStyle = '#2a5a2a';
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.moveTo(0, canvas.height*0.6);
      ctx.lineTo(canvas.width, canvas.height*0.6);
      ctx.stroke();
    }
    
    // Ruido de TV analógica
    addAnalogNoise(ctx, canvas.width, canvas.height, 0.1);
    
    requestAnimationFrame(animateCCTV);
  };
  
  // Convertir video a canvas
  if(videoElement.tagName === 'VIDEO'){
    const canvasOverlay = document.createElement('canvas');
    canvasOverlay.width = 320;
    canvasOverlay.height = 240;
    videoElement.parentElement.insertBefore(canvasOverlay, videoElement);
    canvasOverlay.style.position = 'absolute';
    canvasOverlay.style.width = '100%';
    canvasOverlay.style.height = '100%';
    videoElement.style.display = 'none';
    
    const ctx2d = canvasOverlay.getContext('2d');
    const drawFrame = () => {
      ctx2d.clearRect(0, 0, canvas.width, canvas.height);
      ctx2d.drawImage(canvas, 0, 0);
      requestAnimationFrame(drawFrame);
    };
    drawFrame();
  }
  
  animateCCTV();
}

function createGlitchCamera(videoElement){
  // Cámara con interferencia y glitch
  const canvas = document.createElement('canvas');
  canvas.width = 320;
  canvas.height = 240;
  const ctx = canvas.getContext('2d');
  
  const animateGlitch = () => {
    // Fondo base con interferencia extrema
    ctx.fillStyle = '#000';
    ctx.fillRect(0, 0, canvas.width, canvas.height);
    
    // Efecto de glitch aleatorio
    if(Math.random() > 0.7){
      // Líneas horizontales desplazadas
      for(let i=0; i<10; i++){
        const y = Math.random() * canvas.height;
        const offset = (Math.random() - 0.5) * 50;
        ctx.fillStyle = 'rgba(255, 0, 0, ' + (Math.random()*0.3) + ')';
        ctx.fillRect(0, y, canvas.width, 2);
      }
    }
    
    // Bloques de color aleatorio (glitch)
    for(let i=0; i<5; i++){
      const x = Math.random() * canvas.width;
      const y = Math.random() * canvas.height;
      const w = Math.random() * 40 + 10;
      const h = Math.random() * 40 + 10;
      ctx.fillStyle = 'rgba(' + (Math.random()*255) + ', ' + (Math.random()*255) + ', ' + (Math.random()*255) + ', 0.2)';
      ctx.fillRect(x, y, w, h);
    }
    
    // "Presencia" anómala en el centro (tipo entidad)
    if(Math.random() > 0.85){
      ctx.strokeStyle = 'rgba(255, 100, 100, 0.4)';
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.arc(canvas.width/2 + (Math.random()-0.5)*30, 
              canvas.height/2 + (Math.random()-0.5)*30, 
              Math.random()*20+10, 0, Math.PI*2);
      ctx.stroke();
    }
    
    // Ruido intenso
    addAnalogNoise(ctx, canvas.width, canvas.height, 0.4);
    requestAnimationFrame(animateGlitch);
  };
  
  if(videoElement.tagName === 'VIDEO'){
    // Crear overlay solo si no existe uno previo
    if(!videoElement.parentElement.querySelector('canvas')){
      const canvasOverlay = document.createElement('canvas');
      canvasOverlay.width = 320;
      canvasOverlay.height = 240;
      videoElement.parentElement.insertBefore(canvasOverlay, videoElement);
      canvasOverlay.style.position = 'absolute';
      canvasOverlay.style.width = '100%';
      canvasOverlay.style.height = '100%';
      videoElement.style.display = 'none';
      
      const ctx2d = canvasOverlay.getContext('2d');
      const drawFrame = () => {
        ctx2d.clearRect(0, 0, canvas.width, canvas.height);
        ctx2d.drawImage(canvas, 0, 0);
        requestAnimationFrame(drawFrame);
      };
      drawFrame();
    }
  }
  
  animateGlitch();
}

function addAnalogNoise(ctx, width, height, intensity){
  const imageData = ctx.getImageData(0, 0, width, height);
  const data = imageData.data;
  
  for(let i=0; i<data.length; i+=4){
    const noise = (Math.random() - 0.5) * intensity * 255;
    data[i] = Math.max(0, Math.min(255, data[i] + noise)); // R
    data[i+1] = Math.max(0, Math.min(255, data[i+1] + noise)); // G
    data[i+2] = Math.max(0, Math.min(255, data[i+2] + noise)); // B
  }
  
  ctx.putImageData(imageData, 0, 0);
}

function playSound(soundId){
  const audio = document.getElementById(soundId);
  if(audio){
    audio.currentTime = 0;
    audio.play().catch(e => {
      // Si falla, crear sonido sintético
      createSynthSound(soundId);
    });
  }
}

function setupUISoundHooks(){
  if(uiSoundHooksBound) return;
  uiSoundHooksBound=true;

  document.addEventListener('click', (event)=>{
    const target=event.target;
    if(!(target instanceof Element)) return;
    if(target.closest('button,.start-btn,.icon,.ctx-item,.menu-item,#deskMonitor,#loginFingerprint,[onclick]')){
      playSound('sfxClick');
    }
  }, true);

  document.addEventListener('mouseover', (event)=>{
    const target=event.target;
    if(!(target instanceof Element)) return;
    if(!target.closest('button,.start-btn,.icon,#deskMonitor,#loginFingerprint,.ctx-item,.menu-item')) return;
    const now=Date.now();
    if(now-uiHoverSoundLastAt<90) return;
    uiHoverSoundLastAt=now;
    playSound('sfxHover');
  }, true);
}

function createSynthSound(soundId){
  try {
    const audioContext = new (window.AudioContext || window.webkitAudioContext)();
    const now = audioContext.currentTime;
    
    const osc = audioContext.createOscillator();
    const gain = audioContext.createGain();
    osc.connect(gain);
    gain.connect(audioContext.destination);
    
    switch(soundId){
      case 'sfxClick':
        osc.frequency.value = 800;
        gain.gain.setValueAtTime(0.3, now);
        gain.gain.exponentialRampToValueAtTime(0.01, now + 0.1);
        osc.start(now);
        osc.stop(now + 0.1);
        break;
      case 'sfxDoor':
        osc.frequency.value = 200;
        gain.gain.setValueAtTime(0.2, now);
        gain.gain.exponentialRampToValueAtTime(0.01, now + 0.3);
        osc.start(now);
        osc.stop(now + 0.3);
        break;
      case 'sfxAlarm':
        for(let i = 0; i < 3; i++){
          osc.frequency.setValueAtTime(900 + i*100, now + i*0.15);
          gain.gain.setValueAtTime(0.2, now + i*0.15);
          gain.gain.linearRampToValueAtTime(0.01, now + (i+1)*0.15);
        }
        osc.start(now);
        osc.stop(now + 0.45);
        break;
      case 'sfxGlitch':
        osc.frequency.setValueAtTime(1200, now);
        osc.frequency.setValueAtTime(400, now + 0.05);
        gain.gain.setValueAtTime(0.25, now);
        gain.gain.setValueAtTime(0.01, now + 0.08);
        osc.start(now);
        osc.stop(now + 0.08);
        break;
      case 'sfxHover':
        osc.frequency.value = 600;
        gain.gain.setValueAtTime(0.15, now);
        gain.gain.exponentialRampToValueAtTime(0.01, now + 0.15);
        osc.start(now);
        osc.stop(now + 0.15);
        break;
    }
  } catch(e) {
    console.log('Synth sound creation failed:', e);
  }
}

