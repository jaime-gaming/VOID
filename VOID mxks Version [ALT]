function playWetFootstepEffect(intensity=0.35){
  try{
    const ctx=window.__voidAudioCtx || new (window.AudioContext || window.webkitAudioContext)();
    window.__voidAudioCtx=ctx;
    if(ctx.state==='suspended') ctx.resume().catch(()=>{});

    const makeNoiseBuffer=(seconds=0.28)=>{
      const length=Math.max(1,Math.floor(ctx.sampleRate*seconds));
      const buffer=ctx.createBuffer(1,length,ctx.sampleRate);
      const data=buffer.getChannelData(0);
      for(let i=0;i<length;i++) data[i]=(Math.random()*2-1)*(1-(i/length));
      return buffer;
    };

    const steps=3 + (Math.random()<0.5 ? 1 : 0);
    for(let i=0;i<steps;i++){
      const when=ctx.currentTime + 0.18 + (i*(0.28 + Math.random()*0.09));
      const thump=ctx.createOscillator();
      const thumpGain=ctx.createGain();
      thump.type='triangle';
      thump.frequency.setValueAtTime(120-(i*6), when);
      thump.frequency.exponentialRampToValueAtTime(52, when+0.13);
      thumpGain.gain.setValueAtTime(0.0001, when);
      thumpGain.gain.exponentialRampToValueAtTime(0.09 + intensity*0.1, when+0.02);
      thumpGain.gain.exponentialRampToValueAtTime(0.0001, when+0.16);
      thump.connect(thumpGain);
      thumpGain.connect(ctx.destination);
      thump.start(when);
      thump.stop(when+0.17);

      const splash=ctx.createBufferSource();
      splash.buffer=makeNoiseBuffer(0.22);
      const splashFilter=ctx.createBiquadFilter();
      splashFilter.type='bandpass';
      splashFilter.frequency.setValueAtTime(460 + Math.random()*280, when);
      splashFilter.Q.value=0.6;
      const splashGain=ctx.createGain();
      splashGain.gain.setValueAtTime(0.0001, when);
      splashGain.gain.exponentialRampToValueAtTime(0.045 + intensity*0.05, when+0.03);
      splashGain.gain.exponentialRampToValueAtTime(0.0001, when+0.2);
      splash.connect(splashFilter);
      splashFilter.connect(splashGain);
      splashGain.connect(ctx.destination);
      splash.start(when);
      splash.stop(when+0.22);
    }
  }catch(e){
    playSound('sfxHover');
  }
}

function playHumanBreathingEffect(intensity=0.35){
  try{
    const ctx=window.__voidAudioCtx || new (window.AudioContext || window.webkitAudioContext)();
    window.__voidAudioCtx=ctx;
    if(ctx.state==='suspended') ctx.resume().catch(()=>{});
    const now=ctx.currentTime;

    const length=Math.floor(ctx.sampleRate*5.2);
    const buffer=ctx.createBuffer(1,length,ctx.sampleRate);
    const data=buffer.getChannelData(0);
    for(let i=0;i<length;i++) data[i]=(Math.random()*2-1)*0.55;

    const src=ctx.createBufferSource();
    src.buffer=buffer;

    const band=ctx.createBiquadFilter();
    band.type='bandpass';
    band.frequency.setValueAtTime(620, now);
    band.Q.value=0.75;

    const low=ctx.createBiquadFilter();
    low.type='lowpass';
    low.frequency.setValueAtTime(1200, now);

    const gain=ctx.createGain();
    gain.gain.setValueAtTime(0.0001, now);
    gain.gain.linearRampToValueAtTime(0.018 + intensity*0.03, now+0.9);
    gain.gain.linearRampToValueAtTime(0.007 + intensity*0.016, now+1.8);
    gain.gain.linearRampToValueAtTime(0.02 + intensity*0.032, now+3.2);
    gain.gain.linearRampToValueAtTime(0.0001, now+4.9);

    src.connect(band);
    band.connect(low);
    low.connect(gain);
    gain.connect(ctx.destination);

    src.start(now);
    src.stop(now+5.05);
  }catch(e){
    playSound('sfxHover');
  }
}

function triggerEnvironmentalFearEvent(){
