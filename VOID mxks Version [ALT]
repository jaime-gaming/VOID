function recordMissedCall(npcKey, reason){
  missedCalls[npcKey]=(missedCalls[npcKey]||0)+1;
  if(!playthroughTracking.npcsIgnored.includes(npcKey)){
    playthroughTracking.npcsIgnored.push(npcKey);
  }

  const count=missedCalls[npcKey];
  if(count===2){
    receiveMail(`${npcKey}@void`,'RE: ¿Estás ahí?','Intenté llamarte dos veces. Si no puedes contestar, al menos responde por correo.');
  }
  if(count===3){
    receiveMail('system@void','Llamadas Perdidas','Se registraron múltiples llamadas sin respuesta. El sistema ajustará el protocolo.');
  }
  if(count>=4 && mentalSyncLevel>=50){
    receiveMail('???@void','No puedes ignorar el eco','Cuando callas, ECO responde por ti.');
  }
}

function openCallsApp(){
  const winId='callsWindow';
  let win=document.getElementById(winId);
  if(!win){
    win=document.createElement('div');
    win.className='window';
    win.id=winId;
    win.style.top='100px';
    win.style.left='150px';
    win.style.width='300px';
    win.style.height='350px';
