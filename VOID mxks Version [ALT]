function unlockFloor(floor){
  const floorData=floorNotes[floor];
  if(!floorData.locked) return;
  
  const password=prompt(`[${floorData.name}] - INGRESA CONTRASEÑA:`,'');
  if(password===null) return;
  
  if(password!==floorData.locked_with){
    alert('❌ Contraseña incorrecta.');
    return;
  }
  
  // Desbloquear
  floorNotes[floor].locked=false;
  
  // Desbloquear archivo en el sistema si existe
  if(floorData.fileKey){
    const file=files.find(f=>f.key===floorData.fileKey);
    if(file){
      file.unlocked=true;
      unlockedDocs.push(floorData.fileKey);
    }
  }
  
  // Mostrar archivos ocultos basados en qué piso se desbloqueó
  if(floor==='floor1'){
    files.forEach(f=>{
      if(f.key==='burnsLogs') f.hidden=false;
    });
  }
  if(floor==='floor2'){
    files.forEach(f=>{
      if(f.key==='labArchives') f.hidden=false;
    });
  }
  if(floor==='floor3'){
    files.forEach(f=>{
      if(f.key==='serverArchives') f.hidden=false;
    });
  }
  
  // Actualizar misión de desbloqueo de pisos
  updateMissionProgress('unlock_floors');
  
  alert(`✓ ${floorData.name} desbloqueado.`);
  updateFloorDisplay();
  updateMissionProgress('unlock_floors');
  
  // Reproducir sonido
  playSound('sfxClick');
  
  // Actualizar display
  updateFloorDisplay();
  updateDesktop();
  
  alert(`✓ Piso desbloqueado!\n\nArchivo disponible: ${floorData.unlocksFile}`);
}

