#officeDesk{position:relative;width:100%;height:100%;background:linear-gradient(180deg, #1a1a22 0%, #0f0f15 50%, #050508 100%);pointer-events:auto;box-shadow:inset 0 0 120px rgba(0,0,0,0.95);overflow:hidden;}

